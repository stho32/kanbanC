@using KanbanC.Contracts.Boards

<section class="boardband" id="@Kennung">
    <h2 class="boardband-ueberschrift">@Ueberschrift</h2>
    @if (Boards.Count == 0)
    {
        <p class="boardband-leer text-muted">Noch kein Board dieser Art.</p>
    }
    else
    {
        <div class="boardband-kacheln">
            @foreach (var board in Boards)
            {
                <Boardkachel Board="board" Geaendert="Geaendert" IstArchivansicht="IstArchivansicht" />
            }
        </div>
    }
</section>

@code {
    [Parameter]
    [EditorRequired]
    public string Kennung { get; set; } = "";

    [Parameter]
    [EditorRequired]
    public string Ueberschrift { get; set; } = "";

    [Parameter]
    [EditorRequired]
    public IReadOnlyList<BoardUebersicht> Boards { get; set; } = [];

    [Parameter]
    public EventCallback Geaendert { get; set; }

    [Parameter]
    public bool IstArchivansicht { get; set; }
}
