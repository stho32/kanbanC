@using KanbanC.Blazor.Services
@using KanbanC.Contracts.Boards
@using KanbanC.Contracts.Fehler
@inject BoardApiKlient ApiKlient

<article class="board-kachel card elev-sm @_archivklasse" data-board-id="@Board.BoardId">
    <div class="board-kachel-kopf">
        <span class="card-kicker board-kachel-art">@_artbezeichnung</span>
        <div class="board-kachel-menue">
            <button type="button"
                    class="btn btn-schlicht btn-symbol board-kachel-menue-schalter"
                    aria-label="Menü von @Board.Name"
                    aria-expanded="@_menuezustand"
                    @onclick="SchalteMenue">⋯</button>
            @if (_menueIstOffen)
            {
                <div class="board-kachel-menueliste">
                    <button type="button" class="board-kachel-menuepunkt board-kachel-menuepunkt-umbenennen" @onclick="OeffneNamensfeld">Umbenennen</button>
                    <button type="button" class="board-kachel-menuepunkt board-kachel-menuepunkt-archivieren" @onclick="Archiviere">Archivieren</button>
                    <span class="board-kachel-menuehinweis">verschwindet aus der Standardliste, bleibt über Filter und API abrufbar</span>
                </div>
            }
        </div>
    </div>

    @if (_namensfeldIstOffen)
    {
        <div class="board-kachel-namensfeld">
            <input class="input board-kachel-name-eingabe" aria-label="Name des Boards" @bind="_name" @bind:event="oninput" />
            <div class="board-kachel-knoepfe">
                <button type="button" class="btn btn-neben board-kachel-speichern" @onclick="SpeichereNamen">Speichern</button>
                <button type="button" class="btn btn-schlicht board-kachel-abbrechen" @onclick="SchliesseNamensfeld">Abbrechen</button>
            </div>
        </div>
    }
    else
    {
        <h3 class="card-title board-kachel-name">
            <a class="board-verweis" href="@($"/boards/{Board.BoardId}")">@Board.Name</a>
        </h3>
    }

    <p class="card-meta board-kachel-fuss">@_fusszeile</p>

    @if (_meldungen.Count > 0)
    {
        <div class="meldung meldung-abweisung board-kachel-meldung" role="alert">
            <ul>
                @foreach (var meldung in _meldungen)
                {
                    <li>@meldung</li>
                }
            </ul>
        </div>
    }
</article>

@code {
    private readonly List<string> _meldungen = [];
    private string _artbezeichnung = "";
    private string _archivklasse = "";
    private string _fusszeile = "";
    private string _name = "";
    private bool _menueIstOffen;
    private bool _namensfeldIstOffen;
    private string _menuezustand = "false";

    [Parameter]
    [EditorRequired]
    public BoardUebersicht Board { get; set; } = default!;

    // Die Kachel meldet den neuen Stand nach oben, statt selbst eine zweite Liste zu führen:
    // die geladene Liste in Boards.razor bleibt die eine Quelle.
    [Parameter]
    public EventCallback Geaendert { get; set; }

    // Die Kachel erfährt aus der gewählten Ansicht, ob sie ein abgelegtes Board zeigt:
    // BoardUebersicht trägt den Archivstand nicht, weil die Liste schon gefiltert ist.
    [Parameter]
    public bool IstArchivansicht { get; set; }

    protected override void OnParametersSet()
    {
        _artbezeichnung = ArtbezeichnungVon(Board.Art) + ArchivzusatzVon(IstArchivansicht);
        _archivklasse = ArchivklasseVon(IstArchivansicht);
        _fusszeile = FusszeileVon(Board);
    }

    private static string ArchivzusatzVon(bool istArchivansicht)
    {
        if (istArchivansicht)
        {
            return " · archiviert";
        }

        return "";
    }

    private static string ArchivklasseVon(bool istArchivansicht)
    {
        if (istArchivansicht)
        {
            return "board-kachel-archiviert";
        }

        return "";
    }

    // Das Menü schließt über einen zweiten Klick auf ⋯, so wie das Anlegeformular über sein ✕.
    private void SchalteMenue()
    {
        SetzeMenue(!_menueIstOffen);
    }

    private void OeffneNamensfeld()
    {
        SetzeMenue(false);
        _meldungen.Clear();
        _name = Board.Name;
        _namensfeldIstOffen = true;
    }

    private void SchliesseNamensfeld()
    {
        _namensfeldIstOffen = false;
        _meldungen.Clear();
    }

    private async Task SpeichereNamen()
    {
        await MitErreichbarerWebApi(SendeNeuenNamen);
    }

    private async Task SendeNeuenNamen()
    {
        var ergebnis = await ApiKlient.BenenneUm(Board.BoardId, new BoardUmbenennenAnfrage(_name));
        if (ergebnis.WurdeZurueckgewiesen)
        {
            // Das Namensfeld bleibt offen, damit der Name nachgetragen werden kann.
            UebernehmeBefunde(ergebnis.Zurueckweisung);
            return;
        }

        _namensfeldIstOffen = false;
        await Geaendert.InvokeAsync();
    }

    private async Task Archiviere()
    {
        SetzeMenue(false);
        await MitErreichbarerWebApi(() => SendeArchivstand(new Archivierung(true)));
    }

    private async Task SendeArchivstand(Archivierung archivierung)
    {
        var ergebnis = await ApiKlient.SchalteArchivierung(Board.BoardId, archivierung);
        if (ergebnis.WurdeZurueckgewiesen)
        {
            UebernehmeBefunde(ergebnis.Zurueckweisung);
            return;
        }

        await Geaendert.InvokeAsync();
    }

    private async Task MitErreichbarerWebApi(Func<Task> aufruf)
    {
        _meldungen.Clear();
        var ausfallmeldung = await WebApiAufruf.MitAusfallmeldung(aufruf);
        if (ausfallmeldung is not null)
        {
            _meldungen.Add(ausfallmeldung);
        }
    }

    private void UebernehmeBefunde(Zurueckweisung zurueckweisung)
    {
        foreach (var befund in zurueckweisung.Befunde)
        {
            _meldungen.Add(befund.Meldung);
        }
    }

    private void SetzeMenue(bool istOffen)
    {
        _menueIstOffen = istOffen;
        _menuezustand = AlsAttributtext(istOffen);
    }

    private static string AlsAttributtext(bool wert)
    {
        if (wert)
        {
            return "true";
        }

        return "false";
    }

    private static string ArtbezeichnungVon(BoardArt art)
    {
        var istProjektboard = art == BoardArt.Projekt;
        if (istProjektboard)
        {
            return "Projektboard";
        }

        return "Linienboard";
    }

    // Der Fuss nennt den Zieltermin nur beim Projektboard; beim Linienboard bleibt die Stelle leer,
    // weil ein Linienboard ohne Ende läuft.
    private static string FusszeileVon(BoardUebersicht board)
    {
        var boardLaeuftAufEinenZielterminZu = board.Art == BoardArt.Projekt && board.Zieltermin is not null;
        if (boardLaeuftAufEinenZielterminZu)
        {
            return $"bis {Terminformatierer.AlsText(board.Zieltermin)}";
        }

        return "";
    }
}
