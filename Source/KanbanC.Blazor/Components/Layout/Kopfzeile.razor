@implements IDisposable
@using KanbanC.Contracts.Kontributoren
@using KanbanC.Contracts.Zeiten
@inject NavigationManager Navigation
@inject KontributorenApiKlient ApiKlient
@inject ZeitenApiKlient ZeitenKlient
@inject Identitaetsspeicher Identitaetsspeicher
@inject Laufzeitmelder Laufzeitmelder
@inject Ereignisverteiler Ereignisverteiler

<div class="kopfzeilenband" @onkeydown="AufTaste">
    <header class="kopfzeile" id="kopfzeile">
        @* Zone 1 — wo die Seite steht. Den Platz füllt sie selbst; auf dem Board steht
           hier sein Name, auf der Übersicht deren Titel. Eine Wortmarke gibt es nicht:
           wer die Anwendung offen hat, weiß, welche es ist — der Platz gehört dem Inhalt. *@
        <div class="kopfzeile-kontext">
            <SectionOutlet SectionName="kopfzeile-kontext" />
        </div>

        @* Zone 2 — die Hauptnavigation. *@
        <div class="kopfzeile-anwendung">
            <nav class="kopfzeile-navigation" id="hauptnavigation" aria-label="Hauptnavigation">
                @* Steht ein Board offen, führt der Rückweg in seiner Kopfzeile schon dorthin —
                   der Punkt wäre dieselbe Verknüpfung ein zweites Mal. *@
                @if (!_einBoardIstOffen)
                {
                    <NavLink class="navigationspunkt"
                             ActiveClass="navigationspunkt-aktiv"
                             id="navigation-boards"
                             href="boards">Boards</NavLink>
                }
                <span class="navigationspunkt navigationspunkt-gesperrt"
                      id="navigation-auswertungen"
                      aria-disabled="true"
                      title="Noch nicht verfügbar">Auswertungen</span>
                <NavLink class="navigationspunkt"
                         ActiveClass="navigationspunkt-aktiv"
                         id="navigation-kontributoren"
                         href="kontributoren">Kontributoren</NavLink>
            </nav>
        </div>

        @* Zone 3 — Werkzeuge und Identität, rechtsbündig. *@
        <div class="kopfzeile-werkzeuge">
            <SectionOutlet SectionName="kopfzeile-bedienung" />
            @* Steht die Leitung, steht hier nichts — dieselbe Regel wie beim Laufzeitzähler
               daneben: Abwesenheit heißt „es steht". Bricht sie ab, ist genau das die Nachricht,
               und die Marke nennt den Zeitpunkt, seit dem der Schirm altert. *@
            @if (_verbindungsmarke is not null)
            {
                <span class="kopfzeile-verbindung" id="verbindungsmarke" role="status"><svg class="verbindung-zeichen" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 8.5A16 16 0 0 1 22 8.5"></path><path d="M6.5 12.5a10 10 0 0 1 11 0"></path><circle cx="12" cy="18" r="1"></circle><path d="m3 3 18 18"></path></svg>@_verbindungsmarke</span>
            }
            @* Läuft nichts, steht hier nichts — kein Nullwert und keine graue Attrappe. Der
               knappste Platz der Anwendung gehört dem, was gerade gilt. *@
            @if (_laufzaehler is not null)
            {
                <div class="laufzeitplatz">
                    <button type="button"
                            class="kopfzeile-laufzeit @_laufzaehler.Fuellungsklasse"
                            id="laufzeitzaehler"
                            title="@_laufzaehler.Titel"
                            aria-haspopup="true"
                            aria-expanded="@Laufzeitstand()"
                            @onclick="SchalteLaufzeitliste"><svg class="laufzeit-uhr" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3.5 2"></path></svg>@_laufzaehler.Beschriftung<svg class="identitaets-chevron" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button>
                </div>
            }
            <div class="identitaetsplatz">
                <button type="button"
                        class="kopfzeile-identitaet"
                        id="identitaet"
                        aria-haspopup="true"
                        aria-expanded="@Popoverstand()"
                        @onclick="SchaltePopover">@Identitaetsbeschriftung()<svg class="identitaets-chevron" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button>
            </div>
        </div>
    </header>

    @* Die Wahl hängt am Band, nicht in der Zeile: die Zeile beschneidet ihren Inhalt, damit sie die
       Seite nicht breiter macht als das Fenster, und würde das Popover mit abschneiden. *@
    @if (_offenesPopover == Kopfzeilenpopover.Identitaetswahl)
    {
        <div class="identitaets-auffangflaeche" id="identitaet-auffangflaeche" @onclick="SchliessePopover"></div>
        @* tabindex="-1": ein Klick auf einen Text im Popover setzt den Fokus damit auf das
           Popover statt auf den Rumpf — sonst liefe Escape danach ins Leere. *@
        <div class="identitaetspopover" id="identitaetspopover" tabindex="-1">
            <p class="identitaetspopover-titel">Ich bin …</p>
            <Identitaetswahl Kontributoren="_kontributoren"
                             GewaehlteKontributorId="_gewaehlteKontributorId"
                             Gewaehlt="UebernimmWahl" />
        </div>
    }

    @if (_offenesPopover == Kopfzeilenpopover.Laufzeitliste)
    {
        <div class="identitaets-auffangflaeche" id="laufzeit-auffangflaeche" @onclick="SchliessePopover"></div>
        <div class="identitaetspopover laufzeitpopover" id="laufzeitpopover" tabindex="-1">
            <p class="identitaetspopover-titel">Läuft gerade …</p>
            <Laufzeitpopover Laufende="_laufende"
                             GewaehlteKontributorId="_gewaehlteKontributorId"
                             Gestoppt="StoppeZeile" />
        </div>
    }
</div>

@code {
    private const string NichtGewaehlt = "nicht gewählt";

    private bool _einBoardIstOffen;

    // **Ein** Zustand statt zweier Wahrheitswerte: höchstens eines der beiden Popover ist offen,
    // und zwei Booleans ließen den Zustand zu, den es nicht geben darf.
    private enum Kopfzeilenpopover
    {
        Keines,
        Identitaetswahl,
        Laufzeitliste,
    }

    private Kopfzeilenpopover _offenesPopover = Kopfzeilenpopover.Keines;
    private IReadOnlyList<Kontributor> _kontributoren = [];
    private IReadOnlyList<LaufendeZeitmessung> _laufende = [];
    private long? _gewaehlteKontributorId;

    private Laufzaehler? _laufzaehler;

    // Was in der Kopfzeile über die Ereignisleitung steht; null heißt „die Leitung steht".
    private string? _verbindungsmarke;

    protected override async Task OnInitializedAsync()
    {
        UebernimmAdresse();
        Navigation.LocationChanged += AufAdresswechsel;
        Identitaetsspeicher.Gewechselt += AufIdentitaetswechsel;
        Laufzeitmelder.Gemeldet += AufLaufzeitmeldung;
        Ereignisverteiler.Verbindungsstandgewechselt += AufVerbindungsstand;
        _verbindungsmarke = Verbindungsmarke.Fuer(Ereignisverteiler.Verbindungsstand);
        // App.razor rendert mit prerender: false — der Kreislauf steht hier schon, ein
        // Interop-Aufruf trägt (belegt in SessionStorageProbeE2ETests).
        _gewaehlteKontributorId = await Identitaetsspeicher.Lies();
        await LadeKontributoren();
        await LadeLaufende();
    }

    // Anders als die Kontributorenliste wird die Laufzeitliste bei **jedem** Anlass frisch geholt:
    // eine Zahl in der Kopfzeile, die eine halbe Stunde alt ist, lügt — eine ungeänderte
    // Kontributorenliste veraltet nur.
    // Fällt die WebApi aus, bleibt die Stelle leer statt zu reißen: die Kopfzeile steht auf jeder
    // Seite.
    private async Task LadeLaufende()
    {
        var ausfallmeldung = await WebApiAufruf.MitAusfallmeldung(async () => _laufende = await ZeitenKlient.LadeLaufende());
        var dieWebApiIstNichtErreichbar = ausfallmeldung is not null;
        if (dieWebApiIstNichtErreichbar)
        {
            _laufende = [];
        }

        _laufzaehler = Laufzaehler.Fuer(_laufende, _gewaehlteKontributorId);
    }

    // Die Liste wird je Blazor-Kreislauf einmal geholt, nicht je Seitenwechsel: die Kopfzeile
    // steht auf jeder Seite, ein Aufruf je Navigation wäre einer zu viel.
    private async Task LadeKontributoren()
    {
        await WebApiAufruf.MitAusfallmeldung(async () => _kontributoren = await ApiKlient.LadeAlle());
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= AufAdresswechsel;
        Identitaetsspeicher.Gewechselt -= AufIdentitaetswechsel;
        Laufzeitmelder.Gemeldet -= AufLaufzeitmeldung;
        Ereignisverteiler.Verbindungsstandgewechselt -= AufVerbindungsstand;
    }

    // Der Stand kommt aus dem Hintergrunddienst und damit von einem fremden Faden: das
    // Neuzeichnen läuft über InvokeAsync im Kreislauf dieser Sitzung.
    private void AufVerbindungsstand(Verbindungsstand stand)
    {
        _verbindungsmarke = Verbindungsmarke.Fuer(stand);
        _ = InvokeAsync(StateHasChanged);
    }

    // Ein eigener Start oder Stopp auf der Kartenseite meldet sich, damit die Kopfzeile nicht
    // unmittelbar nach der eigenen Handlung eine falsche Zahl zeigt.
    // **Kein Live-Kanal:** was ein anderer Browser tut, erfährt diese Sitzung erst beim nächsten
    // der vier Anlässe.
    private void AufLaufzeitmeldung()
    {
        _ = HoleLaufendeNach();
    }

    // Beide Anlässe kommen aus einem Ereignis und damit möglicherweise von einem fremden Faden:
    // der Abruf und das Neuzeichnen laufen deshalb über InvokeAsync im Kreislauf dieser Sitzung.
    private async Task HoleLaufendeNach()
    {
        await InvokeAsync(async () =>
        {
            await LadeLaufende();
            StateHasChanged();
        });
    }

    // Gewählt wird auch auf der Kartenseite, wenn der Timer die Wahl erzwingt. Der Platz nennt
    // danach denselben Namen wie nach einer Wahl hier — es gibt eine Identität, nicht zwei.
    // Übernommen wird der gemeldete Wert, nicht der abgelegte: bei gesperrtem Browser-Speicher
    // gilt die Wahl für diese Sitzung weiter, sie überlebt dann nur den Reload nicht.
    private void AufIdentitaetswechsel(long? gewaehlteKontributorId)
    {
        _gewaehlteKontributorId = gewaehlteKontributorId;
        // Die Füllung hängt an der Wahl: derselbe Bestand, ein anderes „mich".
        _laufzaehler = Laufzaehler.Fuer(_laufende, _gewaehlteKontributorId);
        _ = InvokeAsync(StateHasChanged);
    }

    private void AufAdresswechsel(object? absender, LocationChangedEventArgs ereignis)
    {
        UebernimmAdresse();
        SchliessePopover();
        StateHasChanged();
        _ = HoleLaufendeNach();
    }

    private void UebernimmAdresse()
    {
        _einBoardIstOffen = Boardadresse.ZeigtAufEinBoard(Navigation.Uri);
    }

    // Wer die Wahl öffnet, will den heutigen Stand sehen: ein gerade auf /kontributoren
    // angelegter Mensch stünde sonst erst nach einem vollen Laden darin. Je Seitenwechsel wird
    // weiterhin nichts geholt.
    private async Task SchaltePopover()
    {
        var dieWahlStehtSchonOffen = _offenesPopover == Kopfzeilenpopover.Identitaetswahl;
        if (dieWahlStehtSchonOffen)
        {
            SchliessePopover();
            return;
        }

        _offenesPopover = Kopfzeilenpopover.Identitaetswahl;
        await LadeKontributoren();
    }

    // Wer die Liste öffnet, will den jetzigen Stand sehen — sie geht über alle Boards und kann
    // sich anderswo geändert haben. Geholt wird **vor** dem Öffnen, damit das Popover nie einen
    // alten Stand zeigt.
    private async Task SchalteLaufzeitliste()
    {
        var dieListeStehtSchonOffen = _offenesPopover == Kopfzeilenpopover.Laufzeitliste;
        if (dieListeStehtSchonOffen)
        {
            SchliessePopover();
            return;
        }

        await LadeLaufende();
        var esLaeuftNichtsMehr = _laufende.Count == 0;
        if (esLaeuftNichtsMehr)
        {
            SchliessePopover();
            return;
        }

        _offenesPopover = Kopfzeilenpopover.Laufzeitliste;
    }

    // Die Zeilenhandlung beendet **genau diesen** Eintrag — auch den eines fremden Kontributors.
    // Danach wird die Liste **frisch geholt** statt in der Hand nachgezogen: sie geht über alle
    // Boards und kann sich unterdessen anderswo geändert haben.
    private async Task StoppeZeile(LaufendeZeitmessung messung)
    {
        await WebApiAufruf.MitAusfallmeldung(() => BeendeZeitmessung(messung));
        await LadeLaufende();
        var esLaeuftNichtsMehr = _laufende.Count == 0;
        if (esLaeuftNichtsMehr)
        {
            SchliessePopover();
        }
    }

    private async Task BeendeZeitmessung(LaufendeZeitmessung messung)
    {
        await ZeitenKlient.BeendeZeitmessung(messung.Zeiteintrag.Karte, messung.Zeiteintrag.ZeiteintragId);
    }

    private void SchliessePopover()
    {
        _offenesPopover = Kopfzeilenpopover.Keines;
    }

    private void AufTaste(KeyboardEventArgs taste)
    {
        var dieTasteSchliesstDieWahl = taste.Key == "Escape";
        if (!dieTasteSchliesstDieWahl)
        {
            return;
        }

        SchliessePopover();
    }

    private string Popoverstand()
    {
        if (_offenesPopover == Kopfzeilenpopover.Identitaetswahl)
        {
            return "true";
        }

        return "false";
    }

    private string Laufzeitstand()
    {
        if (_offenesPopover == Kopfzeilenpopover.Laufzeitliste)
        {
            return "true";
        }

        return "false";
    }

    private async Task UebernimmWahl(long kontributorId)
    {
        _gewaehlteKontributorId = kontributorId;
        SchliessePopover();
        await Identitaetsspeicher.Merke(kontributorId);
    }

    // Gespeichert ist nur die KontributorId; der Name ist eine Ableitung aus der Liste, damit ein
    // Umbenennen nachzieht und eine unbekannte Id zu „nicht gewählt" wird statt zu einem
    // verwaisten Namen. Aufgelöst wird über die Wählbaren, nicht über die volle Liste: ein
    // inzwischen Stillgelegter gilt wie unbekannt — sonst arbeitete jemand weiter unter einer
    // Identität, die gerade aus der Wahl verschwunden ist. Der Identitätsspeicher wird dabei
    // nicht angefasst; die Id bleibt liegen und trägt wieder, sobald zurückgeholt wird.
    private string Identitaetsbeschriftung()
    {
        var waehlbare = Identitaetsliste.Waehlbare(_kontributoren);
        var gewaehlterKontributor = waehlbare.FirstOrDefault(EntsprichtDerWahl);
        var esGibtKeineGueltigeWahl = gewaehlterKontributor is null;
        if (esGibtKeineGueltigeWahl)
        {
            return NichtGewaehlt;
        }

        return gewaehlterKontributor!.Name;
    }

    private bool EntsprichtDerWahl(Kontributor kontributor)
    {
        return kontributor.KontributorId == _gewaehlteKontributorId;
    }
}
