@implements IDisposable
@using KanbanC.Contracts.Kontributoren
@inject NavigationManager Navigation
@inject KontributorenApiKlient ApiKlient

<header class="kopfzeile" id="kopfzeile">
    @* Zone 1 — wo die Seite steht. Den Platz füllt sie selbst; auf dem Board steht
       hier sein Name, auf der Übersicht deren Titel. Eine Wortmarke gibt es nicht:
       wer die Anwendung offen hat, weiß, welche es ist — der Platz gehört dem Inhalt. *@
    <div class="kopfzeile-kontext">
        <SectionOutlet SectionName="kopfzeile-kontext" />
    </div>

    @* Zone 2 — die Hauptnavigation. *@
    <div class="kopfzeile-anwendung">
        <nav class="kopfzeile-navigation" id="hauptnavigation" aria-label="Hauptnavigation">
            @* Steht ein Board offen, führt der Rückweg in seiner Kopfzeile schon dorthin —
               der Punkt wäre dieselbe Verknüpfung ein zweites Mal. *@
            @if (!_einBoardIstOffen)
            {
                <NavLink class="navigationspunkt"
                         ActiveClass="navigationspunkt-aktiv"
                         id="navigation-boards"
                         href="boards">Boards</NavLink>
            }
            <span class="navigationspunkt navigationspunkt-gesperrt"
                  id="navigation-auswertungen"
                  aria-disabled="true"
                  title="Noch nicht verfügbar">Auswertungen</span>
            <NavLink class="navigationspunkt"
                     ActiveClass="navigationspunkt-aktiv"
                     id="navigation-kontributoren"
                     href="kontributoren">Kontributoren</NavLink>
        </nav>
    </div>

    @* Zone 3 — Werkzeuge und Identität, rechtsbündig. *@
    <div class="kopfzeile-werkzeuge">
        <SectionOutlet SectionName="kopfzeile-bedienung" />
        <div class="identitaetsplatz" @onkeydown="AufTaste">
            @if (_popoverIstOffen)
            {
                <div class="identitaets-auffangflaeche" id="identitaet-auffangflaeche" @onclick="SchliessePopover"></div>
            }
            <button type="button"
                    class="kopfzeile-identitaet"
                    id="identitaet"
                    aria-haspopup="true"
                    aria-expanded="@Popoverstand()"
                    @onclick="SchaltePopover">@Identitaetsbeschriftung()<svg class="identitaets-chevron" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button>
            @if (_popoverIstOffen)
            {
                <div class="identitaetspopover" id="identitaetspopover">
                    <p class="identitaetspopover-titel">Ich bin …</p>
                    <Identitaetswahl Kontributoren="_kontributoren"
                                     GewaehlteKontributorId="_gewaehlteKontributorId"
                                     Gewaehlt="UebernimmWahl" />
                </div>
            }
        </div>
    </div>
</header>

@code {
    private const string NichtGewaehlt = "nicht gewählt";

    private bool _einBoardIstOffen;
    private bool _popoverIstOffen;
    private IReadOnlyList<Kontributor> _kontributoren = [];
    private long? _gewaehlteKontributorId;

    protected override async Task OnInitializedAsync()
    {
        UebernimmAdresse();
        Navigation.LocationChanged += AufAdresswechsel;
        await LadeKontributoren();
    }

    // Die Liste wird je Blazor-Kreislauf einmal geholt, nicht je Seitenwechsel: die Kopfzeile
    // steht auf jeder Seite, ein Aufruf je Navigation wäre einer zu viel.
    private async Task LadeKontributoren()
    {
        await WebApiAufruf.MitAusfallmeldung(async () => _kontributoren = await ApiKlient.LadeAlle());
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= AufAdresswechsel;
    }

    private void AufAdresswechsel(object? absender, LocationChangedEventArgs ereignis)
    {
        UebernimmAdresse();
        SchliessePopover();
        StateHasChanged();
    }

    private void UebernimmAdresse()
    {
        _einBoardIstOffen = Boardadresse.ZeigtAufEinBoard(Navigation.Uri);
    }

    private void SchaltePopover()
    {
        _popoverIstOffen = !_popoverIstOffen;
    }

    private void SchliessePopover()
    {
        _popoverIstOffen = false;
    }

    private void AufTaste(KeyboardEventArgs taste)
    {
        var dieTasteSchliesstDieWahl = taste.Key == "Escape";
        if (!dieTasteSchliesstDieWahl)
        {
            return;
        }

        SchliessePopover();
    }

    private string Popoverstand()
    {
        if (_popoverIstOffen)
        {
            return "true";
        }

        return "false";
    }

    private void UebernimmWahl(long kontributorId)
    {
        _gewaehlteKontributorId = kontributorId;
        SchliessePopover();
    }

    // Gespeichert ist nur die KontributorId; der Name ist eine Ableitung aus der Liste, damit ein
    // Umbenennen nachzieht und eine unbekannte Id zu „nicht gewählt" wird statt zu einem
    // verwaisten Namen.
    private string Identitaetsbeschriftung()
    {
        var gewaehlterKontributor = _kontributoren.FirstOrDefault(EntsprichtDerWahl);
        var esGibtKeineGueltigeWahl = gewaehlterKontributor is null;
        if (esGibtKeineGueltigeWahl)
        {
            return NichtGewaehlt;
        }

        return gewaehlterKontributor!.Name;
    }

    private bool EntsprichtDerWahl(Kontributor kontributor)
    {
        return kontributor.KontributorId == _gewaehlteKontributorId;
    }
}
