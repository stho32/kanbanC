@implements IDisposable
@inject NavigationManager Navigation

<header class="kopfzeile" id="kopfzeile">
    @* Zone 1 — wo die Seite steht. Den Platz füllt sie selbst; auf dem Board steht
       hier sein Name, auf der Übersicht deren Titel. Eine Wortmarke gibt es nicht:
       wer die Anwendung offen hat, weiß, welche es ist — der Platz gehört dem Inhalt. *@
    <div class="kopfzeile-kontext">
        <SectionOutlet SectionName="kopfzeile-kontext" />
    </div>

    @* Zone 2 — die Hauptnavigation. *@
    <div class="kopfzeile-anwendung">
        <nav class="kopfzeile-navigation" id="hauptnavigation" aria-label="Hauptnavigation">
            @* Steht ein Board offen, führt der Rückweg in seiner Kopfzeile schon dorthin —
               der Punkt wäre dieselbe Verknüpfung ein zweites Mal. *@
            @if (!_einBoardIstOffen)
            {
                <NavLink class="navigationspunkt"
                         ActiveClass="navigationspunkt-aktiv"
                         id="navigation-boards"
                         href="boards">Boards</NavLink>
            }
            <span class="navigationspunkt navigationspunkt-gesperrt"
                  id="navigation-auswertungen"
                  aria-disabled="true"
                  title="Noch nicht verfügbar">Auswertungen</span>
            <NavLink class="navigationspunkt"
                     ActiveClass="navigationspunkt-aktiv"
                     id="navigation-kontributoren"
                     href="kontributoren">Kontributoren</NavLink>
        </nav>
    </div>

    @* Zone 3 — Werkzeuge und Identität, rechtsbündig. *@
    <div class="kopfzeile-werkzeuge">
        <SectionOutlet SectionName="kopfzeile-bedienung" />
        <div class="identitaetsplatz" @onkeydown="AufTaste">
            @if (_popoverIstOffen)
            {
                <div class="identitaets-auffangflaeche" id="identitaet-auffangflaeche" @onclick="SchliessePopover"></div>
            }
            <button type="button"
                    class="kopfzeile-identitaet"
                    id="identitaet"
                    aria-haspopup="true"
                    aria-expanded="@Popoverstand()"
                    @onclick="SchaltePopover">nicht gewählt<svg class="identitaets-chevron" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button>
            @if (_popoverIstOffen)
            {
                <div class="identitaetspopover" id="identitaetspopover">
                    <p class="identitaetspopover-titel">Ich bin …</p>
                </div>
            }
        </div>
    </div>
</header>

@code {
    private bool _einBoardIstOffen;
    private bool _popoverIstOffen;

    protected override void OnInitialized()
    {
        UebernimmAdresse();
        Navigation.LocationChanged += AufAdresswechsel;
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= AufAdresswechsel;
    }

    private void AufAdresswechsel(object? absender, LocationChangedEventArgs ereignis)
    {
        UebernimmAdresse();
        SchliessePopover();
        StateHasChanged();
    }

    private void SchaltePopover()
    {
        _popoverIstOffen = !_popoverIstOffen;
    }

    private void SchliessePopover()
    {
        _popoverIstOffen = false;
    }

    private void AufTaste(KeyboardEventArgs taste)
    {
        var dieTasteSchliesstDieWahl = taste.Key == "Escape";
        if (!dieTasteSchliesstDieWahl)
        {
            return;
        }

        SchliessePopover();
    }

    private string Popoverstand()
    {
        if (_popoverIstOffen)
        {
            return "true";
        }

        return "false";
    }

    private void UebernimmAdresse()
    {
        _einBoardIstOffen = Boardadresse.ZeigtAufEinBoard(Navigation.Uri);
    }
}
