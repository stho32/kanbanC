@page "/kontributoren"
@using KanbanC.Blazor.Services
@using KanbanC.Contracts.Kontributoren
@inject KontributorenApiKlient ApiKlient

<PageTitle>Kontributoren</PageTitle>

<SectionContent SectionName="kopfzeile-kontext">
    <h1 class="kopfzeile-titel">Kontributoren</h1>
</SectionContent>

<div class="seitenkopf">
    <h1 class="nur-fuer-screenreader">Kontributoren</h1>
    <span class="tag tag-neutral">Full-Trust · keine Anmeldung</span>
</div>

@if (_fehlermeldung is not null)
{
    <div class="meldung" role="alert" id="fehlermeldung">@_fehlermeldung</div>
}

<table class="table kontributorenliste" id="kontributoren-liste">
    <thead>
        <tr>
            <th class="spalte-name">Name</th>
            <th class="spalte-art">Art</th>
            <th class="spalte-pflege">Pflege</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var kontributor in _kontributoren)
        {
            if (_offeneKontributorId == kontributor.KontributorId)
            {
                <tr class="bearbeitungszeile" id="kontributor-bearbeiten-zeile">
                    <td colspan="3">
                        <div class="bearbeitungsfelder">
                            <span class="kuerzel @Kontributorartform.Kuerzelklasse(kontributor.Art)">@Kontributorartform.Kuerzel(kontributor.Name)</span>
                            <span class="bearbeitungsname">@kontributor.Name</span>
                        </div>
                    </td>
                </tr>
            }
            else
            {
                <tr class="kontributorzeile" id="kontributor-@kontributor.KontributorId">
                    <td>
                        <span class="kontributor-name">
                            <span class="kuerzel @Kontributorartform.Kuerzelklasse(kontributor.Art)">@Kontributorartform.Kuerzel(kontributor.Name)</span>@kontributor.Name
                        </span>
                    </td>
                    <td>
                        <span class="artplakette tag @Kontributorartform.Plakettenklasse(kontributor.Art)">@Kontributorartform.Beschriftung(kontributor.Art)</span>
                    </td>
                    <td class="zelle-pflege">
                        <button type="button"
                                class="btn btn-schlicht btn-symbol kontributor-stift"
                                id="kontributor-bearbeiten-@kontributor.KontributorId"
                                title="bearbeiten"
                                aria-label="@kontributor.Name bearbeiten"
                                @onclick="() => OeffneBearbeitung(kontributor)">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20h4l10-10-4-4L4 16z"></path><path d="m14 6 4 4"></path></svg>
                        </button>
                    </td>
                </tr>
            }
        }
        <tr class="anlegezeile">
            <td colspan="3">
                <div class="anlegefelder" id="kontributor-anlegen-zeile">
                    <span class="kuerzel kuerzel-neu" aria-hidden="true">+</span>
                    <input type="text"
                           class="input feld-name"
                           id="kontributor-name"
                           placeholder="Name"
                           aria-label="Name"
                           @bind="_formular.Name" />
                    <span class="seg" id="kontributor-artwahl">
                        @foreach (var art in Waehlbare)
                        {
                            <label class="seg-opt" id="@Artwahlkennung(art)">
                                <input type="radio"
                                       name="kontributorart"
                                       checked="@(_formular.Art == art)"
                                       @onchange="() => WaehleArt(art)" />
                                @Kontributorartform.Beschriftung(art)
                            </label>
                        }
                    </span>
                    <button type="button" class="btn btn-haupt" id="kontributor-anlegen" @onclick="LegeKontributorAn">anlegen</button>
                </div>
            </td>
        </tr>
    </tbody>
</table>

@if (_zurueckweisungsmeldung is not null)
{
    <div class="meldung meldung-abweisung" role="alert" id="zurueckweisung">
        <p>@_zurueckweisungsmeldung</p>
    </div>
}

@code {
    // Die Reihenfolge der Segmentwahl folgt dem Artboard; Mensch steht vorn und ist vorgewählt.
    private static readonly Kontributorart[] Waehlbare = [Kontributorart.Mensch, Kontributorart.Agent, Kontributorart.Abgebildet];

    private readonly Kontributorformular _formular = new();
    private IReadOnlyList<Kontributor> _kontributoren = [];
    private long? _offeneKontributorId;
    private string? _zurueckweisungsmeldung;
    private string? _fehlermeldung;

    protected override async Task OnInitializedAsync()
    {
        await LadeListeNeu();
    }

    // Genau eine Zeile ist offen: mehrere Formulare mit je eigenem ungespeichertem Stand waeren
    // ein Zustand, den niemand angefordert hat.
    private void OeffneBearbeitung(Kontributor kontributor)
    {
        _offeneKontributorId = kontributor.KontributorId;
    }

    private void WaehleArt(Kontributorart art)
    {
        _formular.Art = art;
    }

    // Nach dem Anlegen wird die ganze Liste neu geholt, statt den neuen Kontributor lokal
    // einzusortieren: die Reihenfolge gehört der Abfrage.
    private async Task LegeKontributorAn()
    {
        await MitErreichbarerWebApi(async () =>
        {
            var ergebnis = await ApiKlient.LegeAn(_formular.AlsAnfrage());
            if (ergebnis.WurdeZurueckgewiesen)
            {
                _zurueckweisungsmeldung = Kontributorenmeldung.Aus(ergebnis.Zurueckweisung);
                return;
            }

            _zurueckweisungsmeldung = null;
            _formular.LeereNamensfeld();
            _kontributoren = await ApiKlient.LadeAlle();
        });
    }

    private async Task LadeListeNeu()
    {
        await MitErreichbarerWebApi(async () => _kontributoren = await ApiKlient.LadeAlle());
    }

    private async Task MitErreichbarerWebApi(Func<Task> aufruf)
    {
        _fehlermeldung = await WebApiAufruf.MitAusfallmeldung(aufruf);
    }

    private static string Artwahlkennung(Kontributorart art)
    {
        return $"art-{art.ToString().ToLowerInvariant()}";
    }

    // Adaptermodell des Formular-Bindings: veränderlich, weil die Zeile es so braucht; verlässt
    // die Seite nie.
    private sealed class Kontributorformular
    {
        public string Name { get; set; } = "";

        public Kontributorart Art { get; set; } = Kontributorart.Mensch;

        public KontributorAnlegenAnfrage AlsAnfrage()
        {
            return new KontributorAnlegenAnfrage(Name, Art);
        }

        // Die eingestellte Art bleibt stehen: wer mehrere Agenten eintraegt, waehlt nicht jedes
        // Mal neu.
        public void LeereNamensfeld()
        {
            Name = "";
        }
    }
}
