@page "/kontributoren"
@using KanbanC.Blazor.Services
@using KanbanC.Contracts.Kontributoren
@inject KontributorenApiKlient ApiKlient

<PageTitle>Kontributoren</PageTitle>

<SectionContent SectionName="kopfzeile-kontext">
    <h1 class="kopfzeile-titel">Kontributoren</h1>
</SectionContent>

<div class="seitenkopf">
    <h1 class="nur-fuer-screenreader">Kontributoren</h1>
    <span class="tag tag-neutral">Full-Trust · keine Anmeldung</span>
</div>

@if (_fehlermeldung is not null)
{
    <div class="meldung" role="alert" id="fehlermeldung">@_fehlermeldung</div>
}

<table class="table kontributorenliste" id="kontributoren-liste">
    <thead>
        <tr>
            <th class="spalte-name">Name</th>
            <th class="spalte-art">Art</th>
            <th class="spalte-pflege">Pflege</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var kontributor in _kontributoren)
        {
            if (IstInBearbeitung(kontributor))
            {
                <tr class="bearbeitungszeile" id="kontributor-bearbeiten-zeile">
                    <td colspan="3">
                        <div class="bearbeitungsfelder">
                            <span class="kuerzel @Kontributorartform.Kuerzelklasse(_bearbeitung!.Art)">@Kontributorartform.Kuerzel(_bearbeitung.Name)</span>
                            <input type="text"
                                   class="input feld-name"
                                   id="kontributor-bearbeiten-name"
                                   placeholder="Name"
                                   aria-label="Name"
                                   @bind="_bearbeitung.Name" />
                            <span class="seg" id="kontributor-bearbeiten-artwahl">
                                @foreach (var art in Waehlbare)
                                {
                                    <label class="seg-opt" id="@Bearbeitungsartwahlkennung(art)">
                                        <input type="radio"
                                               name="kontributorart-bearbeiten"
                                               checked="@(_bearbeitung.Art == art)"
                                               @onchange="() => WaehleBearbeitungsart(art)" />
                                        @Kontributorartform.Beschriftung(art)
                                    </label>
                                }
                            </span>
                            <span class="bearbeitungsschalter">
                                <button type="button" class="btn btn-haupt" id="kontributor-sichern" @onclick="SichereBearbeitung">sichern</button>
                                <button type="button" class="btn btn-schlicht" id="kontributor-verwerfen" @onclick="VerwirfBearbeitung">verwerfen</button>
                            </span>
                        </div>
                    </td>
                </tr>
            }
            else
            {
                @* Die Gruppenzeile steht vor der ersten stillgelegten Zeile und nur dann, wenn es
                   eine gibt — eine Überschrift „stillgelegt · 0“ hätte keinen Inhalt. Muster ist
                   die Trennlinie der Identitätswahl. *@
                if (BeginntDieGruppeDerStillgelegten(kontributor))
                {
                    <tr class="gruppenzeile" id="kontributor-gruppe-stillgelegt">
                        <td colspan="3">stillgelegt · @AnzahlStillgelegter()</td>
                    </tr>
                }

                <tr class="kontributorzeile @Zeilenklasse(kontributor)" id="kontributor-@kontributor.KontributorId">
                    <td>
                        <span class="kontributor-name">
                            <span class="kuerzel @Kontributorartform.Kuerzelklasse(kontributor.Art)">@Kontributorartform.Kuerzel(kontributor.Name)</span>@kontributor.Name
                        </span>
                        @if (!IstAktiv(kontributor))
                        {
                            <span class="stillgelegt-seit">stillgelegt seit @Terminformatierer.AlsText(kontributor.StillgelegtAm)</span>
                        }
                    </td>
                    <td>
                        <span class="artplakette tag @Kontributorartform.Plakettenklasse(kontributor.Art)">@Kontributorartform.Beschriftung(kontributor.Art)</span>
                    </td>
                    <td class="zelle-pflege">
                        <span class="pflegeschalter">
                            @if (IstAktiv(kontributor))
                            {
                            <button type="button"
                                    class="btn btn-schlicht btn-symbol kontributor-stift"
                                    id="kontributor-bearbeiten-@kontributor.KontributorId"
                                    title="bearbeiten"
                                    aria-label="@kontributor.Name bearbeiten"
                                    @onclick="() => OeffneBearbeitung(kontributor)">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20h4l10-10-4-4L4 16z"></path><path d="m14 6 4 4"></path></svg>
                            </button>
                            <button type="button"
                                    class="btn btn-schlicht btn-symbol kontributor-stilllegen"
                                    id="kontributor-stilllegen-@kontributor.KontributorId"
                                    title="stilllegen"
                                    aria-label="@kontributor.Name stilllegen"
                                    @onclick="() => SetzeStilllegung(kontributor, true)">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M9 5v14M15 5v14"></path></svg>
                            </button>
                            }
                            else
                            {
                            <button type="button"
                                    class="btn btn-schlicht kontributor-zurueckholen"
                                    id="kontributor-zurueckholen-@kontributor.KontributorId"
                                    aria-label="@kontributor.Name zurückholen"
                                    @onclick="() => SetzeStilllegung(kontributor, false)">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7"></path><path d="M3 4v5h5"></path></svg>zurückholen
                            </button>
                            }
                        </span>
                    </td>
                </tr>
            }
        }
        <tr class="anlegezeile">
            <td colspan="3">
                <div class="anlegefelder" id="kontributor-anlegen-zeile">
                    <span class="kuerzel kuerzel-neu" aria-hidden="true">+</span>
                    <input type="text"
                           class="input feld-name"
                           id="kontributor-name"
                           placeholder="Name"
                           aria-label="Name"
                           @bind="_formular.Name" />
                    <span class="seg" id="kontributor-artwahl">
                        @foreach (var art in Waehlbare)
                        {
                            <label class="seg-opt" id="@Artwahlkennung(art)">
                                <input type="radio"
                                       name="kontributorart"
                                       checked="@(_formular.Art == art)"
                                       @onchange="() => WaehleArt(art)" />
                                @Kontributorartform.Beschriftung(art)
                            </label>
                        }
                    </span>
                    <button type="button" class="btn btn-haupt" id="kontributor-anlegen" @onclick="LegeKontributorAn">anlegen</button>
                </div>
            </td>
        </tr>
    </tbody>
</table>

@if (_zurueckweisungsmeldung is not null)
{
    <div class="meldung meldung-abweisung" role="alert" id="zurueckweisung">
        <p>@_zurueckweisungsmeldung</p>
    </div>
}

@code {
    // Die Reihenfolge der Segmentwahl folgt dem Artboard; Mensch steht vorn und ist vorgewählt.
    private static readonly Kontributorart[] Waehlbare = [Kontributorart.Mensch, Kontributorart.Agent, Kontributorart.Abgebildet];

    private readonly Kontributorformular _formular = new();
    private IReadOnlyList<Kontributor> _kontributoren = [];
    private Kontributorbearbeitung? _bearbeitung;
    private string? _zurueckweisungsmeldung;
    private string? _fehlermeldung;

    protected override async Task OnInitializedAsync()
    {
        await LadeListeNeu();
    }

    // Aktiv heißt: es liegt keine Stilllegung vor. Der Wahrheitswert steht nicht im DTO, weil er
    // aus dem Datum ableitbar ist — hier ist die eine Stelle, die ihn ausspricht.
    private static bool IstAktiv(Kontributor kontributor)
    {
        return kontributor.StillgelegtAm is null;
    }

    private static string Zeilenklasse(Kontributor kontributor)
    {
        if (IstAktiv(kontributor))
        {
            return "";
        }

        return "kontributorzeile-stillgelegt";
    }

    // Die Liste kommt sortiert: die Stillgelegten stehen am Ende. Der erste von ihnen ist der,
    // vor dem die Gruppenzeile steht.
    private bool BeginntDieGruppeDerStillgelegten(Kontributor kontributor)
    {
        var ersterStillgelegter = _kontributoren.FirstOrDefault(kandidat => !IstAktiv(kandidat));
        return ersterStillgelegter is not null && ersterStillgelegter.KontributorId == kontributor.KontributorId;
    }

    private int AnzahlStillgelegter()
    {
        return _kontributoren.Count(kandidat => !IstAktiv(kandidat));
    }

    private bool IstInBearbeitung(Kontributor kontributor)
    {
        return _bearbeitung is not null && _bearbeitung.KontributorId == kontributor.KontributorId;
    }

    // Genau eine Zeile ist offen: mehrere Formulare mit je eigenem ungespeichertem Stand wären
    // ein Zustand, den niemand angefordert hat. Jedes Öffnen legt ein frisches Formular an, damit
    // der Stand des zuletzt Bearbeiteten nicht stehen bleibt.
    private void OeffneBearbeitung(Kontributor kontributor)
    {
        _bearbeitung = new Kontributorbearbeitung(kontributor);
        _zurueckweisungsmeldung = null;
    }

    private void WaehleBearbeitungsart(Kontributorart art)
    {
        _bearbeitung!.Art = art;
    }

    // Nach dem Sichern wird die ganze Liste neu geholt, statt den Kontributor lokal
    // umzusortieren: die Reihenfolge gehört der Abfrage.
    private async Task SichereBearbeitung()
    {
        var bearbeitung = _bearbeitung!;
        await MitErreichbarerWebApi(async () =>
        {
            var ergebnis = await ApiKlient.Aendere(bearbeitung.KontributorId, bearbeitung.AlsAnfrage());
            if (ergebnis.WurdeZurueckgewiesen)
            {
                _zurueckweisungsmeldung = Kontributorenmeldung.AusAenderung(ergebnis.Zurueckweisung);
                return;
            }

            _zurueckweisungsmeldung = null;
            _bearbeitung = null;
            _kontributoren = await ApiKlient.LadeAlle();
        });
    }

    // Nach dem Schalten wird die ganze Liste neu geholt, statt die Zeile lokal umzuhängen: die
    // Reihenfolge gehört der Abfrage. Eine offene Bearbeitungszeile wird geschlossen — ihr Stand
    // gehörte zu einer Liste, die es so nicht mehr gibt.
    private async Task SetzeStilllegung(Kontributor kontributor, bool istStillgelegt)
    {
        await MitErreichbarerWebApi(async () =>
        {
            var ergebnis = await ApiKlient.SetzeStilllegung(kontributor.KontributorId, new Stilllegung(istStillgelegt));
            if (ergebnis.WurdeZurueckgewiesen)
            {
                _zurueckweisungsmeldung = Kontributorenmeldung.AusStilllegung(ergebnis.Zurueckweisung);
                return;
            }

            _zurueckweisungsmeldung = null;
            _bearbeitung = null;
            _kontributoren = await ApiKlient.LadeAlle();
        });
    }

    private void VerwirfBearbeitung()
    {
        _bearbeitung = null;
        _zurueckweisungsmeldung = null;
    }

    private void WaehleArt(Kontributorart art)
    {
        _formular.Art = art;
    }

    // Nach dem Anlegen wird die ganze Liste neu geholt, statt den neuen Kontributor lokal
    // einzusortieren: die Reihenfolge gehört der Abfrage.
    private async Task LegeKontributorAn()
    {
        await MitErreichbarerWebApi(async () =>
        {
            var ergebnis = await ApiKlient.LegeAn(_formular.AlsAnfrage());
            if (ergebnis.WurdeZurueckgewiesen)
            {
                _zurueckweisungsmeldung = Kontributorenmeldung.AusAnlage(ergebnis.Zurueckweisung);
                return;
            }

            _zurueckweisungsmeldung = null;
            _formular.LeereNamensfeld();
            _kontributoren = await ApiKlient.LadeAlle();
        });
    }

    private async Task LadeListeNeu()
    {
        await MitErreichbarerWebApi(async () => _kontributoren = await ApiKlient.LadeAlle());
    }

    private async Task MitErreichbarerWebApi(Func<Task> aufruf)
    {
        _fehlermeldung = await WebApiAufruf.MitAusfallmeldung(aufruf);
    }

    private static string Artwahlkennung(Kontributorart art)
    {
        return $"art-{art.ToString().ToLowerInvariant()}";
    }

    private static string Bearbeitungsartwahlkennung(Kontributorart art)
    {
        return $"bearbeiten-art-{art.ToString().ToLowerInvariant()}";
    }

    // Adaptermodell der aufgeklappten Zeile: veränderlich, weil die Bindung es so braucht;
    // verlässt die Seite nie. Es trägt die KontributorId mit, damit „welche Zeile ist offen“ und
    // „was steht in ihren Feldern“ nicht zwei Wahrheiten sind.
    private sealed class Kontributorbearbeitung
    {
        public Kontributorbearbeitung(Kontributor kontributor)
        {
            KontributorId = kontributor.KontributorId;
            Name = kontributor.Name;
            Art = kontributor.Art;
        }

        public long KontributorId { get; }

        public string Name { get; set; }

        public Kontributorart Art { get; set; }

        public KontributorAendernAnfrage AlsAnfrage()
        {
            return new KontributorAendernAnfrage(Name, Art);
        }
    }

    // Adaptermodell des Formular-Bindings: veränderlich, weil die Zeile es so braucht; verlässt
    // die Seite nie.
    private sealed class Kontributorformular
    {
        public string Name { get; set; } = "";

        public Kontributorart Art { get; set; } = Kontributorart.Mensch;

        public KontributorAnlegenAnfrage AlsAnfrage()
        {
            return new KontributorAnlegenAnfrage(Name, Art);
        }

        // Die eingestellte Art bleibt stehen: wer mehrere Agenten eintraegt, waehlt nicht jedes
        // Mal neu.
        public void LeereNamensfeld()
        {
            Name = "";
        }
    }
}
