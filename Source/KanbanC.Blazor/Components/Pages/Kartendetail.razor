@page "/karten/{KarteId:long}"
@using System.Globalization
@using KanbanC.Blazor.Components.Karten
@using KanbanC.Blazor.Services
@using KanbanC.Contracts.Fehler
@using KanbanC.Contracts.Karten
@using KanbanC.Contracts.Klassen
@using KanbanC.Contracts.Kontributoren
@using KanbanC.Contracts.Zeiten
@using Microsoft.AspNetCore.Components.Forms
@inject KartenApiKlient KartenKlient
@inject KartenklassenApiKlient KartenklassenKlient
@inject KontributorenApiKlient KontributorenKlient
@inject ZeitenApiKlient ZeitenKlient
@inject Identitaetsspeicher Identitaetsspeicher
@inject Pfadkopie Pfadkopie
@inject Anhangbasisadresse Anhangbasis
@inject IJSRuntime Browser

<PageTitle>Karte @KarteId</PageTitle>

@if (_webApiIstNichtErreichbar)
{
    <div class="meldung" role="alert" id="fehlermeldung">
        <p>@WebApiAusfall.Meldung</p>
        <a href="/boards" id="zur-board-liste">Zurück zur Board-Liste</a>
    </div>
}
else if (!_ladenIstAbgeschlossen)
{
    <p>Die Karte wird geladen …</p>
}
else if (_detail is null)
{
    @* Wortgleich zu Board.razor, nur mit „Karte". Der Rückweg führt zur Board-Liste und nicht
       zum Board: zu einer Kartennummer, die es nicht gibt, gehört kein Board — eine geratene
       Nummer im Verweis wäre dieselbe Falschaussage, die der Befund der API vermeidet. *@
    <div class="meldung" role="alert" id="karte-unbekannt">
        <p>Eine Karte mit der Nummer @KarteId gibt es nicht.</p>
        <a href="/boards" id="zur-board-liste">Zurück zur Board-Liste</a>
    </div>
}
else
{
    @* Zone 1 trägt die offene Seite: der Pfeil führt zum Board zurück, die Überschrift nennt es.
       Der Kartentitel steht nicht hier, sondern als Überschrift im Blatt — dort wird er auch
       geändert. *@
    <SectionContent SectionName="kopfzeile-kontext">
        <a href="/boards/@_detail.Board" id="karte-zurueck" class="karte-zurueck" title="Zurück zum Board">←</a>
        <h1 id="karte-boardname" class="karte-boardname">@_detail.Boardname</h1>
        <span class="tag tag-neutral" id="karte-plakette">Karte @KarteId</span>
        <span class="karte-spalte" id="karte-spalte">Spalte @_detail.Spaltenbezeichnung</span>
    </SectionContent>

    <nav class="brotkrumen" id="brotkrumen" aria-label="Brotkrumen">
        <a href="/boards">Boards</a>
        <span aria-hidden="true">/</span>
        <a href="/boards/@_detail.Board">@_detail.Boardname</a>
        <span aria-hidden="true">/</span>
        <span class="brotkrume-hier">Karte @KarteId</span>
    </nav>

    @if (_zurueckweisung is not null)
    {
        <div class="meldung meldung-abweisung" role="alert" id="kartenblatt-zurueckweisung">
            <ul>
                @foreach (var befund in _zurueckweisung.Befunde)
                {
                    <li>@befund.Meldung</li>
                }
            </ul>
        </div>
    }
    @if (_ausfallmeldung is not null)
    {
        <div class="meldung" role="alert" id="kartenblatt-fehlermeldung">@_ausfallmeldung</div>
    }
    @* Die Meldungen der Ablegevorgänge stehen nebeneinander: bei einer erzwungenen Überlappung
       haben zwei Vorgänge zugleich etwas zu sagen, und keiner darf den anderen verdrängen —
       sonst verschwände einer wieder stumm. Ohne @key: zwei gleichlautende Meldungen sind
       möglich, und eine doppelte Elementkennung risse den Kreislauf ab. *@
    @foreach (var anhangmeldung in _anhangmeldungen)
    {
        <div class="meldung anhangmeldung" role="alert">@anhangmeldung</div>
    }

    @* Das Blatt liest die Identitätswahl neu, sobald jemand es betritt — mit dem Zeiger oder mit
       der Tabulatortaste. Die Kopfzeile ist eine eigene Komponente und lässt diese Seite beim
       Wechseln der Identität nicht neu zeichnen; ohne dieses Nachlesen bliebe „senden" gesperrt,
       bis die Seite neu geladen wird. Der Anlass sitzt am **Blatt** und nicht an der
       Schreibzeile: ein gesperrter Knopf nimmt keine Zeigerereignisse an, und die Sperre hielte
       sich dann selbst fest. Die Kapselung der Kopfzeile bleibt unangetastet. *@
    <div class="kartenblatt" @onmouseenter="LiesUrheberNach" @onfocusin="LiesUrheberNach">
        <div class="karteninhalt">
            @* Der Titel steht dort, wo man ihn liest, und wird an derselben Stelle geändert.
               Nach einer Zurückweisung schließt das Feld wieder — so bleibt die vorige Fassung
               sichtbar stehen, statt hinter der abgewiesenen Eingabe zu verschwinden. *@
            @if (IstOffen(Titelfeld))
            {
                <input class="kartenueberschrift kartenueberschrift-feld"
                       id="titel-feld"
                       value="@_detail.Karte.Titel"
                       autofocus
                       @onchange="SetzeTitel" />
            }
            else
            {
                <div class="ueberschriftzeile">
                    <h2 class="kartenueberschrift" id="kartenueberschrift">@_detail.Karte.Titel</h2>
                    <button type="button" class="btn btn-schlicht btn-symbol blattstift" id="titel-bearbeiten" title="Titel ändern" @onclick="() => Oeffne(Titelfeld)">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20h4l10-10-4-4L4 16z"></path><path d="m14 6 4 4"></path></svg>
                    </button>
                </div>
            }

            <section class="blattabschnitt">
                <h3 class="blattueberschrift">Beschreibung</h3>
                @if (IstOffen(Beschreibungsfeld))
                {
                    <textarea class="input beschreibungsfeld" id="beschreibung-feld" rows="5" @onchange="SetzeBeschreibung">@_detail.Karte.Beschreibung</textarea>
                }
                else if (string.IsNullOrEmpty(_detail.Karte.Beschreibung))
                {
                    @* Leere Felder tragen die Handlung als Text, keinen leeren Kasten. *@
                    <button type="button" class="blatthandlung" id="beschreibung-hinzufuegen" @onclick="() => Oeffne(Beschreibungsfeld)">Beschreibung hinzufügen</button>
                }
                else
                {
                    <p class="beschreibung" id="beschreibung" @onclick="() => Oeffne(Beschreibungsfeld)">@_detail.Karte.Beschreibung</p>
                }
            </section>

            @* Der Abschnitt heißt „Teilaufgaben" und nicht „Subtasks": eine bewusste Abweichung
               vom Artboard, das hier als einzigen Abschnittstitel ein englisches Wort trägt.
               Die gebaute Oberfläche ist durchgehend deutsch, und C06 verbietet zwei Namen für
               dasselbe Ding. Alles andere folgt der Skizze. *@
            <section class="blattabschnitt" id="teilaufgabenabschnitt">
                <div class="teilaufgabenkopf">
                    <h3 class="blattueberschrift">Teilaufgaben</h3>
                    @* Fortschritt und Balken bleiben fort, solange nichts zu zählen ist: „0 von 0"
                       wäre eine Aussage über nichts. *@
                    @if (HatTeilaufgaben)
                    {
                        <span class="teilaufgabenstand" id="teilaufgabenstand">@Teilaufgabenfortschritt.AlsText(_detail.Teilaufgaben)</span>
                        <span class="teilaufgabenbalken"
                              id="teilaufgabenbalken"
                              role="progressbar"
                              aria-valuemin="0"
                              aria-valuemax="100"
                              aria-valuenow="@Balkenanteil">
                            <span class="teilaufgabenbalken-anteil" style="width: @Balkenbreite"></span>
                        </span>
                    }
                </div>

                @if (HatTeilaufgaben)
                {
                    <div class="teilaufgabenliste" id="teilaufgabenliste">
                        @* @key hält die Elementkennung über die Neuaufbauten hinweg fest: nach
                           jedem Abhaken kommt die ganze Liste neu, und ohne Schlüssel ordnete
                           Blazor die Kästchen neu zu. *@
                        @foreach (var teilaufgabe in _detail.Teilaufgaben)
                        {
                            <div class="teilaufgabe @Abhakklasse(teilaufgabe)" @key="teilaufgabe.TeilaufgabeId" data-teilaufgabe="@teilaufgabe.TeilaufgabeId">
                                @* Ein Knopf und keine gezeichnete Fläche mit @onclick: so lässt
                                   sich das Kästchen mit der Tabulatortaste erreichen und mit
                                   Eingabe- oder Leertaste schalten, ohne dass es dafür eigene
                                   Tastenbehandlung bräuchte. aria-pressed sagt den Stand an,
                                   dieselbe Bauform wie die Farbpunkte. *@
                                <button type="button"
                                        class="teilaufgabenkaestchen"
                                        id="teilaufgabe-kaestchen-@teilaufgabe.TeilaufgabeId"
                                        title="@Abhaktitel(teilaufgabe)"
                                        aria-pressed="@AlsAttributtext(teilaufgabe.Abgehakt)"
                                        @onclick="() => SchalteAbhakung(teilaufgabe)">
                                    @if (teilaufgabe.Abgehakt)
                                    {
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="4"></rect><path d="m8 12 3 3 5-6"></path></svg>
                                    }
                                    else
                                    {
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="4"></rect></svg>
                                    }
                                </button>
                                <span class="teilaufgabentext">@teilaufgabe.Text</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    @* Die Handlung statt der Null, wie beim leeren Beschreibungsfeld. „anlegen"
                       setzt den Cursor ins Feld darunter — mehr ist nicht zu tun, es steht
                       ohnehin offen. *@
                    <p class="teilaufgabenleerstand" id="teilaufgaben-leerstand">
                        Keine Teilaufgaben ·
                        <button type="button" class="blatthandlung" id="teilaufgabe-anlegen" @onclick="FokussiereTeilaufgabenfeld">anlegen</button>
                    </p>
                }

                <div class="teilaufgabenzeile">
                    @* Den Text des Feldes führt das Feld selbst, nicht der Server: kein value.
                       Trüge es den serverseitigen Stand, schriebe jede zurückkommende Renderrunde
                       den Stand von vorhin über das, was inzwischen getippt wurde — wer schnell
                       tippt, verlöre Zeichen. Dieselbe Lehre wie beim Etikettenfeld. *@
                    <input class="input teilaufgabenfeld"
                           id="teilaufgabe-eingabe"
                           @ref="_teilaufgabenfeld"
                           placeholder="Teilaufgabe hinzufügen"
                           @oninput="TippeTeilaufgabe"
                           @onkeydown="AufTeilaufgabentaste" />
                    <button type="button" class="btn btn-schlicht btn-symbol" id="teilaufgabe-hinzufuegen" title="Teilaufgabe hinzufügen" @onclick="FuegeTeilaufgabeHinzu">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
                    </button>
                </div>
            </section>

            @* Der Abschnitt steht hinter „Teilaufgaben" in der linken Spalte, wie im Artboard.
               **Eine bewusste Abweichung:** die Metazeile trägt keine „Quelle" (Oberfläche /
               API). Die WebApi sieht in beiden Fällen denselben HTTP-Aufruf — die Oberfläche ist
               selbst nur ein Klient —, und ein Feld, das den Kanal rät, wäre eine stille Lüge.
               Mensch und Agent bleiben trotzdem auseinanderzuhalten: am Kürzel. *@
            <section class="blattabschnitt" id="kommentarabschnitt">
                <div class="kommentarkopf">
                    <h3 class="blattueberschrift">Kommentare</h3>
                    @* Die Anzahl wird gerechnet und nicht mitgesendet — .Count an der gelieferten
                       Liste. Ohne Kommentar bleibt sie fort: eine „0" wäre eine Aussage über
                       nichts, und die Handlung steht schon darunter. *@
                    @if (HatKommentare)
                    {
                        <span class="kommentarzahl" id="kommentarzahl">@Kommentarzahl</span>
                    }
                </div>

                @if (HatKommentare)
                {
                    <div class="kommentarliste" id="kommentarliste">
                        @* @key hält die Elementkennung über die Neuaufbauten hinweg fest: nach
                           jedem Senden kommt die ganze Liste neu. *@
                        @foreach (var kommentar in _detail.Kommentare)
                        {
                            <div class="kommentar" @key="kommentar.KommentarId" data-kommentar="@kommentar.KommentarId">
                                <span class="kuerzel @Kontributorartform.Kuerzelklasse(kommentar.Urheber.Art)" title="@Kontributorartform.Beschriftung(kommentar.Urheber.Art)">@Kontributorartform.Kuerzel(kommentar.Urheber.Name)</span>
                                <div class="kommentarinhalt">
                                    <p class="kommentartext">@kommentar.Text</p>
                                    <p class="kommentarmeta">@Metazeile(kommentar)</p>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    @* Die Handlung statt der Null, wie beim leeren Beschreibungsfeld und bei den
                       Teilaufgaben. „schreiben" setzt den Cursor ins Feld darunter. *@
                    <p class="kommentarleerstand" id="kommentar-leerstand">
                        Noch kein Kommentar ·
                        <button type="button" class="blatthandlung" id="kommentar-schreiben" @onclick="FokussiereKommentarfeld">schreiben</button>
                    </p>
                }

                <div class="kommentarzeile">
                    @if (_urheber is null)
                    {
                        <span class="kuerzel kuerzel-niemand" id="kommentar-kuerzel" title="Niemand gewählt"></span>
                    }
                    else
                    {
                        <span class="kuerzel @Kontributorartform.Kuerzelklasse(_urheber.Art)" id="kommentar-kuerzel" title="@_urheber.Name">@Kontributorartform.Kuerzel(_urheber.Name)</span>
                    }
                    @* Den Text des Feldes führt das Feld selbst, nicht der Server: kein value.
                       Dieselbe Bauform wie das Teilaufgaben- und das Etikettenfeld, und dieselbe
                       Lehre — sonst schriebe jede zurückkommende Renderrunde den Stand von vorhin
                       über das, was inzwischen getippt wurde. *@
                    <input class="input kommentarfeld"
                           id="kommentar-eingabe"
                           @ref="_kommentarfeld"
                           placeholder="Kommentar schreiben"
                           @oninput="TippeKommentar"
                           @onkeydown="AufKommentartaste" />
                    <button type="button"
                            class="btn btn-haupt"
                            id="kommentar-senden"
                            disabled="@(_urheber is null)"
                            title="@Sendetitel"
                            @onclick="SendeKommentar">senden</button>
                </div>

                @* Ohne gewählte Identität wird nicht gesendet: ein Kommentar ohne Absender ist
                   keiner. Gesperrt ist allein diese eine Handlung — Board und Kartenseite bleiben
                   im Übrigen unverändert bedienbar. *@
                @if (_urheber is null)
                {
                    <p class="kommentarhinweis" id="kommentar-hinweis">Wähle oben in der Kopfzeile, wer du bist, um zu kommentieren.</p>
                }
            </section>

            @* Zweispaltige Sektion hinter „Kommentare", wie im Artboard: links die Anhänge,
               rechts die Dateiverweise. Beide Hälften teilen sich die Breite.
               **Der Unterschied zwischen ihnen ist der ganze Zweck:** ein Anhang bringt eine
               Kopie der Datei mit, ein Dateiverweis zeigt auf eine Datei, die dort weiterlebt,
               wo sie hingehört. Ohne Beschriftung zu unterscheiden sind sie an der Gestaltung —
               Büroklammer und Größenangabe links, Schreibmaschinenschrift an oliver Kante rechts.
               **Bewusste Abweichungen vom Artboard, in beiden Hälften:** ein `×` am Zeilenende,
               weil die Entfernen-Route gebaut wird und ohne Bedienelement unerreichbar wäre;
               Urheber und Zeitpunkt im title statt als zweite Textzeile, damit die gezeichnete
               einzeilige Form bleibt. Und die Überschrift rechts heißt **„Dateiverweise"** und
               nicht „Verweise": das Wort ist in dieser Anwendung schon der Hyperlink, und zwei
               Bedeutungen desselben Worts stünden auf demselben Schirm nebeneinander. *@
            @* **Eine** Stelle, die **beide** Listen kennt, und vier Zustände daraus: eine
               gemeinsame Zeile bei zwei leeren Listen, sonst die halbe Zeile der leeren Hälfte,
               keine Zeile bei zwei gefüllten. Zwei getrennte Bedingungen ließen eine frische
               Karte zweimal sagen, dass sie leer ist.
               Die Zeile spricht über beide Hälften und steht deshalb außerhalb beider — innerhalb
               der Sektion wäre sie ein drittes Flex-Element neben ihnen. Und sie steht dort, wo
               die fehlenden Listen stünden: in beiden Hälften kommt die Liste vor der
               Eingabezeile. *@
            @if (!HatAnhaenge && !HatDateiverweise)
            {
                <p class="blattleerstand" id="leerstand-beide-haelften">
                    Keine Anhänge, keine Dateiverweise ·
                    @* Ein label und kein Knopf: „for" öffnet denselben Dateiwähler wie die Fläche
                       in der linken Hälfte, ohne einen zweiten Weg dorthin zu bauen. *@
                    <label class="blatthandlung" id="anhang-hinzufuegen" for="anhang-datei">hinzufügen</label>
                </p>
            }
            else if (!HatAnhaenge)
            {
                <p class="blattleerstand" id="anhang-leerstand">
                    Keine Anhänge ·
                    <label class="blatthandlung" id="anhang-hinzufuegen" for="anhang-datei">hinzufügen</label>
                </p>
            }
            else if (!HatDateiverweise)
            {
                <p class="blattleerstand" id="dateiverweis-leerstand">
                    Keine Dateiverweise ·
                    <button type="button" class="blatthandlung" id="dateiverweis-eintragen" @onclick="FokussiereDateiverweisfeld">eintragen</button>
                </p>
            }

            <div class="blattzweispalter" id="anhaengeUndVerweise">
                <section class="blatthalbabschnitt" id="anhangabschnitt">
                    <h3 class="blattueberschrift">Anhänge</h3>

                    @if (HatAnhaenge)
                    {
                        <div class="anhangliste" id="anhangliste">
                            @* @key hält die Elementkennung über die Neuaufbauten hinweg fest: nach
                               jedem Anhängen und Entfernen kommt die ganze Liste neu. *@
                            @foreach (var anhang in _detail.Anhaenge)
                            {
                                <div class="anhang" @key="anhang.AnhangId" data-anhang="@anhang.AnhangId" title="@Anhangmeta(anhang)">
                                    <svg class="bueroklammer" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 11.5 11 20.5a5 5 0 0 1-7-7l9-9a3.5 3.5 0 0 1 5 5l-9 9a2 2 0 0 1-3-3l8.5-8.5"></path></svg>
                                    <span class="anhangname">@anhang.Dateiname</span>
                                    <span class="anhanggroesse">@Dateigroesseform.AlsText(anhang.Dateigroesse)</span>
                                    @* Der Verweis zeigt **direkt auf die WebApi** und nicht auf eine
                                       Blazor-Route: sonst flössen die Bytes zweimal über das Netz
                                       und der Browser bekäme keinen echten Download. *@
                                    <a class="anhangladen"
                                       href="@Anhangadresse.Fuer(Anhangbasis.Adresse, KarteId, anhang.AnhangId)"
                                       title="@anhang.Dateiname herunterladen">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11"></path><path d="m7 11 5 5 5-5"></path><path d="M5 20h14"></path></svg>
                                    </a>
                                    <button type="button" class="anhang-entfernen" title="@anhang.Dateiname entfernen" @onclick="() => EntferneAnhang(anhang)">✕</button>
                                </div>
                            }
                        </div>
                    }

                    @* Die Fläche ist ein label um das Dateifeld: ein Klick öffnet den Dateiwähler,
                       und eine Datei, die darauf fällt, landet im selben Feld. Gesperrt ist sie
                       ohne gewählte Identität und während ein Anhängen läuft; was sie dann sagt,
                       rechnet Ablegeflaechenstand. *@
                    <label class="ablegeflaeche @Ablegesperre @Ablegelauf" id="anhang-ablegeflaeche">
                        <span class="ablegetext">@Ablegetext</span>
                        <InputFile class="ablegefeld" id="anhang-datei" OnChange="NimmDatei" disabled="@AblegeflaecheIstGesperrt" />
                    </label>

                    @if (Ablegehinweis is not null)
                    {
                        <p class="anhanghinweis" id="anhang-hinweis">@Ablegehinweis</p>
                    }
                </section>

                <section class="blatthalbabschnitt" id="dateiverweisabschnitt">
                    <h3 class="blattueberschrift">Dateiverweise</h3>

                    @if (HatDateiverweise)
                    {
                        <div class="dateiverweisliste" id="dateiverweisliste">
                            @* @key hält die Elementkennung über die Neuaufbauten hinweg fest: nach
                               jedem Eintragen und Entfernen kommt die ganze Liste neu. *@
                            @foreach (var dateiverweis in _detail.Dateiverweise)
                            {
                                <div class="dateiverweis" @key="dateiverweis.DateiverweisId" data-dateiverweis="@dateiverweis.DateiverweisId" title="@Dateiverweismeta(dateiverweis)">
                                    <span class="dateiverweispfad" id="@Pfadelement(dateiverweis)">@dateiverweis.Pfad</span>
                                    @if (WurdeKopiert(dateiverweis))
                                    {
                                        <span class="dateiverweisrueckmeldung" data-rueckmeldung="@dateiverweis.DateiverweisId">@Kopiermeldung</span>
                                    }
                                    @* Vierte bewusste Abweichung vom Artboard: das `↗` ist dort ein
                                       `<span>`, steht aber in der Akzentfarbe genau an der Stelle, an
                                       der die Anhangzeile daneben ihre Handlung trägt — eine Zierde
                                       dort führte in die Irre. Es **navigiert nicht**, und das ist
                                       keine Sparsamkeit: ein Repository-Pfad ist keine URL, der
                                       Server weiß nicht, wo welcher Klon liegt, und ein
                                       `file://`-Ziel lässt sich aus einer über HTTP ausgelieferten
                                       Seite nicht öffnen. Kopieren ist dagegen genau das, was mit
                                       einem Pfad geschieht. *@
                                    <button type="button" class="dateiverweiskopie" title="Pfad kopieren" @onclick="() => KopierePfad(dateiverweis)">↗</button>
                                    <button type="button" class="dateiverweis-entfernen" title="@dateiverweis.Pfad entfernen" @onclick="() => EntferneDateiverweis(dateiverweis)">✕</button>
                                </div>
                            }
                        </div>
                    }

                    @* Den Text des Feldes führt das Feld selbst, nicht der Server: kein value.
                       Dieselbe Bauform wie das Teilaufgaben-, das Etiketten- und das Kommentarfeld.
                       Abgeschickt wird mit der **Eingabetaste**; das Artboard zeichnet keinen Knopf,
                       und ein zweiter Weg wäre einer mehr als gezeichnet. *@
                    <input class="input dateiverweisfeld"
                           id="dateiverweis-eingabe"
                           @ref="_dateiverweisfeld"
                           placeholder="Pfad im Repository eintragen"
                           disabled="@(_urheber is null)"
                           @oninput="TippeDateiverweis"
                           @onkeydown="AufDateiverweistaste" />

                    @* Ohne gewählte Identität wird nichts eingetragen: ein Dateiverweis ohne Urheber
                       ist keiner. Gesperrt ist allein diese eine Handlung — die bestehenden Zeilen
                       bleiben sichtbar, Board und Kartenseite im Übrigen bedienbar. Dasselbe Muster
                       wie an der Ablegefläche daneben. *@
                    @if (_urheber is null)
                    {
                        <p class="dateiverweishinweis" id="dateiverweis-hinweis">Wähle oben in der Kopfzeile, wer du bist, um einen Pfad einzutragen.</p>
                    }
                </section>
            </div>
        </div>

        <aside class="eigenschaftenblatt" id="eigenschaftenblatt">
            <h3 class="blattueberschrift">Eigenschaften</h3>

            @* Die Wahl steht als eigene Komponente daneben, wie die Identitätswahl neben der
               Kopfzeile: sie führt ihren eigenen Zustand (offen, Suchtext, geladene Liste) und
               meldet nach oben nur, wen die Karte tragen soll. *@
            <Verantwortlichenwahl Verantwortlicher="_detail.Verantwortlicher"
                                  Gewaehlt="SetzeVerantwortlichen"
                                  AusfallGemeldet="MeldeAusfall" />

            <div class="blattfeld">
                <label class="blattmarke" for="faellig-feld">Fällig</label>
                @if (IstOffen(Faelligkeitsfeld))
                {
                    <input type="date" class="input blattwert" id="faellig-feld" value="@Terminwert" @onchange="SetzeFaelligkeit" />
                }
                else
                {
                    <button type="button" class="blattwert" id="faellig" @onclick="() => Oeffne(Faelligkeitsfeld)">@Terminformatierer.AlsText(_detail.Karte.FaelligAm)</button>
                }
            </div>

            @* Die Klasse steht neben Fälligkeit und Verantwortlichem und speichert wie sie
               sofort: ein eigener Speicherknopf für **ein** Feld wäre ein Bruch mit den
               Nachbarn. Die Liste kommt über die eigene Route des Boards — das Kartendetail
               wächst nicht um eine siebte Liste. Ein Board ohne Klasse bekommt denselben Satz
               wie der Klassenbereich im Layout-Modus, kein leeres Auswahlfeld. *@
            <div class="blattfeld">
                <label class="blattmarke" for="klasse-feld">Klasse</label>
                @if (_kartenklassen.Count == 0)
                {
                    <p class="klassenleerzustand" id="keine-klassen">Dieses Board hat keine Klasse.</p>
                }
                else
                {
                    <select class="input blattwert" id="klasse-feld" @bind:get="Klassenwert" @bind:set="UebernimmKartenklasse">
                        <option value="">ohne Klasse</option>
                        @foreach (var kartenklasse in _kartenklassen)
                        {
                            <option value="@kartenklasse.KartenklasseId">@kartenklasse.Praefix @kartenklasse.Name</option>
                        }
                    </select>
                    @if (_detail.Kartenklasse is null)
                    {
                        <p class="klassenhinweis" id="klasse-hinweis">Vergibt beim Speichern <span class="klassennummer">@NaechsteNummer</span> — die nächste Nummer der Klasse @ErsteKartenklasse.Name</p>
                    }
                    else
                    {
                        <p class="klassenhinweis" id="klasse-hinweis">Trägt <span class="tag tag-neutral" id="klasse-nummer">@_detail.Karte.Kartennummer</span></p>
                    }
                }
            </div>

            @* Der Zeitenblock steht unter „Klasse und Nummer", wo D0004.dc.html den gestrichelten
               Kasten „Zeiten und Timer" schon freihält. Die Reihenfolge ist die des Artboards:
               erst die Handlung, dann die Bilanz, dann die Belege. Der Nachtrag am Fuß und der
               Stift an abgeschlossenen Zeilen gehören I0025 und fehlen hier — eine Handlung, die
               nichts tut, wäre schlechter als keine.
               **Gerechnet wird an genau einer Stelle:** ein Aufruf liefert Kontributorensummen
               und Gesamtsumme. Der Knopf trägt **keine gerenderte Dauer** („Stoppen" statt des
               gezeichneten „Stoppen 1:36"): ohne Live-Kanal wäre sie ab der ersten Sekunde
               falsch — und aus demselben Grund steht in der laufenden Zeile „läuft" statt einer
               Dauer, und die laufende Messung zählt nicht in die Summe. *@
            <div class="blattfeld zeitenfeld" id="zeitenabschnitt">
                @{
                    var zeitbilanz = Zeitbilanz.Fuer(_detail.Zeiteintraege);
                }
                <span class="blattmarke">Zeiten</span>
                <div class="zeitenhandlung">
                    @if (LaufenderEigenerZeiteintrag is not null)
                    {
                        <button type="button" class="btn btn-haupt zeitenknopf" id="timer-stoppen" @onclick="StoppeTimer">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true"><rect x="6" y="6" width="12" height="12" rx="2"></rect></svg>
                            Stoppen
                            <span class="zeitenlauf" id="zeiten-laeuft">läuft seit @Zeitpunktform.AlsTageszeit(LaufenderEigenerZeiteintrag.Beginn)</span>
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-haupt zeitenknopf" id="timer-starten" @onclick="StarteTimer">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true"><path d="M8 5.5 18 12 8 18.5z"></path></svg>
                            Timer starten
                        </button>
                    }

                    @* „Ist 1:22" — ohne das gezeichnete „von 5:00 Soll": eine Sollzeit gibt es im
                       Bestand nirgends, sie gehört I0033 und braucht dort ihre eigene Quelle. *@
                    @if (HatZeiteintraege)
                    {
                        <span class="zeitenist" id="zeiten-ist">Ist <span class="zeitenistwert">@Dauerform.AlsText(zeitbilanz.Gesamtsumme)</span></span>
                    }
                </div>

                @* Ohne gewählte Identität wird nicht gemeckert, sondern gefragt: „nicht gewählt"
                   ist keine Regelverletzung, sondern eine fehlende Angabe — und die Wahl ist die
                   Kompensationsaktion. Nach der Wahl läuft der Timer unmittelbar. *@
                @if (_identitaetswahlIstOffen)
                {
                    <div class="identitaets-auffangflaeche" id="zeiten-identitaet-auffangflaeche" @onclick="SchliesseIdentitaetswahl"></div>
                    @* tabindex="-1": ein Klick im Popover setzt den Fokus damit auf das Popover
                       statt auf den Rumpf — sonst liefe Escape danach ins Leere. *@
                    <div class="identitaetspopover" id="zeiten-identitaetspopover" tabindex="-1" @onkeydown="AufIdentitaetstaste">
                        <p class="identitaetspopover-titel">Ich bin …</p>
                        <Identitaetswahl Kontributoren="_kontributoren"
                                         GewaehlteKontributorId="_urheber?.KontributorId"
                                         Gewaehlt="UebernimmIdentitaetUndStarte" />
                    </div>
                }

                @* Ein Satz statt einer Tabelle voller Nullen: die Summen entstehen mit dem ersten
                   Eintrag. Anders als bei Kommentaren und Anhängen hängt keine Handlung daran —
                   die Handlung dieses Blocks ist der Startknopf, der ohnehin darüber steht. *@
                @if (!HatZeiteintraege)
                {
                    <p class="zeitenleerstand" id="zeiten-leerstand">Noch keine Zeit erfasst.</p>
                }
                else
                {
                    @if (zeitbilanz.Kontributorensummen.Count > 0)
                    {
                        <div class="zeitensummen" id="zeitensummen">
                            @foreach (var zeile in zeitbilanz.Kontributorensummen)
                            {
                                <div class="zeitensumme" @key="zeile.Kontributor.KontributorId" data-zeitensumme="@zeile.Kontributor.KontributorId">
                                    <span class="kuerzel @Kontributorartform.Kuerzelklasse(zeile.Kontributor.Art)" title="@Kontributorartform.Beschriftung(zeile.Kontributor.Art)">@Kontributorartform.Kuerzel(zeile.Kontributor.Name)</span>
                                    <span class="zeitensummename">@zeile.Kontributor.Name</span>
                                    <span class="zeitensummewert">@Summentext(zeile)</span>
                                </div>
                            }
                        </div>
                    }

                    @* Flach und chronologisch, neueste zuerst — nicht nach Kontributor gruppiert:
                       die Gruppierung leistet die Bilanz darüber, und erst die Zeitfolge macht
                       eine Überlappung lesbar. *@
                    <div class="zeiteneintraege">
                        <div class="zeiteneintraegekopf">
                            <span class="zeiteneintraegemarke">Einträge</span>
                            <span class="zeitenzahl" id="zeitenzahl">@Zeiteintragszahl</span>
                        </div>
                        <div class="zeiteneintragsliste" id="zeiteneintragsliste">
                            @foreach (var eintrag in ZeiteintraegeNeuesteZuerst)
                            {
                                <div class="@Zeilenklasse(eintrag)" @key="eintrag.ZeiteintragId" data-zeiteintrag="@eintrag.ZeiteintragId">
                                    @* Der Titel nennt hier den **Namen** und nicht die Art wie in der
                                       Bilanz darüber: die Summenzeile schreibt den Namen daneben und
                                       kann die Art ergänzen, die schmale Eintragszeile schreibt ihn
                                       nicht — dort wäre die Art die Auskunft, die schon fehlt. *@
                                    <span class="kuerzel @Kontributorartform.Kuerzelklasse(eintrag.Kontributor.Art)" title="@eintrag.Kontributor.Name">@Kontributorartform.Kuerzel(eintrag.Kontributor.Name)</span>
                                    <span class="zeiteneintragspanne">@Zeitpunktform.AlsZeitraum(eintrag.Beginn, eintrag.Ende, DateTimeOffset.Now)</span>
                                    @if (eintrag.Ende is not null)
                                    {
                                        <span class="zeiteneintragsdauer">@Dauerform.AlsText(eintrag.Ende.Value - eintrag.Beginn)</span>
                                    }
                                    else
                                    {
                                        @* Das Quadrat steht an **jeder** laufenden Zeile, auch an
                                           der eines fremden Kontributors und auch ohne gewählte
                                           Identität: ein Agenten-Timer, der über Nacht
                                           weiterläuft, muss von jemandem beendet werden können.
                                           Gestoppt wird der Timer, nicht die Urheberschaft. *@
                                        <button type="button" class="zeiteneintragstopp" title="Timer von @eintrag.Kontributor.Name stoppen" @onclick="() => StoppeZeile(eintrag)">
                                            <svg width="9" height="9" viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true"><rect x="6" y="6" width="12" height="12" rx="2"></rect></svg>
                                        </button>
                                    }
                                    @* Der Stift öffnet die Zeile an Ort und Stelle. Er steht auch
                                       an einer laufenden Zeile: ein zu früh gestarteter Timer
                                       muss korrigierbar sein, ohne ihn erst zu stoppen. *@
                                    <button type="button" class="zeiteneintragstift" id="zeiteneintrag-stift-@eintrag.ZeiteintragId" title="Eintrag von @eintrag.Kontributor.Name ändern" @onclick="() => OeffneZeiteintrag(eintrag)">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20h4L19 9a2.1 2.1 0 0 0-3-3L5 17z"></path></svg>
                                    </button>
                                </div>
                                @if (_offeneZeiteintragId == eintrag.ZeiteintragId)
                                {
                                    @* Ein eigener Schlüssel je Zeile, verschieden von dem der
                                       Zeile selbst: zwei Geschwister dürfen nicht denselben
                                       tragen. Er sorgt dafür, dass das Formular beim Wechsel der
                                       Zeile neu vorbelegt wird. *@
                                    <Zeiteintragsformular @key="@($"zeitenaenderung-{eintrag.ZeiteintragId}")"
                                                          Kennung="zeitenaenderung"
                                                          Kontributoren="_kontributoren"
                                                          VorbelegterKontributor="eintrag.Kontributor.KontributorId"
                                                          MitTag="false"
                                                          VorbelegterTag="Zeitpunktform.AlsTag(eintrag.Beginn)"
                                                          VorbelegtesVon="Zeitpunktform.AlsUhrzeit(eintrag.Beginn)"
                                                          VorbelegtesBis="Zeitpunktform.AlsUhrzeit(eintrag.Ende)"
                                                          EndeIstPflicht="false"
                                                          MitLoeschen="true"
                                                          Bestaetigungsbeschriftung="Sichern"
                                                          Abbruchbeschriftung="Verwerfen"
                                                          Zurueckweisung="_zeitenzurueckweisung"
                                                          Bestaetigt="eingabe => AendereZeiteintrag(eintrag, eingabe)"
                                                          Abgebrochen="SchliesseZeitenformulare"
                                                          Geloescht="() => LoescheZeiteintrag(eintrag)" />
                                }
                            }
                        </div>
                    </div>
                }

                @* Der Nachtrag steht am Fuß und **außerhalb** des Leerzustands: auf einer Karte
                   ohne gemessene Zeit ist er der einzige Weg hinein. *@
                <div class="zeitennachtrag" id="zeitennachtragsbereich">
                    @if (_nachtragIstOffen)
                    {
                        <Zeiteintragsformular Kennung="zeitennachtrag"
                                              Kontributoren="_kontributoren"
                                              VorbelegterKontributor="_urheber?.KontributorId"
                                              MitTag="true"
                                              VorbelegterTag="Zeitpunktform.AlsTag(DateTimeOffset.Now)"
                                              EndeIstPflicht="true"
                                              MitLoeschen="false"
                                              Bestaetigungsbeschriftung="Nachtragen"
                                              Abbruchbeschriftung="Abbrechen"
                                              Zurueckweisung="_zeitenzurueckweisung"
                                              Bestaetigt="TrageZeitNach"
                                              Abgebrochen="SchliesseZeitenformulare" />
                    }
                    else
                    {
                        <button type="button" class="zeitennachtragknopf" id="zeiten-nachtragen-oeffnen" @onclick="OeffneNachtrag">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
                            Zeit nachtragen
                        </button>
                    }
                </div>
            </div>

            @* Das Feld ist ein Textfeld mit Marken davor, kein Auswahlfeld: ein Etikett ist eine
               freie Textmarke, und was noch niemand vergeben hat, entsteht mit der ersten Karte,
               die es trägt. *@
            <div class="blattfeld etikettenfeld">
                <label class="blattmarke" for="etikett-eingabe">Etiketten</label>
                <div class="etikettenzeile" id="etikettenzeile">
                    @foreach (var etikett in _detail.Etiketten)
                    {
                        <span class="etikett" data-etikett="@etikett">
                            @etikett
                            <button type="button" class="etikett-entfernen" title="@etikett entfernen" @onclick="() => EntferneEtikett(etikett)">✕</button>
                        </span>
                    }
                    @* Den Text des Feldes führt das Feld selbst, nicht der Server: kein value.
                       Jedes Zeichen läuft über die Leitung, und trüge das Feld den
                       serverseitigen Stand als value, schriebe jede zurückkommende Renderrunde
                       den Stand von vorhin über das, was inzwischen getippt wurde — wer schnell
                       tippt, verliert dann Zeichen. Geleert wird es deshalb einmal und gezielt,
                       wenn ein Etikett angenommen ist. *@
                    <input class="etikett-eingabe"
                           id="etikett-eingabe"
                           @ref="_etikettfeld"
                           placeholder="+ Etikett"
                           @oninput="TippeEtikett"
                           @onkeydown="AufEtikettentaste" />
                </div>

                @if (_etikettentext.Length > 0)
                {
                    <div class="etikettenvorschlaege" id="etikettenvorschlaege">
                        @if (Etikettvorschlaege.Count > 0)
                        {
                            <p class="etikettenabschnitt">auf diesem Board schon vergeben</p>
                            @* @key haelt die Elementkennung ueber die Neuaufbauten hinweg fest: die
                               Liste wird bei jedem Tastendruck neu gerechnet, und ohne Schluessel
                               ordnet Blazor die Knoten neu zu, sobald sich ihre Zahl aendert — ein
                               Klick landete dann auf einem Element, das es so nicht mehr gibt. *@
                            @foreach (var vorschlag in Etikettvorschlaege)
                            {
                                <button type="button"
                                        @key="vorschlag.Text"
                                        class="etikettenvorschlag"
                                        data-vorschlag="@vorschlag.Text"
                                        @onclick="() => FuegeEtikettHinzu(vorschlag.Text)">
                                    @vorschlag.Text
                                    <span class="etikettenzahl">@Etikettenwahl.Kartenzahltext(vorschlag.Kartenzahl)</span>
                                </button>
                            }
                        }
                        @if (EtikettentextIstNeu)
                        {
                            <button type="button" @key="Neuanlagenschluessel" class="etikettenvorschlag etikettenvorschlag-neu" id="etikett-neu-anlegen" @onclick="() => FuegeEtikettHinzu(_etikettentext)">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
                                „@_etikettentext.Trim()“ neu anlegen
                            </button>
                        }
                    </div>
                }
            </div>

            @* Die fünf Punkte stehen immer offen: eine Farbe ist eine Wahl mit einem Klick, kein
               Feld, das man erst aufschlägt. *@
            <div class="blattfeld">
                <span class="blattmarke">Farbe der Karte</span>
                <div class="farbpunkte" id="farbpunkte">
                    @foreach (var farbe in Kartenfarbform.Alle)
                    {
                        <button type="button"
                                class="farbpunkt @Kartenfarbform.Punktklasse(farbe) @Gewaehltklasse(farbe)"
                                id="farbpunkt-@farbe"
                                title="@Kartenfarbform.Beschriftung(farbe)"
                                aria-pressed="@AlsAttributtext(farbe == _detail.Karte.Farbe)"
                                @onclick="() => SetzeFarbe(farbe)"></button>
                    }
                </div>
            </div>
        </aside>
    </div>
}

@code {
    private const string Titelfeld = "titel";
    private const string Beschreibungsfeld = "beschreibung";
    private const string Faelligkeitsfeld = "faellig";

    // Vollqualifiziert, weil der Komponentenname Kartendetail den gleichnamigen Vertragstyp
    // verdeckt — dieselbe Lage wie bei Board.razor und Karte.razor.
    private KanbanC.Contracts.Karten.Kartendetail? _detail;
    private bool _ladenIstAbgeschlossen;
    private bool _webApiIstNichtErreichbar;

    // Höchstens ein Feld steht offen; welches, sagt sein Name. Ein Wahrheitswert je Feld wäre
    // dieselbe Aussage mehrfach und ließe zwei offene Felder zu.
    private string? _offenesFeld;
    private Zurueckweisung? _zurueckweisung;
    private string _etikettentext = string.Empty;
    private string? _ausfallmeldung;

    // Das Etikettenfeld wird im Browser geleert, nicht über ein value-Attribut: so bleibt es
    // dasselbe Feld, der Cursor steht danach weiter darin, und keine Renderrunde fasst den Text
    // an, während getippt wird. Object.assign setzt die value-Eigenschaft des Elements — derselbe
    // Weg über einen Browser-Standardbefehl, den auch der Identitätsspeicher geht.
    private const string ElementEigenschaftenSetzen = "Object.assign";
    private ElementReference _etikettfeld;

    [Parameter]
    public long KarteId { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        _ladenIstAbgeschlossen = false;
        try
        {
            await LadeKartendetail();
            await LadeKartenklassen();
            await LadeUrheber();
            _webApiIstNichtErreichbar = false;
        }
        catch (HttpRequestException)
        {
            _webApiIstNichtErreichbar = true;
        }

        _ladenIstAbgeschlossen = true;
    }

    private IReadOnlyList<Kartenklasse> _kartenklassen = [];

    // Die Klassenliste des Boards kommt über die Route aus R00022 und nicht über das
    // Kartendetail: für sie gibt es seit dort eine eigene Adresse.
    private async Task LadeKartenklassen()
    {
        var dasBoardIstNochUnbekannt = _detail is null;
        if (dasBoardIstNochUnbekannt)
        {
            _kartenklassen = [];
            return;
        }

        var ergebnis = await KartenklassenKlient.LadeKartenklassen(_detail!.Board);
        if (ergebnis.WurdeZurueckgewiesen)
        {
            // Ohne die Meldung sähe die abgewiesene Liste aus wie ein Board ohne Klasse — die
            // Seite behauptete dann etwas, das sie nicht weiß.
            _kartenklassen = [];
            _zurueckweisung = ergebnis.Zurueckweisung;
            return;
        }

        _kartenklassen = ergebnis.Wert;
    }

    // Der leere Wert ist „ohne Klasse" — derselbe Eintrag, den die Liste zeigt.
    private string Klassenwert
    {
        get
        {
            if (_detail!.Kartenklasse is null)
            {
                return string.Empty;
            }

            return _detail.Kartenklasse.KartenklasseId.ToString(CultureInfo.InvariantCulture);
        }
    }

    // Solange die Karte keine Klasse trägt, nennt die Zeile die Nummer, die die **erste** Klasse
    // der Liste als nächste vergibt — und sagt dazu, welche das ist: auf einem Board mit mehreren
    // Klassen wäre eine Nummer ohne ihren Namen ein Versprechen, das die Wahl daneben nicht hält.
    private Kartenklasse ErsteKartenklasse
    {
        get
        {
            return _kartenklassen[0];
        }
    }

    private string NaechsteNummer
    {
        get
        {
            return Kartennummer.Aus(ErsteKartenklasse.Praefix, ErsteKartenklasse.Zaehlerstand + 1);
        }
    }

    private async Task UebernimmKartenklasse(string wert)
    {
        _zurueckweisung = null;
        _ausfallmeldung = await WebApiAufruf.MitAusfallmeldung(() => OrdneKartenklasseZu(new KartenklasseZuordnenAnfrage(KartenklasseAus(wert))));
    }

    private static long? KartenklasseAus(string wert)
    {
        var ohneKlasseWurdeGewaehlt = wert.Length == 0;
        if (ohneKlasseWurdeGewaehlt)
        {
            return null;
        }

        return long.Parse(wert, CultureInfo.InvariantCulture);
    }

    // Nach der Zuordnung wird die Klassenliste neu geholt: ihr Zählerstand ist gerade gewachsen,
    // und die Hinweiszeile nennt sonst eine Nummer, die es schon gibt.
    private async Task OrdneKartenklasseZu(KartenklasseZuordnenAnfrage anfrage)
    {
        var ergebnis = await KartenKlient.OrdneKartenklasseZu(KarteId, anfrage);
        if (ergebnis.WurdeZurueckgewiesen)
        {
            _zurueckweisung = ergebnis.Zurueckweisung;
            return;
        }

        _detail = ergebnis.Wert;
        await LadeKartenklassen();
    }

    private async Task SetzeVerantwortlichen(long? kontributorId)
    {
        await Speichere(_detail! with { Karte = _detail.Karte with { Kontributor = kontributorId } });
    }

    // Die Wahl holt ihre Liste selbst; ein Ausfall dabei gehört trotzdem hierher, damit die
    // Seite eine Meldungsstelle behält.
    private void MeldeAusfall(string? meldung)
    {
        _ausfallmeldung = meldung;
    }

    private IReadOnlyList<Etikettvorschlag> Etikettvorschlaege
    {
        get
        {
            return Etikettenwahl.Vorschlaege(_detail!.Etikettvorschlaege, _detail.Etiketten, _etikettentext);
        }
    }

    private bool EtikettentextIstNeu
    {
        get
        {
            return Etikettenwahl.LaesstSichNeuAnlegen(_detail!.Etikettvorschlaege, _detail.Etiketten, _etikettentext);
        }
    }

    // Ein Schluessel, der sich nicht mit dem getippten Text aendert: der Eintrag „… neu anlegen"
    // bleibt derselbe Knopf, waehrend seine Beschriftung mitwaechst.
    private const string Neuanlagenschluessel = "etikett-neu-anlegen";

