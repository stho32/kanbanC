@page "/karten/{KarteId:long}"
@using System.Globalization
@using KanbanC.Blazor.Components.Karten
@using KanbanC.Blazor.Services
@using KanbanC.Contracts.Fehler
@using KanbanC.Contracts.Karten
@using KanbanC.Contracts.Kontributoren
@using Microsoft.AspNetCore.Components.Forms
@inject KartenApiKlient KartenKlient
@inject KontributorenApiKlient KontributorenKlient
@inject Identitaetsspeicher Identitaetsspeicher
@inject Anhangbasisadresse Anhangbasis
@inject IJSRuntime Browser

<PageTitle>Karte @KarteId</PageTitle>

@if (_webApiIstNichtErreichbar)
{
    <div class="meldung" role="alert" id="fehlermeldung">
        <p>@WebApiAusfall.Meldung</p>
        <a href="/boards" id="zur-board-liste">Zurück zur Board-Liste</a>
    </div>
}
else if (!_ladenIstAbgeschlossen)
{
    <p>Die Karte wird geladen …</p>
}
else if (_detail is null)
{
    @* Wortgleich zu Board.razor, nur mit „Karte". Der Rückweg führt zur Board-Liste und nicht
       zum Board: zu einer Kartennummer, die es nicht gibt, gehört kein Board — eine geratene
       Nummer im Verweis wäre dieselbe Falschaussage, die der Befund der API vermeidet. *@
    <div class="meldung" role="alert" id="karte-unbekannt">
        <p>Eine Karte mit der Nummer @KarteId gibt es nicht.</p>
        <a href="/boards" id="zur-board-liste">Zurück zur Board-Liste</a>
    </div>
}
else
{
    @* Zone 1 trägt die offene Seite: der Pfeil führt zum Board zurück, die Überschrift nennt es.
       Der Kartentitel steht nicht hier, sondern als Überschrift im Blatt — dort wird er auch
       geändert. *@
    <SectionContent SectionName="kopfzeile-kontext">
        <a href="/boards/@_detail.Board" id="karte-zurueck" class="karte-zurueck" title="Zurück zum Board">←</a>
        <h1 id="karte-boardname" class="karte-boardname">@_detail.Boardname</h1>
        <span class="tag tag-neutral" id="karte-plakette">Karte @KarteId</span>
        <span class="karte-spalte" id="karte-spalte">Spalte @_detail.Spaltenbezeichnung</span>
    </SectionContent>

    <nav class="brotkrumen" id="brotkrumen" aria-label="Brotkrumen">
        <a href="/boards">Boards</a>
        <span aria-hidden="true">/</span>
        <a href="/boards/@_detail.Board">@_detail.Boardname</a>
        <span aria-hidden="true">/</span>
        <span class="brotkrume-hier">Karte @KarteId</span>
    </nav>

    @if (_zurueckweisung is not null)
    {
        <div class="meldung meldung-abweisung" role="alert" id="kartenblatt-zurueckweisung">
            <ul>
                @foreach (var befund in _zurueckweisung.Befunde)
                {
                    <li>@befund.Meldung</li>
                }
            </ul>
        </div>
    }
    @if (_ausfallmeldung is not null)
    {
        <div class="meldung" role="alert" id="kartenblatt-fehlermeldung">@_ausfallmeldung</div>
    }

    @* Das Blatt liest die Identitätswahl neu, sobald jemand es betritt — mit dem Zeiger oder mit
       der Tabulatortaste. Die Kopfzeile ist eine eigene Komponente und lässt diese Seite beim
       Wechseln der Identität nicht neu zeichnen; ohne dieses Nachlesen bliebe „senden" gesperrt,
       bis die Seite neu geladen wird. Der Anlass sitzt am **Blatt** und nicht an der
       Schreibzeile: ein gesperrter Knopf nimmt keine Zeigerereignisse an, und die Sperre hielte
       sich dann selbst fest. Die Kapselung der Kopfzeile bleibt unangetastet. *@
    <div class="kartenblatt" @onmouseenter="LiesUrheberNach" @onfocusin="LiesUrheberNach">
        <div class="karteninhalt">
            @* Der Titel steht dort, wo man ihn liest, und wird an derselben Stelle geändert.
               Nach einer Zurückweisung schließt das Feld wieder — so bleibt die vorige Fassung
               sichtbar stehen, statt hinter der abgewiesenen Eingabe zu verschwinden. *@
            @if (IstOffen(Titelfeld))
            {
                <input class="kartenueberschrift kartenueberschrift-feld"
                       id="titel-feld"
                       value="@_detail.Karte.Titel"
                       autofocus
                       @onchange="SetzeTitel" />
            }
            else
            {
                <div class="ueberschriftzeile">
                    <h2 class="kartenueberschrift" id="kartenueberschrift">@_detail.Karte.Titel</h2>
                    <button type="button" class="btn btn-schlicht btn-symbol blattstift" id="titel-bearbeiten" title="Titel ändern" @onclick="() => Oeffne(Titelfeld)">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20h4l10-10-4-4L4 16z"></path><path d="m14 6 4 4"></path></svg>
                    </button>
                </div>
            }

            <section class="blattabschnitt">
                <h3 class="blattueberschrift">Beschreibung</h3>
                @if (IstOffen(Beschreibungsfeld))
                {
                    <textarea class="input beschreibungsfeld" id="beschreibung-feld" rows="5" @onchange="SetzeBeschreibung">@_detail.Karte.Beschreibung</textarea>
                }
                else if (string.IsNullOrEmpty(_detail.Karte.Beschreibung))
                {
                    @* Leere Felder tragen die Handlung als Text, keinen leeren Kasten. *@
                    <button type="button" class="blatthandlung" id="beschreibung-hinzufuegen" @onclick="() => Oeffne(Beschreibungsfeld)">Beschreibung hinzufügen</button>
                }
                else
                {
                    <p class="beschreibung" id="beschreibung" @onclick="() => Oeffne(Beschreibungsfeld)">@_detail.Karte.Beschreibung</p>
                }
            </section>

            @* Der Abschnitt heißt „Teilaufgaben" und nicht „Subtasks": eine bewusste Abweichung
               vom Artboard, das hier als einzigen Abschnittstitel ein englisches Wort trägt.
               Die gebaute Oberfläche ist durchgehend deutsch, und C06 verbietet zwei Namen für
               dasselbe Ding. Alles andere folgt der Skizze. *@
            <section class="blattabschnitt" id="teilaufgabenabschnitt">
                <div class="teilaufgabenkopf">
                    <h3 class="blattueberschrift">Teilaufgaben</h3>
                    @* Fortschritt und Balken bleiben fort, solange nichts zu zählen ist: „0 von 0"
                       wäre eine Aussage über nichts. *@
                    @if (HatTeilaufgaben)
                    {
                        <span class="teilaufgabenstand" id="teilaufgabenstand">@Teilaufgabenfortschritt.AlsText(_detail.Teilaufgaben)</span>
                        <span class="teilaufgabenbalken"
                              id="teilaufgabenbalken"
                              role="progressbar"
                              aria-valuemin="0"
                              aria-valuemax="100"
                              aria-valuenow="@Balkenanteil">
                            <span class="teilaufgabenbalken-anteil" style="width: @Balkenbreite"></span>
                        </span>
                    }
                </div>

                @if (HatTeilaufgaben)
                {
                    <div class="teilaufgabenliste" id="teilaufgabenliste">
                        @* @key hält die Elementkennung über die Neuaufbauten hinweg fest: nach
                           jedem Abhaken kommt die ganze Liste neu, und ohne Schlüssel ordnete
                           Blazor die Kästchen neu zu. *@
                        @foreach (var teilaufgabe in _detail.Teilaufgaben)
                        {
                            <div class="teilaufgabe @Abhakklasse(teilaufgabe)" @key="teilaufgabe.TeilaufgabeId" data-teilaufgabe="@teilaufgabe.TeilaufgabeId">
                                @* Ein Knopf und keine gezeichnete Fläche mit @onclick: so lässt
                                   sich das Kästchen mit der Tabulatortaste erreichen und mit
                                   Eingabe- oder Leertaste schalten, ohne dass es dafür eigene
                                   Tastenbehandlung bräuchte. aria-pressed sagt den Stand an,
                                   dieselbe Bauform wie die Farbpunkte. *@
                                <button type="button"
                                        class="teilaufgabenkaestchen"
                                        id="teilaufgabe-kaestchen-@teilaufgabe.TeilaufgabeId"
                                        title="@Abhaktitel(teilaufgabe)"
                                        aria-pressed="@AlsAttributtext(teilaufgabe.Abgehakt)"
                                        @onclick="() => SchalteAbhakung(teilaufgabe)">
                                    @if (teilaufgabe.Abgehakt)
                                    {
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="4"></rect><path d="m8 12 3 3 5-6"></path></svg>
                                    }
                                    else
                                    {
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="4"></rect></svg>
                                    }
                                </button>
                                <span class="teilaufgabentext">@teilaufgabe.Text</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    @* Die Handlung statt der Null, wie beim leeren Beschreibungsfeld. „anlegen"
                       setzt den Cursor ins Feld darunter — mehr ist nicht zu tun, es steht
                       ohnehin offen. *@
                    <p class="teilaufgabenleerstand" id="teilaufgaben-leerstand">
                        Keine Teilaufgaben ·
                        <button type="button" class="blatthandlung" id="teilaufgabe-anlegen" @onclick="FokussiereTeilaufgabenfeld">anlegen</button>
                    </p>
                }

                <div class="teilaufgabenzeile">
                    @* Den Text des Feldes führt das Feld selbst, nicht der Server: kein value.
                       Trüge es den serverseitigen Stand, schriebe jede zurückkommende Renderrunde
                       den Stand von vorhin über das, was inzwischen getippt wurde — wer schnell
                       tippt, verlöre Zeichen. Dieselbe Lehre wie beim Etikettenfeld. *@
                    <input class="input teilaufgabenfeld"
                           id="teilaufgabe-eingabe"
                           @ref="_teilaufgabenfeld"
                           placeholder="Teilaufgabe hinzufügen"
                           @oninput="TippeTeilaufgabe"
                           @onkeydown="AufTeilaufgabentaste" />
                    <button type="button" class="btn btn-schlicht btn-symbol" id="teilaufgabe-hinzufuegen" title="Teilaufgabe hinzufügen" @onclick="FuegeTeilaufgabeHinzu">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
                    </button>
                </div>
            </section>

            @* Der Abschnitt steht hinter „Teilaufgaben" in der linken Spalte, wie im Artboard.
               **Eine bewusste Abweichung:** die Metazeile trägt keine „Quelle" (Oberfläche /
               API). Die WebApi sieht in beiden Fällen denselben HTTP-Aufruf — die Oberfläche ist
               selbst nur ein Klient —, und ein Feld, das den Kanal rät, wäre eine stille Lüge.
               Mensch und Agent bleiben trotzdem auseinanderzuhalten: am Kürzel. *@
            <section class="blattabschnitt" id="kommentarabschnitt">
                <div class="kommentarkopf">
                    <h3 class="blattueberschrift">Kommentare</h3>
                    @* Die Anzahl wird gerechnet und nicht mitgesendet — .Count an der gelieferten
                       Liste. Ohne Kommentar bleibt sie fort: eine „0" wäre eine Aussage über
                       nichts, und die Handlung steht schon darunter. *@
                    @if (HatKommentare)
                    {
                        <span class="kommentarzahl" id="kommentarzahl">@Kommentarzahl</span>
                    }
                </div>

                @if (HatKommentare)
                {
                    <div class="kommentarliste" id="kommentarliste">
                        @* @key hält die Elementkennung über die Neuaufbauten hinweg fest: nach
                           jedem Senden kommt die ganze Liste neu. *@
                        @foreach (var kommentar in _detail.Kommentare)
                        {
                            <div class="kommentar" @key="kommentar.KommentarId" data-kommentar="@kommentar.KommentarId">
                                <span class="kuerzel @Kontributorartform.Kuerzelklasse(kommentar.Urheber.Art)" title="@Kontributorartform.Beschriftung(kommentar.Urheber.Art)">@Kontributorartform.Kuerzel(kommentar.Urheber.Name)</span>
                                <div class="kommentarinhalt">
                                    <p class="kommentartext">@kommentar.Text</p>
                                    <p class="kommentarmeta">@Metazeile(kommentar)</p>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    @* Die Handlung statt der Null, wie beim leeren Beschreibungsfeld und bei den
                       Teilaufgaben. „schreiben" setzt den Cursor ins Feld darunter. *@
                    <p class="kommentarleerstand" id="kommentar-leerstand">
                        Noch kein Kommentar ·
                        <button type="button" class="blatthandlung" id="kommentar-schreiben" @onclick="FokussiereKommentarfeld">schreiben</button>
                    </p>
                }

                <div class="kommentarzeile">
                    @if (_urheber is null)
                    {
                        <span class="kuerzel kuerzel-niemand" id="kommentar-kuerzel" title="Niemand gewählt"></span>
                    }
                    else
                    {
                        <span class="kuerzel @Kontributorartform.Kuerzelklasse(_urheber.Art)" id="kommentar-kuerzel" title="@_urheber.Name">@Kontributorartform.Kuerzel(_urheber.Name)</span>
                    }
                    @* Den Text des Feldes führt das Feld selbst, nicht der Server: kein value.
                       Dieselbe Bauform wie das Teilaufgaben- und das Etikettenfeld, und dieselbe
                       Lehre — sonst schriebe jede zurückkommende Renderrunde den Stand von vorhin
                       über das, was inzwischen getippt wurde. *@
                    <input class="input kommentarfeld"
                           id="kommentar-eingabe"
                           @ref="_kommentarfeld"
                           placeholder="Kommentar schreiben"
                           @oninput="TippeKommentar"
                           @onkeydown="AufKommentartaste" />
                    <button type="button"
                            class="btn btn-haupt"
                            id="kommentar-senden"
                            disabled="@(_urheber is null)"
                            title="@Sendetitel"
                            @onclick="SendeKommentar">senden</button>
                </div>

                @* Ohne gewählte Identität wird nicht gesendet: ein Kommentar ohne Absender ist
                   keiner. Gesperrt ist allein diese eine Handlung — Board und Kartenseite bleiben
                   im Übrigen unverändert bedienbar. *@
                @if (_urheber is null)
                {
                    <p class="kommentarhinweis" id="kommentar-hinweis">Wähle oben in der Kopfzeile, wer du bist, um zu kommentieren.</p>
                }
            </section>

            @* Zweispaltige Sektion hinter „Kommentare", wie im Artboard: links die Anhänge, rechts
               die Verweise aus I0019. Die rechte Hälfte bleibt in diesem Slice leer — sie hält den
               Platz, damit die linke die halbe Breite bekommt, die gezeichnet ist.
               **Drei bewusste Abweichungen vom Artboard:** ein `×` am Zeilenende, weil die
               Entfernen-Route gebaut wird und ohne Bedienelement unerreichbar wäre; Urheber und
               Zeitpunkt im title statt als zweite Textzeile, damit die gezeichnete einzeilige Form
               bleibt; und die Leerzeile nennt nur die Anhänge — die gemeinsame Fassung mit den
               Verweisen entsteht mit I0019. *@
            <div class="blattzweispalter" id="anhaengeUndVerweise">
                <section class="blatthalbabschnitt" id="anhangabschnitt">
                    <h3 class="blattueberschrift">Anhänge</h3>

                    @if (HatAnhaenge)
                    {
                        <div class="anhangliste" id="anhangliste">
                            @* @key hält die Elementkennung über die Neuaufbauten hinweg fest: nach
                               jedem Anhängen und Entfernen kommt die ganze Liste neu. *@
                            @foreach (var anhang in _detail.Anhaenge)
                            {
                                <div class="anhang" @key="anhang.AnhangId" data-anhang="@anhang.AnhangId" title="@Anhangmeta(anhang)">
                                    <svg class="bueroklammer" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 11.5 11 20.5a5 5 0 0 1-7-7l9-9a3.5 3.5 0 0 1 5 5l-9 9a2 2 0 0 1-3-3l8.5-8.5"></path></svg>
                                    <span class="anhangname">@anhang.Dateiname</span>
                                    <span class="anhanggroesse">@Dateigroesseform.AlsText(anhang.Dateigroesse)</span>
                                    @* Der Verweis zeigt **direkt auf die WebApi** und nicht auf eine
                                       Blazor-Route: sonst flössen die Bytes zweimal über das Netz
                                       und der Browser bekäme keinen echten Download. *@
                                    <a class="anhangladen"
                                       href="@Anhangadresse.Fuer(Anhangbasis.Adresse, KarteId, anhang.AnhangId)"
                                       title="@anhang.Dateiname herunterladen">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11"></path><path d="m7 11 5 5 5-5"></path><path d="M5 20h14"></path></svg>
                                    </a>
                                    <button type="button" class="anhang-entfernen" title="@anhang.Dateiname entfernen" @onclick="() => EntferneAnhang(anhang)">✕</button>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        @* Die Handlung statt der Null, wie bei den Teilaufgaben und den Kommentaren. *@
                        <p class="anhangleerstand" id="anhang-leerstand">
                            Keine Anhänge ·
                            @* Ein label und kein Knopf: „for" öffnet denselben Dateiwähler wie die
                               Fläche darunter, ohne einen zweiten Weg dorthin zu bauen. *@
                            <label class="blatthandlung" id="anhang-hinzufuegen" for="anhang-datei">hinzufügen</label>
                        </p>
                    }

                    @* Die Fläche ist ein label um das Dateifeld: ein Klick öffnet den Dateiwähler,
                       und eine Datei, die darauf fällt, landet im selben Feld. Ohne gewählte
                       Identität ist das Feld gesperrt — ein Anhang ohne Urheber ist keiner. *@
                    <label class="ablegeflaeche @Ablegesperre" id="anhang-ablegeflaeche">
                        <span class="ablegetext">Datei hierher ziehen oder wählen</span>
                        <InputFile class="ablegefeld" id="anhang-datei" OnChange="NimmDatei" disabled="@(_urheber is null)" />
                    </label>

                    @if (_urheber is null)
                    {
                        <p class="anhanghinweis" id="anhang-hinweis">Wähle oben in der Kopfzeile, wer du bist, um eine Datei anzuhängen.</p>
                    }
                </section>

                @* Die rechte Hälfte gehört I0019 und bleibt leer; sie hält den Platz. *@
                <div class="blatthalbabschnitt" id="verweisplatz" aria-hidden="true"></div>
            </div>
        </div>

        <aside class="eigenschaftenblatt" id="eigenschaftenblatt">
            <h3 class="blattueberschrift">Eigenschaften</h3>

            @* Die Wahl steht als eigene Komponente daneben, wie die Identitätswahl neben der
               Kopfzeile: sie führt ihren eigenen Zustand (offen, Suchtext, geladene Liste) und
               meldet nach oben nur, wen die Karte tragen soll. *@
            <Verantwortlichenwahl Verantwortlicher="_detail.Verantwortlicher"
                                  Gewaehlt="SetzeVerantwortlichen"
                                  AusfallGemeldet="MeldeAusfall" />

            <div class="blattfeld">
                <label class="blattmarke" for="faellig-feld">Fällig</label>
                @if (IstOffen(Faelligkeitsfeld))
                {
                    <input type="date" class="input blattwert" id="faellig-feld" value="@Terminwert" @onchange="SetzeFaelligkeit" />
                }
                else
                {
                    <button type="button" class="blattwert" id="faellig" @onclick="() => Oeffne(Faelligkeitsfeld)">@Terminformatierer.AlsText(_detail.Karte.FaelligAm)</button>
                }
            </div>

            @* Das Feld ist ein Textfeld mit Marken davor, kein Auswahlfeld: ein Etikett ist eine
               freie Textmarke, und was noch niemand vergeben hat, entsteht mit der ersten Karte,
               die es trägt. *@
            <div class="blattfeld etikettenfeld">
                <label class="blattmarke" for="etikett-eingabe">Etiketten</label>
                <div class="etikettenzeile" id="etikettenzeile">
                    @foreach (var etikett in _detail.Etiketten)
                    {
                        <span class="etikett" data-etikett="@etikett">
                            @etikett
                            <button type="button" class="etikett-entfernen" title="@etikett entfernen" @onclick="() => EntferneEtikett(etikett)">✕</button>
                        </span>
                    }
                    @* Den Text des Feldes führt das Feld selbst, nicht der Server: kein value.
                       Jedes Zeichen läuft über die Leitung, und trüge das Feld den
                       serverseitigen Stand als value, schriebe jede zurückkommende Renderrunde
                       den Stand von vorhin über das, was inzwischen getippt wurde — wer schnell
                       tippt, verliert dann Zeichen. Geleert wird es deshalb einmal und gezielt,
                       wenn ein Etikett angenommen ist. *@
                    <input class="etikett-eingabe"
                           id="etikett-eingabe"
                           @ref="_etikettfeld"
                           placeholder="+ Etikett"
                           @oninput="TippeEtikett"
                           @onkeydown="AufEtikettentaste" />
                </div>

                @if (_etikettentext.Length > 0)
                {
                    <div class="etikettenvorschlaege" id="etikettenvorschlaege">
                        @if (Etikettvorschlaege.Count > 0)
                        {
                            <p class="etikettenabschnitt">auf diesem Board schon vergeben</p>
                            @* @key haelt die Elementkennung ueber die Neuaufbauten hinweg fest: die
                               Liste wird bei jedem Tastendruck neu gerechnet, und ohne Schluessel
                               ordnet Blazor die Knoten neu zu, sobald sich ihre Zahl aendert — ein
                               Klick landete dann auf einem Element, das es so nicht mehr gibt. *@
                            @foreach (var vorschlag in Etikettvorschlaege)
                            {
                                <button type="button"
                                        @key="vorschlag.Text"
                                        class="etikettenvorschlag"
                                        data-vorschlag="@vorschlag.Text"
                                        @onclick="() => FuegeEtikettHinzu(vorschlag.Text)">
                                    @vorschlag.Text
                                    <span class="etikettenzahl">@Etikettenwahl.Kartenzahltext(vorschlag.Kartenzahl)</span>
                                </button>
                            }
                        }
                        @if (EtikettentextIstNeu)
                        {
                            <button type="button" @key="Neuanlagenschluessel" class="etikettenvorschlag etikettenvorschlag-neu" id="etikett-neu-anlegen" @onclick="() => FuegeEtikettHinzu(_etikettentext)">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
                                „@_etikettentext.Trim()“ neu anlegen
                            </button>
                        }
                    </div>
                }
            </div>

            @* Die fünf Punkte stehen immer offen: eine Farbe ist eine Wahl mit einem Klick, kein
               Feld, das man erst aufschlägt. *@
            <div class="blattfeld">
                <span class="blattmarke">Farbe der Karte</span>
                <div class="farbpunkte" id="farbpunkte">
                    @foreach (var farbe in Kartenfarbform.Alle)
                    {
                        <button type="button"
                                class="farbpunkt @Kartenfarbform.Punktklasse(farbe) @Gewaehltklasse(farbe)"
                                id="farbpunkt-@farbe"
                                title="@Kartenfarbform.Beschriftung(farbe)"
                                aria-pressed="@AlsAttributtext(farbe == _detail.Karte.Farbe)"
                                @onclick="() => SetzeFarbe(farbe)"></button>
                    }
                </div>
            </div>
        </aside>
    </div>
}

@code {
    private const string Titelfeld = "titel";
    private const string Beschreibungsfeld = "beschreibung";
    private const string Faelligkeitsfeld = "faellig";

    // Vollqualifiziert, weil der Komponentenname Kartendetail den gleichnamigen Vertragstyp
    // verdeckt — dieselbe Lage wie bei Board.razor und Karte.razor.
    private KanbanC.Contracts.Karten.Kartendetail? _detail;
    private bool _ladenIstAbgeschlossen;
    private bool _webApiIstNichtErreichbar;

    // Höchstens ein Feld steht offen; welches, sagt sein Name. Ein Wahrheitswert je Feld wäre
    // dieselbe Aussage mehrfach und ließe zwei offene Felder zu.
    private string? _offenesFeld;
    private Zurueckweisung? _zurueckweisung;
    private string _etikettentext = string.Empty;
    private string? _ausfallmeldung;

    // Das Etikettenfeld wird im Browser geleert, nicht über ein value-Attribut: so bleibt es
    // dasselbe Feld, der Cursor steht danach weiter darin, und keine Renderrunde fasst den Text
    // an, während getippt wird. Object.assign setzt die value-Eigenschaft des Elements — derselbe
    // Weg über einen Browser-Standardbefehl, den auch der Identitätsspeicher geht.
    private const string ElementEigenschaftenSetzen = "Object.assign";
    private ElementReference _etikettfeld;

    [Parameter]
    public long KarteId { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        _ladenIstAbgeschlossen = false;
        try
        {
            await LadeKartendetail();
            await LadeUrheber();
            _webApiIstNichtErreichbar = false;
        }
        catch (HttpRequestException)
        {
            _webApiIstNichtErreichbar = true;
        }

        _ladenIstAbgeschlossen = true;
    }

    private async Task SetzeVerantwortlichen(long? kontributorId)
    {
        await Speichere(_detail! with { Karte = _detail.Karte with { Kontributor = kontributorId } });
    }

    // Die Wahl holt ihre Liste selbst; ein Ausfall dabei gehört trotzdem hierher, damit die
    // Seite eine Meldungsstelle behält.
    private void MeldeAusfall(string? meldung)
    {
        _ausfallmeldung = meldung;
    }

    private IReadOnlyList<Etikettvorschlag> Etikettvorschlaege
    {
        get
        {
            return Etikettenwahl.Vorschlaege(_detail!.Etikettvorschlaege, _detail.Etiketten, _etikettentext);
        }
    }

    private bool EtikettentextIstNeu
    {
        get
        {
            return Etikettenwahl.LaesstSichNeuAnlegen(_detail!.Etikettvorschlaege, _detail.Etiketten, _etikettentext);
        }
    }

    // Ein Schluessel, der sich nicht mit dem getippten Text aendert: der Eintrag „… neu anlegen"
    // bleibt derselbe Knopf, waehrend seine Beschriftung mitwaechst.
    private const string Neuanlagenschluessel = "etikett-neu-anlegen";

    private void TippeEtikett(ChangeEventArgs ereignis)
    {
        _etikettentext = Text(ereignis);
    }

    // Die Eingabetaste legt an, was im Feld steht — der Weg ohne Zeiger.
    private async Task AufEtikettentaste(KeyboardEventArgs taste)
    {
        var dieTasteLegtAn = taste.Key == "Enter" && _etikettentext.Trim().Length > 0;
        if (!dieTasteLegtAn)
        {
            return;
        }

        await FuegeEtikettHinzu(_etikettentext);
    }

    // Ein bereits getragener Text wird nicht stillschweigend geschluckt: die Liste geht so ab,
    // wie sie getippt wurde, und der EtikettenValidator sagt mit seinem Wortlaut, dass er
    // doppelt ist. Eine zweite Dublettenregel in der Oberfläche wäre eine zweite Wahrheit.
    private async Task FuegeEtikettHinzu(string text)
    {
        await SetzeEtiketten([.. _detail!.Etiketten, text.Trim()]);
    }

    private async Task EntferneEtikett(string text)
    {
        await SetzeEtiketten(_detail!.Etiketten.Where(etikett => etikett != text).ToList());
    }

    private async Task SetzeEtiketten(IReadOnlyList<string> etiketten)
    {
        _zurueckweisung = null;
        _ausfallmeldung = await WebApiAufruf.MitAusfallmeldung(() => UebernimmEtiketten(new Kartenetiketten(etiketten)));
    }

    private async Task UebernimmEtiketten(Kartenetiketten etiketten)
    {
        var ergebnis = await KartenKlient.SetzeEtiketten(KarteId, etiketten);
        if (ergebnis.WurdeZurueckgewiesen)
        {
            // Der getippte Text bleibt stehen: er ist der Grund der Meldung, und die Liste
            // bleibt, wie sie war.
            _zurueckweisung = ergebnis.Zurueckweisung;
            return;
        }

        _etikettentext = string.Empty;
        _detail = ergebnis.Wert;
        await LeereEtikettfeld();
    }

    private async Task LeereEtikettfeld()
    {
        await Browser.InvokeVoidAsync(ElementEigenschaftenSetzen, _etikettfeld, new { value = string.Empty });
    }

    private string _teilaufgabentext = string.Empty;
    private ElementReference _teilaufgabenfeld;

    private bool HatTeilaufgaben
    {
        get
        {
            return _detail!.Teilaufgaben.Count > 0;
        }
    }

    private string Balkenanteil
    {
        get
        {
            return Teilaufgabenfortschritt.AlsProzent(_detail!.Teilaufgaben).ToString(CultureInfo.InvariantCulture);
        }
    }

    private string Balkenbreite
    {
        get
        {
            return Balkenanteil + "%";
        }
    }

    private static string Abhakklasse(Teilaufgabe teilaufgabe)
    {
        if (teilaufgabe.Abgehakt)
        {
            return "teilaufgabe-abgehakt";
        }

        return string.Empty;
    }

    private static string Abhaktitel(Teilaufgabe teilaufgabe)
    {
        if (teilaufgabe.Abgehakt)
        {
            return "Abhaken zurücknehmen";
        }

        return "Als erledigt abhaken";
    }

    private void TippeTeilaufgabe(ChangeEventArgs ereignis)
    {
        _teilaufgabentext = Text(ereignis);
    }

    // Die Eingabetaste legt an, was im Feld steht — der Weg ohne Zeiger, wie beim Etikettenfeld.
    // Anders als dort ohne Prüfung auf einen leeren Text: die Zurückweisung ist die Antwort der
    // API, und eine zweite Leerregel in der Oberfläche wäre eine zweite Wahrheit.
    private async Task AufTeilaufgabentaste(KeyboardEventArgs taste)
    {
        var dieTasteLegtAn = taste.Key == "Enter";
        if (!dieTasteLegtAn)
        {
            return;
        }

        await FuegeTeilaufgabeHinzu();
    }

    private async Task FuegeTeilaufgabeHinzu()
    {
        _zurueckweisung = null;
        _ausfallmeldung = await WebApiAufruf.MitAusfallmeldung(UebernimmTeilaufgabe);
    }

    // Nach einer Zurückweisung bleibt der getippte Text stehen: er ist der Grund der Meldung, und
    // die Liste bleibt, wie sie war.
    private async Task UebernimmTeilaufgabe()
    {
        var ergebnis = await KartenKlient.LegeTeilaufgabeAn(KarteId, new TeilaufgabeAnlegenAnfrage(_teilaufgabentext));
        if (ergebnis.WurdeZurueckgewiesen)
        {
            _zurueckweisung = ergebnis.Zurueckweisung;
            return;
        }

        _teilaufgabentext = string.Empty;
        _detail = ergebnis.Wert;
        await LeereTeilaufgabenfeld();
    }

    // Das Feld bleibt nach dem Anlegen stehen, leer und unter dem Cursor: wer eine Gliederung
    // schreibt, legt selten genau eine Zeile an. Der Fokus wird ausdrücklich zurückgeholt, damit
    // der Weg über „+" derselbe ist wie der über die Eingabetaste — ein Klick auf den Knopf nähme
    // ihn sonst mit.
    private async Task LeereTeilaufgabenfeld()
    {
        await Browser.InvokeVoidAsync(ElementEigenschaftenSetzen, _teilaufgabenfeld, new { value = string.Empty });
        await _teilaufgabenfeld.FocusAsync();
    }

    private async Task FokussiereTeilaufgabenfeld()
    {
        await _teilaufgabenfeld.FocusAsync();
    }

    // Die Oberfläche kippt, die Route setzt: geschickt wird der Zielzustand, den der Betrachter
    // gerade sieht. Ein zweiter gleicher Aufruf ändert damit nichts.
    private async Task SchalteAbhakung(Teilaufgabe teilaufgabe)
    {
        _zurueckweisung = null;
        _ausfallmeldung = await WebApiAufruf.MitAusfallmeldung(() => UebernimmAbhakung(teilaufgabe));
    }

    private async Task UebernimmAbhakung(Teilaufgabe teilaufgabe)
    {
        var ergebnis = await KartenKlient.SetzeAbhakung(KarteId, teilaufgabe.TeilaufgabeId, new Teilaufgabenstand(!teilaufgabe.Abgehakt));
        if (ergebnis.WurdeZurueckgewiesen)
        {
            _zurueckweisung = ergebnis.Zurueckweisung;
            return;
        }

        _detail = ergebnis.Wert;
    }

    private bool HatKommentare
    {
        get
        {
            return _detail!.Kommentare.Count > 0;
        }
    }

    private string Kommentarzahl
    {
        get
        {
            return _detail!.Kommentare.Count.ToString(CultureInfo.InvariantCulture);
        }
    }

    // „Name · Zeitpunkt" — ohne die „Quelle" des Artboards. Ein stillgelegter Urheber bleibt an
    // seinen alten Äußerungen stehen und trägt den Zusatz, damit die Geschichte der Karte lesbar
    // bleibt, wenn jemand geht.
    private static string Metazeile(Kommentar kommentar)
    {
        var name = kommentar.Urheber.Name;
        if (kommentar.Urheber.StillgelegtAm is not null)
        {
            name = $"{name} (stillgelegt)";
        }

        return $"{name} · {Zeitpunktform.AlsText(kommentar.Zeitpunkt, DateTimeOffset.Now)}";
    }

    private async Task FokussiereKommentarfeld()
    {
        await _kommentarfeld.FocusAsync();
    }

    private string _kommentartext = string.Empty;
    private ElementReference _kommentarfeld;

    // Der Urheber kommt aus der Identitätswahl dieses Browsers: die Seite injiziert den
    // Identitaetsspeicher selbst, statt ihn sich von der Kopfzeile reichen zu lassen. Der Dienst
    // ist AddScoped und damit je Blazor-Kreislauf dieselbe Instanz — die Seite liest genau den
    // Wert, den die Kopfzeile geschrieben hat, und R00013 bleibt unberührt.
    private Kontributor? _urheber;

    // Die Liste je Kreislauf einmal, wie in der Kopfzeile: aus der KontributorId wird erst über
    // sie ein Name mit Art, und daraus das Kürzel.
    private IReadOnlyList<Kontributor> _kontributoren = [];

    private string Sendetitel
    {
        get
        {
            if (_urheber is null)
            {
                return "Erst in der Kopfzeile wählen, wer du bist";
            }

            return $"Als {_urheber.Name} senden";
        }
    }

    // Die Ausfallmeldung wird durchgereicht und nicht verworfen: bleibt die Kontributorenliste
    // aus, ist der Urheber „niemand" — und ohne Meldung läse der Mensch dann den Hinweis, er
    // solle in der Kopfzeile wählen, obwohl er gewählt hat. Das wäre eine Falschaussage über die
    // eigene Lage.
    private async Task LadeUrheber()
    {
        _ausfallmeldung = await WebApiAufruf.MitAusfallmeldung(async () => _kontributoren = await KontributorenKlient.LadeAlle());
        _urheber = await GewaehlterUrheber();
    }

    // Gelesen wird bei **jedem** Anlass neu und nicht einmal beim Laden: nur so gilt eine Wahl,
    // die während der offenen Kartenseite in der Kopfzeile wechselt, sofort.
    private async Task LiesUrheberNach()
    {
        _urheber = await GewaehlterUrheber();
    }

    private async Task<Kontributor?> GewaehlterUrheber()
    {
        var gewaehlteKontributorId = await Identitaetsspeicher.Lies();
        if (gewaehlteKontributorId is null)
        {
            return null;
        }

        var gewaehlter = _kontributoren.FirstOrDefault(kontributor => kontributor.KontributorId == gewaehlteKontributorId.Value);
        var derGewaehlteIstNochNichtGeladen = gewaehlter is null;
        if (derGewaehlteIstNochNichtGeladen)
        {
            // Ein Kontributor, der nach dem Laden dieser Seite entstanden ist: die Liste holt
            // sich den heutigen Stand, statt die Wahl fälschlich als „niemand" zu lesen.
            _ausfallmeldung = await WebApiAufruf.MitAusfallmeldung(async () => _kontributoren = await KontributorenKlient.LadeAlle());
            gewaehlter = _kontributoren.FirstOrDefault(kontributor => kontributor.KontributorId == gewaehlteKontributorId.Value);
        }

        return gewaehlter;
    }

    private void TippeKommentar(ChangeEventArgs ereignis)
    {
        _kommentartext = Text(ereignis);
    }

    // Die Eingabetaste sendet, was im Feld steht — der Weg ohne Zeiger, wie beim Teilaufgabenfeld.
    private async Task AufKommentartaste(KeyboardEventArgs taste)
    {
        var dieTasteSendet = taste.Key == "Enter";
        if (!dieTasteSendet)
        {
            return;
        }

        await SendeKommentar();
    }

    // Die Wahl wird hier ein letztes Mal gelesen und nicht aus _urheber genommen: zwischen dem
    // letzten Nachlesen und dem Klick kann sie gewechselt haben, und der Kommentar trägt dann den
    // neuen Urheber.
    private async Task SendeKommentar()
    {
        _zurueckweisung = null;
        _urheber = await GewaehlterUrheber();
        if (_urheber is null)
        {
            return;
        }

        var anfrage = new KommentarSchreibenAnfrage(_kommentartext, _urheber.KontributorId);
        _ausfallmeldung = await WebApiAufruf.MitAusfallmeldung(() => UebernimmKommentar(anfrage));
    }

    // Nach einer Zurückweisung bleibt der getippte Text stehen: er ist der Grund der Meldung.
    private async Task UebernimmKommentar(KommentarSchreibenAnfrage anfrage)
    {
        var ergebnis = await KartenKlient.SchreibeKommentar(KarteId, anfrage);
        if (ergebnis.WurdeZurueckgewiesen)
        {
            _zurueckweisung = ergebnis.Zurueckweisung;
            return;
        }

        _kommentartext = string.Empty;
        _detail = ergebnis.Wert;
        await LeereKommentarfeld();
    }

    // Das Feld bleibt nach dem Senden stehen, leer und unter dem Cursor: wer eine Rückfrage
    // stellt, schreibt selten genau einen Satz. Dieselbe Antwort wie bei der Teilaufgabenzeile.
    private async Task LeereKommentarfeld()
    {
        await Browser.InvokeVoidAsync(ElementEigenschaftenSetzen, _kommentarfeld, new { value = string.Empty });
        await _kommentarfeld.FocusAsync();
    }

    private bool HatAnhaenge
    {
        get
        {
            return _detail!.Anhaenge.Count > 0;
        }
    }

    // Urheber und Zeitpunkt stehen im title der Zeile und nicht als zweite Textzeile: so bleibt
    // die gezeichnete einzeilige Form, und die Zusage der Vision — an jeder Karte ist ablesbar,
    // wer gehandelt hat — wird trotzdem eingelöst. Ein stillgelegter Urheber bleibt an seinen
    // alten Anhängen stehen und trägt den Zusatz.
    private static string Anhangmeta(Anhang anhang)
    {
        var name = anhang.Urheber.Name;
        if (anhang.Urheber.StillgelegtAm is not null)
        {
            name = $"{name} (stillgelegt)";
        }

        return $"{name} · {Zeitpunktform.AlsText(anhang.Zeitpunkt, DateTimeOffset.Now)}";
    }

    // Ohne gewählte Identität ist die Fläche gesperrt; die Klasse zeichnet das, der Hinweis
    // darunter sagt, was zu tun ist. Board und Kartenseite bleiben im Übrigen bedienbar.
    private string Ablegesperre
    {
        get
        {
            if (_urheber is null)
            {
                return "ablegeflaeche-gesperrt";
            }

            return string.Empty;
        }
    }

    // Die Wahl wird beim Senden gelesen und nicht beim Laden: zwischen dem letzten Nachlesen und
    // dem Ablegen kann sie gewechselt haben, und der Anhang trägt dann den neuen Urheber.
    // Muster SendeKommentar.
    private async Task NimmDatei(InputFileChangeEventArgs ereignis)
    {
        _zurueckweisung = null;
        _urheber = await GewaehlterUrheber();
        if (_urheber is null)
        {
            return;
        }

        var datei = ereignis.File;
        _ausfallmeldung = await WebApiAufruf.MitAusfallmeldung(() => UebernimmAnhang(datei, _urheber.KontributorId));
    }

    // OpenReadStream bricht ohne Angabe schon bei 512 KB ab; die Obergrenze ist dieselbe Konstante
    // wie im Validator, an der Route und im SignalR-Kreislauf.
    // Der Strom wird im using geschlossen, sobald der Aufruf durch ist.
    private async Task UebernimmAnhang(IBrowserFile datei, long kontributorId)
    {
        await using var inhalt = datei.OpenReadStream(Anhangsgrenze.HoechsteDateigroesse);
        var ergebnis = await KartenKlient.HaengeAnhangAn(KarteId, kontributorId, datei.Name, inhalt);
        if (ergebnis.WurdeZurueckgewiesen)
        {
            // Die Liste bleibt, wie sie war: die Meldung erklärt, warum nichts dazugekommen ist.
            _zurueckweisung = ergebnis.Zurueckweisung;
            return;
        }

        _detail = ergebnis.Wert;
    }

    private async Task EntferneAnhang(Anhang anhang)
    {
        _zurueckweisung = null;
        _ausfallmeldung = await WebApiAufruf.MitAusfallmeldung(() => UebernimmEntfernung(anhang));
    }

    private async Task UebernimmEntfernung(Anhang anhang)
    {
        var ergebnis = await KartenKlient.EntferneAnhang(KarteId, anhang.AnhangId);
        if (ergebnis.WurdeZurueckgewiesen)
        {
            _zurueckweisung = ergebnis.Zurueckweisung;
            return;
        }

        _detail = ergebnis.Wert;
    }

    private bool IstOffen(string feld)
    {
        return _offenesFeld == feld;
    }

    private void Oeffne(string feld)
    {
        _offenesFeld = feld;
    }

    // Der Wert des Datumsfeldes ist derselbe ISO-Text, den der Terminformatierer anzeigt —
    // kein zweites Datumsformat in der Anwendung.
    private string Terminwert
    {
        get
        {
            if (_detail!.Karte.FaelligAm is null)
            {
                return string.Empty;
            }

            return Terminformatierer.AlsText(_detail.Karte.FaelligAm);
        }
    }

    private string Gewaehltklasse(Kartenfarbe farbe)
    {
        if (farbe == _detail!.Karte.Farbe)
        {
            return "farbpunkt-gewaehlt";
        }

        return string.Empty;
    }

    private static string AlsAttributtext(bool wert)
    {
        if (wert)
        {
            return "true";
        }

        return "false";
    }

    private async Task SetzeTitel(ChangeEventArgs ereignis)
    {
        await Speichere(_detail! with { Karte = _detail.Karte with { Titel = Text(ereignis) } });
    }

    private async Task SetzeBeschreibung(ChangeEventArgs ereignis)
    {
        await Speichere(_detail! with { Karte = _detail.Karte with { Beschreibung = AlsBeschreibung(Text(ereignis)) } });
    }

    // Ein geleertes Datumsfeld reist als null, nicht als leerer Text — den wiese
    // System.Text.Json ab (DateOnlyEingabeProbeTests).
    private async Task SetzeFaelligkeit(ChangeEventArgs ereignis)
    {
        await Speichere(_detail! with { Karte = _detail.Karte with { FaelligAm = AlsTermin(Text(ereignis)) } });
    }

    private async Task SetzeFarbe(Kartenfarbe farbe)
    {
        await Speichere(_detail! with { Karte = _detail.Karte with { Farbe = farbe } });
    }

    private static string Text(ChangeEventArgs ereignis)
    {
        return ereignis.Value?.ToString() ?? string.Empty;
    }

    private static string? AlsBeschreibung(string text)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            return null;
        }

        return text;
    }

    private static DateOnly? AlsTermin(string text)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            return null;
        }

        return DateOnly.Parse(text, CultureInfo.InvariantCulture);
    }

    // Gespeichert wird je Feld, sobald es verlassen oder gewählt ist — nicht gesammelt. Das
    // Artboard zeichnet keinen Speicherknopf, und ein Zwischenstand, den ein Reload verlöre,
    // stünde gegen „nach Reload da". Die Anfrage trägt trotzdem alle Felder, weil sie so
    // geschnitten ist; abgesetzt wird sie nur für das eine Feld, das sich geändert hat.
    private async Task Speichere(KanbanC.Contracts.Karten.Kartendetail gewuenscht)
    {
        _offenesFeld = null;
        _zurueckweisung = null;
        var anfrage = new KarteAendernAnfrage(
            gewuenscht.Karte.Titel,
            gewuenscht.Karte.Beschreibung,
            gewuenscht.Karte.FaelligAm,
            gewuenscht.Karte.Farbe,
            gewuenscht.Karte.Kontributor);
        _ausfallmeldung = await WebApiAufruf.MitAusfallmeldung(() => UebernimmAenderung(anfrage));
    }

    // Nach einer Zurückweisung bleibt _detail unangetastet: die vorige Fassung steht weiter da,
    // und gespeichert wurde nichts.
    private async Task UebernimmAenderung(KarteAendernAnfrage anfrage)
    {
        var ergebnis = await KartenKlient.AendereKarte(KarteId, anfrage);
        if (ergebnis.WurdeZurueckgewiesen)
        {
            _zurueckweisung = ergebnis.Zurueckweisung;
            return;
        }

        _detail = ergebnis.Wert;
    }

    // Die Zurückweisung wird nicht angezeigt, sondern nur ausgewertet: die Seite kennt ihre
    // eigene Nummer und sagt dasselbe wie Board.razor. Der Befund der API bleibt dem Agenten.
    private async Task LadeKartendetail()
    {
        var ergebnis = await KartenKlient.LadeKartendetail(KarteId);
        if (ergebnis.WurdeZurueckgewiesen)
        {
            _detail = null;
            return;
        }

        _detail = ergebnis.Wert;
    }
}
