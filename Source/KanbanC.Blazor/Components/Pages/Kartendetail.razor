    private async Task FokussiereKommentarfeld()
    {
        await _kommentarfeld.FocusAsync();
    }

    private string _kommentartext = string.Empty;
    private ElementReference _kommentarfeld;

    // Der Urheber kommt aus der Identitätswahl dieses Browsers: die Seite injiziert den
    // Identitaetsspeicher selbst, statt ihn sich von der Kopfzeile reichen zu lassen. Der Dienst
    // ist AddScoped und damit je Blazor-Kreislauf dieselbe Instanz — die Seite liest genau den
    // Wert, den die Kopfzeile geschrieben hat, und R00013 bleibt unberührt.
    private Kontributor? _urheber;

    // Die Liste je Kreislauf einmal, wie in der Kopfzeile: aus der KontributorId wird erst über
    // sie ein Name mit Art, und daraus das Kürzel.
    private IReadOnlyList<Kontributor> _kontributoren = [];

    private string Sendetitel
    {
        get
        {
            if (_urheber is null)
            {
                return "Erst in der Kopfzeile wählen, wer du bist";
            }

            return $"Als {_urheber.Name} senden";
        }
    }

    // Die Ausfallmeldung wird durchgereicht und nicht verworfen: bleibt die Kontributorenliste
    // aus, ist der Urheber „niemand" — und ohne Meldung läse der Mensch dann den Hinweis, er
    // solle in der Kopfzeile wählen, obwohl er gewählt hat. Das wäre eine Falschaussage über die
    // eigene Lage.
    private async Task LadeUrheber()
    {
        _ausfallmeldung = await WebApiAufruf.MitAusfallmeldung(async () => _kontributoren = await KontributorenKlient.LadeAlle());
        _urheber = await GewaehlterUrheber();
    }

    // Gelesen wird bei **jedem** Anlass neu und nicht einmal beim Laden: nur so gilt eine Wahl,
    // die während der offenen Kartenseite in der Kopfzeile wechselt, sofort.
    private async Task LiesUrheberNach()
    {
        _urheber = await GewaehlterUrheber();
    }

    private async Task<Kontributor?> GewaehlterUrheber()
    {
        var gewaehlteKontributorId = await Identitaetsspeicher.Lies();
        if (gewaehlteKontributorId is null)
        {
            return null;
        }

        var gewaehlter = _kontributoren.FirstOrDefault(kontributor => kontributor.KontributorId == gewaehlteKontributorId.Value);
        var derGewaehlteIstNochNichtGeladen = gewaehlter is null;
        if (derGewaehlteIstNochNichtGeladen)
        {
            // Ein Kontributor, der nach dem Laden dieser Seite entstanden ist: die Liste holt
            // sich den heutigen Stand, statt die Wahl fälschlich als „niemand" zu lesen.
            _ausfallmeldung = await WebApiAufruf.MitAusfallmeldung(async () => _kontributoren = await KontributorenKlient.LadeAlle());
            gewaehlter = _kontributoren.FirstOrDefault(kontributor => kontributor.KontributorId == gewaehlteKontributorId.Value);
        }

        return gewaehlter;
    }

    private bool _identitaetswahlIstOffen;

    // Der laufende Eintrag der **gewählten** Identität auf dieser Karte. Ein laufender Eintrag ist
    // der ohne Ende; ohne gewählte Identität gibt es keinen eigenen.
    private Zeiteintrag? LaufenderEigenerZeiteintrag
    {
        get
        {
            var esGibtNochNichtsZuZeigen = _detail is null || _urheber is null;
            if (esGibtNochNichtsZuZeigen)
            {
                return null;
            }

            return _detail!.Zeiteintraege.FirstOrDefault(EntsprichtDemEigenenLauf);
        }
    }

    private bool EntsprichtDemEigenenLauf(Zeiteintrag eintrag)
    {
        return eintrag.Ende is null && eintrag.Kontributor.KontributorId == _urheber!.KontributorId;
    }

    private bool HatZeiteintraege
    {
        get
        {
            return _detail!.Zeiteintraege.Count > 0;
        }
    }

    // Die Anzahl wird gerechnet und nicht mitgesendet — .Count an der gelieferten Liste, wie bei
    // den Kommentaren. Ohne Eintrag bleibt sie fort: die Zahl steht nur über einer Liste.
    private string Zeiteintragszahl
    {
        get
        {
            return _detail!.Zeiteintraege.Count.ToString(CultureInfo.InvariantCulture);
        }
    }

    // Neueste zuerst — die Umkehrung entsteht in der Anzeige. Der Zeitenleser bleibt bei seiner
    // Beginn-aufsteigenden Folge, weil eine Reihenfolge in der Persistenz keine Wahrheit
    // behauptet; bei gleichem Beginn entscheidet die Nummer, damit die Folge stabil bleibt.
    private IReadOnlyList<Zeiteintrag> ZeiteintraegeNeuesteZuerst
    {
        get
        {
            var nachBeginn = _detail!.Zeiteintraege.OrderByDescending(eintrag => eintrag.Beginn);
            return nachBeginn.ThenByDescending(eintrag => eintrag.ZeiteintragId).ToList();
        }
    }

    // „0:37 · 1 läuft": die laufende Messung ist genannt, aber nicht addiert — wer die Zahl
    // liest, sieht, dass sie unvollständig ist, und warum.
    private static string Summentext(Kontributorenzeitsumme zeile)
    {
        var summe = Dauerform.AlsText(zeile.Summe);
        var esLaeuftNichts = zeile.Laufende == 0;
        if (esLaeuftNichts)
        {
            return summe;
        }

        return $"{summe} · {zeile.Laufende.ToString(CultureInfo.InvariantCulture)} läuft";
    }

    // Laufend und abgeschlossen unterscheiden sich an drei Merkmalen, von denen keines nur Farbe
    // ist: der Akzentkante links, dem Wort „läuft" an der Stelle des Endes und dem Stoppquadrat.
    private static string Zeilenklasse(Zeiteintrag eintrag)
    {
        var derEintragLaeuft = eintrag.Ende is null;
        if (derEintragLaeuft)
        {
            return "zeiteneintrag zeiteneintrag-laeuft";
        }

        return "zeiteneintrag";
    }

    // Die Wahl wird hier ein letztes Mal gelesen und nicht aus _urheber genommen: zwischen dem
    // letzten Nachlesen und dem Klick kann sie in der Kopfzeile gewechselt haben.
    private async Task StarteTimer()
    {
        _zurueckweisung = null;
        _urheber = await GewaehlterUrheber();
        if (_urheber is null)
        {
            await OeffneIdentitaetswahl();
            return;
        }

        _ausfallmeldung = await WebApiAufruf.MitAusfallmeldung(() => SendeZeitmessungsstart(_urheber.KontributorId));
    }

    // Wer die Wahl öffnet, will den heutigen Stand sehen — dieselbe Antwort wie in der Kopfzeile.
    private async Task OeffneIdentitaetswahl()
    {
        _identitaetswahlIstOffen = true;
        await LadeKontributoren();
    }

    private async Task LadeKontributoren()
    {
        _ausfallmeldung = await WebApiAufruf.MitAusfallmeldung(async () => _kontributoren = await KontributorenKlient.LadeAlle());
    }

    // **Ohne zweiten Klick:** die Wahl war die fehlende Angabe, nicht eine zweite Handlung.
    // Gemerkt wird über denselben Identitätsspeicher wie in der Kopfzeile — es entsteht kein
    // zweiter Identitätsbegriff, und der Platz in der Kopfzeile zieht von selbst nach.
    private async Task UebernimmIdentitaetUndStarte(long kontributorId)
    {
        _identitaetswahlIstOffen = false;
        await Identitaetsspeicher.Merke(kontributorId);
        _urheber = await GewaehlterUrheber();
        if (_urheber is null)
        {
            return;
        }

        _ausfallmeldung = await WebApiAufruf.MitAusfallmeldung(() => SendeZeitmessungsstart(_urheber.KontributorId));
    }

    // Gestoppt wird ohne Identitätsfrage: der Eintrag weiß selbst, wem er gehört, und der Aufruf
    // nennt keinen Kontributor. Der Knopf oben sucht den eigenen laufenden Eintrag und beendet
    // ihn über denselben Weg wie das Quadrat an seiner Zeile — beide zeigen denselben Eintrag,
    // also darf es auch nur einen Weg geben, ihn zu beenden.
    private async Task StoppeTimer()
    {
        var laufender = LaufenderEigenerZeiteintrag;
        if (laufender is null)
        {
            return;
        }

        await StoppeZeile(laufender);
    }

    // Die Zeilenhandlung beendet **genau diesen** Eintrag — auch den eines fremden Kontributors
    // und auch ohne gewählte Identität. Es entsteht dabei keine neue Fähigkeit: über die API ging
    // der fremde Stopp längst, es fehlte nur die Zeile, an der das Quadrat hängen konnte.
    private async Task StoppeZeile(Zeiteintrag eintrag)
    {
        _zurueckweisung = null;
        _ausfallmeldung = await WebApiAufruf.MitAusfallmeldung(() => SendeZeitmessungsende(eintrag.ZeiteintragId));
    }

    // Der zurückkommende Eintrag ersetzt den alten über dasselbe MitEintrag wie beim Start —
    // Knopf und Zustand ziehen damit ohne zweiten Abruf nach, und die Bahnenplakette fällt beim
    // nächsten Boardabruf von selbst heraus.
    private async Task SendeZeitmessungsende(long zeiteintragId)
    {
        var ergebnis = await ZeitenKlient.BeendeZeitmessung(KarteId, zeiteintragId);
        if (ergebnis.WurdeZurueckgewiesen)
        {
            _zurueckweisung = ergebnis.Zurueckweisung;
            return;
        }

        _detail = _detail! with { Zeiteintraege = MitEintrag(_detail.Zeiteintraege, ergebnis.Wert) };
    }

    // Zurück kommt der Zeiteintrag und nicht die ganze Seite: die Route legt eine Zeile an, und
    // ein zweiter Abruf des Kartendetails fände denselben Stand.
    private async Task SendeZeitmessungsstart(long kontributorId)
    {
        var ergebnis = await ZeitenKlient.StarteZeitmessung(KarteId, new ZeitmessungStartenAnfrage(kontributorId));
        if (ergebnis.WurdeZurueckgewiesen)
        {
            _zurueckweisung = ergebnis.Zurueckweisung;
            return;
        }

        _detail = _detail! with { Zeiteintraege = MitEintrag(_detail.Zeiteintraege, ergebnis.Wert) };
    }

    // Höchstens **ein** Zeitenformular steht offen: der Nachtrag am Fuß oder genau eine Zeile.
    // Zwei Wahrheitswerte wären dieselbe Aussage zweimal und ließen beide zugleich offen.
    private bool _nachtragIstOffen;
    private long? _offeneZeiteintragId;

    // Die Gründe des Zeitenblocks stehen im Formular, nicht in der Meldungsstelle ganz oben:
    // dort stünden sie außerhalb des Blicks, in dem gerade getippt wird — und die Eingaben, auf
    // die sie sich beziehen, bleiben stehen.
    private Zurueckweisung? _zeitenzurueckweisung;

    // Die Kontributorenliste wird beim Aufklappen geholt und nicht beim Laden der Seite: wer das
    // Formular öffnet, will den heutigen Stand sehen — dieselbe Antwort wie in der Identitätswahl.
    private async Task OeffneNachtrag()
    {
        _offeneZeiteintragId = null;
        _zeitenzurueckweisung = null;
        _nachtragIstOffen = true;
        await LadeKontributoren();
    }

    // Ein zweiter Klick auf denselben Stift schließt die Zeile wieder — derselbe Schalter,
    // dieselbe Handlung rückwärts.
    private async Task OeffneZeiteintrag(Zeiteintrag eintrag)
    {
        var dieseZeileIstSchonOffen = _offeneZeiteintragId == eintrag.ZeiteintragId;
        if (dieseZeileIstSchonOffen)
        {
            SchliesseZeitenformulare();
            return;
        }

        _nachtragIstOffen = false;
        _zeitenzurueckweisung = null;
        _offeneZeiteintragId = eintrag.ZeiteintragId;
        await LadeKontributoren();
    }

    private void SchliesseZeitenformulare()
    {
        _nachtragIstOffen = false;
        _offeneZeiteintragId = null;
        _zeitenzurueckweisung = null;
    }

    private async Task TrageZeitNach(Zeiteintragseingabe eingabe)
    {
        _zeitenzurueckweisung = null;
        _ausfallmeldung = await WebApiAufruf.MitAusfallmeldung(() => SendeNachtrag(eingabe));
    }

    // Zurück kommt der angelegte Eintrag und nicht die ganze Seite — Liste, Summen und Ist-Summe
    // ziehen über dasselbe MitEintrag nach wie bei Start und Stopp.
    private async Task SendeNachtrag(Zeiteintragseingabe eingabe)
    {
        var beginn = Zeitpunktform.AusOrtszeit(eingabe.Tag, eingabe.Von);
        var ende = Zeitpunktform.AusOrtszeit(eingabe.Tag, eingabe.Bis!.Value);
        var ergebnis = await ZeitenKlient.TrageNach(KarteId, new ZeiteintragNachtragenAnfrage(eingabe.Kontributor, beginn, ende));
        if (ergebnis.WurdeZurueckgewiesen)
        {
            _zeitenzurueckweisung = ergebnis.Zurueckweisung;
            return;
        }

        _detail = _detail! with { Zeiteintraege = MitEintrag(_detail.Zeiteintraege, ergebnis.Wert) };
        _nachtragIstOffen = false;
    }

    private async Task AendereZeiteintrag(Zeiteintrag eintrag, Zeiteintragseingabe eingabe)
    {
        _zeitenzurueckweisung = null;
        _ausfallmeldung = await WebApiAufruf.MitAusfallmeldung(() => SendeZeiteintragsaenderung(eintrag, eingabe));
    }

    // Der Tag stammt aus dem Eintrag selbst: ein bestehender Eintrag ändert seine Uhrzeiten,
    // nicht seinen Tag. Ein leeres „bis" reist als null und lässt ihn wieder laufen.
    private async Task SendeZeiteintragsaenderung(Zeiteintrag eintrag, Zeiteintragseingabe eingabe)
    {
        var beginn = Zeitpunktform.AusOrtszeit(eingabe.Tag, eingabe.Von);
        var ende = Zeitpunktform.AusOrtszeit(eingabe.Tag, eingabe.Bis);
        var ergebnis = await ZeitenKlient.Aendere(KarteId, eintrag.ZeiteintragId, new ZeiteintragAendernAnfrage(eingabe.Kontributor, beginn, ende));
        if (ergebnis.WurdeZurueckgewiesen)
        {
            _zeitenzurueckweisung = ergebnis.Zurueckweisung;
            return;
        }

        _detail = _detail! with { Zeiteintraege = MitEintrag(_detail.Zeiteintraege, ergebnis.Wert) };
        _offeneZeiteintragId = null;
    }

    private async Task LoescheZeiteintrag(Zeiteintrag eintrag)
    {
        _zeitenzurueckweisung = null;
        _ausfallmeldung = await WebApiAufruf.MitAusfallmeldung(() => SendeZeiteintragsloeschung(eintrag));
    }

    // Zurück kommt das ganze Kartendetail ohne die Zeile — Hausform EntferneAnhang: ein zweiter
    // Abruf wäre ein Fenster, in dem Liste und Summen auseinanderlaufen.
    private async Task SendeZeiteintragsloeschung(Zeiteintrag eintrag)
    {
        var ergebnis = await ZeitenKlient.Loesche(KarteId, eintrag.ZeiteintragId);
        if (ergebnis.WurdeZurueckgewiesen)
        {
            _zeitenzurueckweisung = ergebnis.Zurueckweisung;
            return;
        }

        _detail = ergebnis.Wert;
        _offeneZeiteintragId = null;
    }

    // Ersetzen statt anhängen: ein zweiter Start auf derselben Karte liefert **denselben** Eintrag
    // zurück, und angehängt stünde er zweimal in der Liste.
    private static IReadOnlyList<Zeiteintrag> MitEintrag(IReadOnlyList<Zeiteintrag> vorhandene, Zeiteintrag eintrag)
    {
        var uebrige = vorhandene.Where(vorhandener => vorhandener.ZeiteintragId != eintrag.ZeiteintragId).ToList();
        uebrige.Add(eintrag);
        return uebrige.OrderBy(zeiteintrag => zeiteintrag.Beginn).ThenBy(zeiteintrag => zeiteintrag.ZeiteintragId).ToList();
    }

    private void AufIdentitaetstaste(KeyboardEventArgs taste)
    {
        var dieTasteSchliesstDieWahl = taste.Key == "Escape";
        if (!dieTasteSchliesstDieWahl)
        {
            return;
        }

        SchliesseIdentitaetswahl();
    }

    private void SchliesseIdentitaetswahl()
    {
        _identitaetswahlIstOffen = false;
    }

    private void TippeKommentar(ChangeEventArgs ereignis)
    {
        _kommentartext = Text(ereignis);
    }

    // Die Eingabetaste sendet, was im Feld steht — der Weg ohne Zeiger, wie beim Teilaufgabenfeld.
    private async Task AufKommentartaste(KeyboardEventArgs taste)
    {
        var dieTasteSendet = taste.Key == "Enter";
        if (!dieTasteSendet)
        {
            return;
        }

        await SendeKommentar();
    }

    // Die Wahl wird hier ein letztes Mal gelesen und nicht aus _urheber genommen: zwischen dem
    // letzten Nachlesen und dem Klick kann sie gewechselt haben, und der Kommentar trägt dann den
    // neuen Urheber.
    private async Task SendeKommentar()
    {
        _zurueckweisung = null;
        _urheber = await GewaehlterUrheber();
        if (_urheber is null)
        {
            return;
        }

        var anfrage = new KommentarSchreibenAnfrage(_kommentartext, _urheber.KontributorId);
        _ausfallmeldung = await WebApiAufruf.MitAusfallmeldung(() => UebernimmKommentar(anfrage));
    }

    // Nach einer Zurückweisung bleibt der getippte Text stehen: er ist der Grund der Meldung.
    private async Task UebernimmKommentar(KommentarSchreibenAnfrage anfrage)
    {
        var ergebnis = await KartenKlient.SchreibeKommentar(KarteId, anfrage);
        if (ergebnis.WurdeZurueckgewiesen)
        {
            _zurueckweisung = ergebnis.Zurueckweisung;
            return;
        }

        _kommentartext = string.Empty;
        _detail = ergebnis.Wert;
        await LeereKommentarfeld();
    }

    // Das Feld bleibt nach dem Senden stehen, leer und unter dem Cursor: wer eine Rückfrage
    // stellt, schreibt selten genau einen Satz. Dieselbe Antwort wie bei der Teilaufgabenzeile.
    private async Task LeereKommentarfeld()
    {
        await Browser.InvokeVoidAsync(ElementEigenschaftenSetzen, _kommentarfeld, new { value = string.Empty });
        await _kommentarfeld.FocusAsync();
    }

    private bool HatAnhaenge
    {
        get
        {
            return _detail!.Anhaenge.Count > 0;
        }
    }

    // Urheber und Zeitpunkt stehen im title der Zeile und nicht als zweite Textzeile: so bleibt
    // die gezeichnete einzeilige Form, und die Zusage der Vision — an jeder Karte ist ablesbar,
    // wer gehandelt hat — wird trotzdem eingelöst. Ein stillgelegter Urheber bleibt an seinen
    // alten Anhängen stehen und trägt den Zusatz.
    private static string Anhangmeta(Anhang anhang)
    {
        var name = anhang.Urheber.Name;
        if (anhang.Urheber.StillgelegtAm is not null)
        {
            name = $"{name} (stillgelegt)";
        }

        return $"{name} · {Zeitpunktform.AlsText(anhang.Zeitpunkt, DateTimeOffset.Now)}";
    }

    // Welche Datei gerade angehängt wird. Null heißt: es läuft keine Übertragung. Die Komponente
    // hält den Zustand, die Regel darüber liegt in Ablegeflaechenstand.
    private string? _laufendeDatei;

    private readonly List<string> _anhangmeldungen = [];

    // Gesperrt ist die Fläche ohne gewählte Identität und während ein Anhängen läuft; die Klasse
    // zeichnet das, der Hinweis darunter sagt, was zu tun ist. Board und Kartenseite bleiben im
    // Übrigen bedienbar.
    private bool AblegeflaecheIstGesperrt
    {
        get
        {
            return Ablegeflaechenstand.IstGesperrt(_urheber is not null, _laufendeDatei);
        }
    }

    private string Ablegesperre
    {
        get
        {
            if (AblegeflaecheIstGesperrt)
            {
                return "ablegeflaeche-gesperrt";
            }

            return string.Empty;
        }
    }

    // Der laufende Vorgang bekommt eine eigene Kante: er ist ein anderer Grund als die fehlende
    // Identität, und der Mensch soll die beiden nicht verwechseln.
    private string Ablegelauf
    {
        get
        {
            if (_laufendeDatei is null)
            {
                return string.Empty;
            }

            return "ablegeflaeche-laeuft";
        }
    }

    private string Ablegetext
    {
        get
        {
            return Ablegeflaechenstand.Text(_urheber is not null, _laufendeDatei);
        }
    }

    private string? Ablegehinweis
    {
        get
        {
            return Ablegeflaechenstand.Hinweis(_urheber is not null);
        }
    }

    // Die Wahl wird beim Senden gelesen und nicht beim Laden: zwischen dem letzten Nachlesen und
    // dem Ablegen kann sie gewechselt haben, und der Anhang trägt dann den neuen Urheber.
    // Muster SendeKommentar.
    private async Task NimmDatei(InputFileChangeEventArgs ereignis)
    {
        var datei = ereignis.File;

        // Ein Anhängen, das schon läuft, gehört dem, der es ausgelöst hat: weder seine Bytes noch
        // seine Meldung fasst ein zweiter Vorgang an. Über die Fläche entsteht dieser Fall nicht,
        // weil sie so lange gesperrt ist; wer sie umgeht, bekommt trotzdem seine Meldung.
        var laufendeDatei = _laufendeDatei;
        if (laufendeDatei is not null)
        {
            _anhangmeldungen.Add(Anhangausfall.Sperrmeldung(datei.Name, laufendeDatei));
            return;
        }

        _zurueckweisung = null;
        _ausfallmeldung = null;
        _anhangmeldungen.Clear();

        // Der Zustand entsteht **vor** dem ersten await und wird sofort gezeichnet: die Sperre
        // muss den Browser erreichen, bevor die Übertragung beginnt, sonst steht das Feld im
        // entscheidenden Moment noch offen.
        _laufendeDatei = datei.Name;
        StateHasChanged();
        try
        {
            await HaengeAn(datei);
        }
        catch (JSException)
        {
            // Der abgerissene Dateistrom ist keine HttpRequestException, sondern die Antwort des
            // Browsers auf eine Datei-Nummer, die er nicht mehr kennt. Ohne diesen Fangpunkt
            // stürbe der Vorgang lautlos, und die Datei wäre ohne jede Spur verschwunden.
            _anhangmeldungen.Add(Anhangausfall.Abbruchmeldung(datei.Name));
        }
        finally
        {
            // Auf jedem Ausgang wieder frei — Erfolg, Zurückweisung, Größenwächter und Abbruch
            // gleichermaßen. Eine Fläche, die nach einem Fehler gesperrt bleibt, tauschte den
            // Datenverlust gegen eine unbedienbare Seite.
            _laufendeDatei = null;
        }
    }

    private async Task HaengeAn(IBrowserFile datei)
    {
        _urheber = await GewaehlterUrheber();
        if (_urheber is null)
        {
            return;
        }

        // Der Waechter vor dem Strom, mit **derselben** Konstante wie Validator und Route: ohne ihn
        // wirft OpenReadStream, und statt einer lesbaren Meldung bekäme der Mensch einen
        // abgerissenen Kreislauf zu sehen. Die Regel selbst liegt weiter in der WebApi — sie gilt
        // auch für den Agenten, der hier gar nicht vorbeikommt.
        var dieDateiIstZuGross = datei.Size > Anhangsgrenze.HoechsteDateigroesse;
        if (dieDateiIstZuGross)
        {
            _ausfallmeldung = $"„{datei.Name}“ ist {Dateigroesseform.AlsText(datei.Size)} groß; höchstens {Dateigroesseform.AlsText(Anhangsgrenze.HoechsteDateigroesse)} sind möglich.";
            return;
        }

        _ausfallmeldung = await WebApiAufruf.MitAusfallmeldung(() => UebernimmAnhang(datei, _urheber.KontributorId));
    }

    // OpenReadStream bricht ohne Angabe schon bei 512 KB ab; die Obergrenze ist dieselbe Konstante
    // wie im Validator, an der Route und im SignalR-Kreislauf.
    // Der Strom wird im using geschlossen, sobald der Aufruf durch ist.
    private async Task UebernimmAnhang(IBrowserFile datei, long kontributorId)
    {
        await using var inhalt = datei.OpenReadStream(Anhangsgrenze.HoechsteDateigroesse);
        var ergebnis = await KartenKlient.HaengeAnhangAn(KarteId, kontributorId, datei.Name, inhalt);
        if (ergebnis.WurdeZurueckgewiesen)
        {
            // Die Liste bleibt, wie sie war: die Meldung erklärt, warum nichts dazugekommen ist.
            _zurueckweisung = ergebnis.Zurueckweisung;
            return;
        }

        _detail = ergebnis.Wert;
    }

    private async Task EntferneAnhang(Anhang anhang)
    {
        _zurueckweisung = null;
        _ausfallmeldung = await WebApiAufruf.MitAusfallmeldung(() => UebernimmEntfernung(anhang));
    }

    private async Task UebernimmEntfernung(Anhang anhang)
    {
        var ergebnis = await KartenKlient.EntferneAnhang(KarteId, anhang.AnhangId);
        if (ergebnis.WurdeZurueckgewiesen)
        {
            _zurueckweisung = ergebnis.Zurueckweisung;
            return;
        }

        _detail = ergebnis.Wert;
    }

    private string _dateiverweispfad = string.Empty;
    private ElementReference _dateiverweisfeld;

    private bool HatDateiverweise
    {
        get
        {
            return _detail!.Dateiverweise.Count > 0;
        }
    }

    // Urheber und Zeitpunkt stehen im title der Zeile und nicht als zweite Textzeile: so bleibt
    // die gezeichnete einzeilige Form, und die Zusage der Vision — an jeder Karte ist ablesbar,
    // wer gehandelt hat — wird trotzdem eingelöst. Wörtlich das Vorgehen von Anhangmeta.
    private static string Dateiverweismeta(Dateiverweis dateiverweis)
    {
        var name = dateiverweis.Urheber.Name;
        if (dateiverweis.Urheber.StillgelegtAm is not null)
        {
            name = $"{name} (stillgelegt)";
        }

        return $"{name} · {Zeitpunktform.AlsText(dateiverweis.Zeitpunkt, DateTimeOffset.Now)}";
    }

    private async Task FokussiereDateiverweisfeld()
    {
        await _dateiverweisfeld.FocusAsync();
    }

    private void TippeDateiverweis(ChangeEventArgs ereignis)
    {
        _dateiverweispfad = Text(ereignis);
    }

    // Die Eingabetaste trägt ein, was im Feld steht — der Weg ohne Zeiger, wie beim Teilaufgaben-
    // und beim Kommentarfeld. Ohne Prüfung auf einen leeren Text: die Zurückweisung ist die
    // Antwort der API, und eine zweite Leerregel in der Oberfläche wäre eine zweite Wahrheit.
    private async Task AufDateiverweistaste(KeyboardEventArgs taste)
    {
        var dieTasteTraegtEin = taste.Key == "Enter";
        if (!dieTasteTraegtEin)
        {
            return;
        }

        await TrageDateiverweisEin();
    }

    // Die Wahl wird hier ein letztes Mal gelesen und nicht aus _urheber genommen: zwischen dem
    // letzten Nachlesen und dem Tastendruck kann sie gewechselt haben, und der Dateiverweis trägt
    // dann den neuen Urheber. Muster SendeKommentar und NimmDatei.
    private async Task TrageDateiverweisEin()
    {
        _zurueckweisung = null;
        _urheber = await GewaehlterUrheber();
        if (_urheber is null)
        {
            return;
        }

        var anfrage = new DateiverweisEintragenAnfrage(_dateiverweispfad, _urheber.KontributorId);
        _ausfallmeldung = await WebApiAufruf.MitAusfallmeldung(() => UebernimmDateiverweis(anfrage));
    }

    // Nach einer Zurückweisung bleibt der getippte Pfad stehen: er ist der Grund der Meldung, und
    // die Liste bleibt, wie sie war.
    private async Task UebernimmDateiverweis(DateiverweisEintragenAnfrage anfrage)
    {
        var ergebnis = await KartenKlient.TrageDateiverweisEin(KarteId, anfrage);
        if (ergebnis.WurdeZurueckgewiesen)
        {
            _zurueckweisung = ergebnis.Zurueckweisung;
            return;
        }

        _dateiverweispfad = string.Empty;
        _detail = ergebnis.Wert;
        await LeereDateiverweisfeld();
    }

    // Das Feld bleibt nach dem Eintragen stehen, leer und unter dem Cursor: wer die Bezüge einer
    // Karte einträgt, trägt selten genau einen ein. Dieselbe Antwort wie bei der Teilaufgaben- und
    // der Kommentarzeile.
    private async Task LeereDateiverweisfeld()
    {
        await Browser.InvokeVoidAsync(ElementEigenschaftenSetzen, _dateiverweisfeld, new { value = string.Empty });
        await _dateiverweisfeld.FocusAsync();
    }

    // Die Rückmeldung hängt an **einer** Zeile: welche zuletzt kopiert wurde und wie es ausging.
    // Ein Wahrheitswert je Zeile wäre dieselbe Aussage mehrfach und ließe zwei Meldungen zu.
    private long? _zuletztKopierterDateiverweis;
    private Kopierergebnis _kopierstand;

    private bool WurdeKopiert(Dateiverweis dateiverweis)
    {
        return _zuletztKopierterDateiverweis == dateiverweis.DateiverweisId;
    }

    // Der Elementbezeichner der Pfadzeile: über ihn findet die Pfadkopie im Rückfall den
    // Textknoten, den sie markieren soll.
    private static string Pfadelement(Dateiverweis dateiverweis)
    {
        return $"dateiverweispfad-{dateiverweis.DateiverweisId}";
    }

    // Drei Ausgänge, drei Wortlaute — und keiner davon ist eine Ausnahmeseite. „markiert" ist
    // keine Fehlermeldung: der Mensch hat den Pfad ausgewählt vor sich und kann ihn von Hand
    // kopieren.
    private string Kopiermeldung
    {
        get
        {
            if (_kopierstand == Kopierergebnis.InDerZwischenablage)
            {
                return "kopiert";
            }

            if (_kopierstand == Kopierergebnis.AlsTextMarkiert)
            {
                return "markiert — von Hand kopieren";
            }

            return "nicht kopierbar — Pfad von Hand markieren";
        }
    }

    // Kopiert wird der **ganze** Pfad und nicht die gekürzte Darstellung: die Ellipse ist
    // Gestaltung, der Wert ist der Wert.
    private async Task KopierePfad(Dateiverweis dateiverweis)
    {
        _kopierstand = await Pfadkopie.Kopiere(dateiverweis.Pfad, Pfadelement(dateiverweis));
        _zuletztKopierterDateiverweis = dateiverweis.DateiverweisId;
    }

    private async Task EntferneDateiverweis(Dateiverweis dateiverweis)
    {
        _zurueckweisung = null;
        _ausfallmeldung = await WebApiAufruf.MitAusfallmeldung(() => UebernimmDateiverweisentfernung(dateiverweis));
    }

    private async Task UebernimmDateiverweisentfernung(Dateiverweis dateiverweis)
    {
        var ergebnis = await KartenKlient.EntferneDateiverweis(KarteId, dateiverweis.DateiverweisId);
        if (ergebnis.WurdeZurueckgewiesen)
        {
            _zurueckweisung = ergebnis.Zurueckweisung;
            return;
        }

        _detail = ergebnis.Wert;
    }

    private bool IstOffen(string feld)
    {
        return _offenesFeld == feld;
    }

    private void Oeffne(string feld)
    {
        _offenesFeld = feld;
    }

    // Der Wert des Datumsfeldes ist derselbe ISO-Text, den der Terminformatierer anzeigt —
    // kein zweites Datumsformat in der Anwendung.
    private string Terminwert
    {
        get
        {
            if (_detail!.Karte.FaelligAm is null)
            {
                return string.Empty;
            }

            return Terminformatierer.AlsText(_detail.Karte.FaelligAm);
        }
    }

    private string Gewaehltklasse(Kartenfarbe farbe)
    {
        if (farbe == _detail!.Karte.Farbe)
        {
            return "farbpunkt-gewaehlt";
        }

        return string.Empty;
    }

    private static string AlsAttributtext(bool wert)
    {
        if (wert)
        {
            return "true";
        }

        return "false";
    }

    private async Task SetzeTitel(ChangeEventArgs ereignis)
    {
        await Speichere(_detail! with { Karte = _detail.Karte with { Titel = Text(ereignis) } });
    }

    private async Task SetzeBeschreibung(ChangeEventArgs ereignis)
    {
        await Speichere(_detail! with { Karte = _detail.Karte with { Beschreibung = AlsBeschreibung(Text(ereignis)) } });
    }

    // Ein geleertes Datumsfeld reist als null, nicht als leerer Text — den wiese
    // System.Text.Json ab (DateOnlyEingabeProbeTests).
    private async Task SetzeFaelligkeit(ChangeEventArgs ereignis)
    {
        await Speichere(_detail! with { Karte = _detail.Karte with { FaelligAm = AlsTermin(Text(ereignis)) } });
    }

    private async Task SetzeFarbe(Kartenfarbe farbe)
    {
        await Speichere(_detail! with { Karte = _detail.Karte with { Farbe = farbe } });
    }

    private static string Text(ChangeEventArgs ereignis)
    {
        return ereignis.Value?.ToString() ?? string.Empty;
    }

    private static string? AlsBeschreibung(string text)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            return null;
        }

        return text;
    }

    private static DateOnly? AlsTermin(string text)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            return null;
        }

        return DateOnly.Parse(text, CultureInfo.InvariantCulture);
    }

    // Gespeichert wird je Feld, sobald es verlassen oder gewählt ist — nicht gesammelt. Das
    // Artboard zeichnet keinen Speicherknopf, und ein Zwischenstand, den ein Reload verlöre,
    // stünde gegen „nach Reload da". Die Anfrage trägt trotzdem alle Felder, weil sie so
    // geschnitten ist; abgesetzt wird sie nur für das eine Feld, das sich geändert hat.
    private async Task Speichere(KanbanC.Contracts.Karten.Kartendetail gewuenscht)
    {
        _offenesFeld = null;
        _zurueckweisung = null;
        var anfrage = new KarteAendernAnfrage(
            gewuenscht.Karte.Titel,
            gewuenscht.Karte.Beschreibung,
            gewuenscht.Karte.FaelligAm,
            gewuenscht.Karte.Farbe,
            gewuenscht.Karte.Kontributor);
        _ausfallmeldung = await WebApiAufruf.MitAusfallmeldung(() => UebernimmAenderung(anfrage));
    }

    // Nach einer Zurückweisung bleibt _detail unangetastet: die vorige Fassung steht weiter da,
    // und gespeichert wurde nichts.
    private async Task UebernimmAenderung(KarteAendernAnfrage anfrage)
    {
        var ergebnis = await KartenKlient.AendereKarte(KarteId, anfrage);
        if (ergebnis.WurdeZurueckgewiesen)
        {
            _zurueckweisung = ergebnis.Zurueckweisung;
            return;
        }

        _detail = ergebnis.Wert;
    }

    // Die Zurückweisung wird nicht angezeigt, sondern nur ausgewertet: die Seite kennt ihre
    // eigene Nummer und sagt dasselbe wie Board.razor. Der Befund der API bleibt dem Agenten.
    private async Task LadeKartendetail()
    {
        var ergebnis = await KartenKlient.LadeKartendetail(KarteId);
        if (ergebnis.WurdeZurueckgewiesen)
        {
            _detail = null;
            return;
        }

        _detail = ergebnis.Wert;
    }
}
