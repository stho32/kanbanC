@page "/auswertungen"
@using System.Globalization
@using KanbanC.Blazor.Components.Auswertungen
@using KanbanC.Blazor.Services
@using KanbanC.Contracts.Auswertungen
@using KanbanC.Contracts.Boards
@using KanbanC.Contracts.Fehler
@using KanbanC.Contracts.Klassen
@inject BoardApiKlient BoardKlient
@inject KartenklassenApiKlient KartenklassenKlient
@inject AuswertungenApiKlient AuswertungenKlient
@inject WebApibasisadresse WebApibasis

<PageTitle>Auswertungen</PageTitle>

<SectionContent SectionName="kopfzeile-kontext">
    <h1 class="kopfzeile-titel">Auswertungen</h1>
</SectionContent>

<div class="auswertungsflaeche">
    @* Der Umschalter links kommt ohne Abruf aus und bleibt deshalb auch bei einem Ausfall stehen:
       ein Schirm, der bei einem Ausfall verschwindet, sagt weniger als einer, der stehen bleibt.
       Die Liste wächst mit — eine sechste Auswertung ist ein Eintrag mehr, kein Umbau. *@
    <nav class="auswertungsliste" id="auswertungsliste" aria-label="Auswertung">
        <p class="auswertungsliste-titel">Auswertung</p>
        @foreach (var waehlbare in Gebaut)
        {
            <button type="button"
                    class="auswertungspunkt @AktivklasseFuer(waehlbare.Wahl)"
                    id="@($"auswertung-{waehlbare.Kennung}")"
                    aria-current="@Aktivmarke(waehlbare.Wahl)"
                    @onclick="() => WaehleAuswertung(waehlbare.Wahl)">@waehlbare.Beschriftung</button>
        }
        @foreach (var kuenftige in NochNichtGebaut)
        {
            <span class="auswertungspunkt auswertungspunkt-gesperrt"
                  id="@($"auswertung-{kuenftige.Kennung}")"
                  aria-disabled="true"
                  title="Noch nicht verfügbar">@kuenftige.Beschriftung</span>
        }
    </nav>

    <section class="auswertungsblatt">
        <div class="seitenkopf">
            <h2 class="auswertungstitel" id="auswertungstitel">@Titel()</h2>
        </div>

        @* Board und Kartenklasse sind für beide Auswertungen derselbe Bestand: ein Wechsel der
           Auswertung wirft die Wahl nicht weg. *@
        <div class="bestandswahl" id="bestandswahl">
            <div class="field">
                <label for="auswertung-board">Board</label>
                <select id="auswertung-board" class="input" @onchange="WaehleBoard" value="@_gewaehltesBoard">
                    <option value="">Board wählen …</option>
                    @foreach (var board in _boards)
                    {
                        <option value="@board.BoardId">@board.Name</option>
                    }
                </select>
            </div>
            <div class="field">
                <label for="auswertung-kartenklasse">Kartenklasse</label>
                <select id="auswertung-kartenklasse" class="input" @onchange="WaehleKartenklasse" value="@_gewaehlteKartenklasse" disabled="@(_kartenklassen.Count == 0)">
                    <option value="">Kartenklasse wählen …</option>
                    @foreach (var kartenklasse in _kartenklassen)
                    {
                        <option value="@kartenklasse.KartenklasseId">@kartenklasse.Name (@kartenklasse.Praefix)</option>
                    }
                </select>
            </div>
            @if (_gewaehlteAuswertung == Auswertungswahl.Burndown)
            {
                @* Nur ein Beginn: das Ende ist immer heute, und ein zweites Feld dafür wäre eine
                   Bedienfrage ohne Nutzen. *@
                <div class="field">
                    <label for="auswertung-seit">Beginn</label>
                    <input id="auswertung-seit" class="input" type="date" value="@Beginnwert()" @onchange="WaehleZeitraum" />
                </div>
            }
            @if (_gewaehlteAuswertung == Auswertungswahl.Zeitexport)
            {
                @* Zwei Grenzen statt der einen des Burndowns: eine Exportdatei ist ein Dokument
                   über eine abgeschlossene Spanne. Beide dürfen leer bleiben. *@
                <div class="field">
                    <label for="auswertung-von">von</label>
                    <input id="auswertung-von" class="input" type="date" value="@Tageswert(_von)" @onchange="WaehleVon" />
                </div>
                <div class="field">
                    <label for="auswertung-bis">bis</label>
                    <input id="auswertung-bis" class="input" type="date" value="@Tageswert(_bis)" @onchange="WaehleBis" />
                </div>
            }
        </div>

        @if (_ausfallmeldung is not null)
        {
            <div class="meldung" role="alert" id="auswertung-fehlermeldung">@_ausfallmeldung</div>
        }

        @if (_zurueckweisung is not null)
        {
            <div class="meldung meldung-abweisung" role="alert" id="auswertung-zurueckweisung">
                <p>Die Auswertung wurde nicht gerechnet:</p>
                <ul>
                    @foreach (var befund in _zurueckweisung.Befunde)
                    {
                        <li>@befund.Meldung <span class="auswertungskompensation">@befund.Kompensation</span></li>
                    }
                </ul>
            </div>
        }

        @if (BestandIstUngewaehlt)
        {
            <p class="auswertungshinweis" id="auswertung-ohne-bestand">
                Board und Kartenklasse sind zusammen der Kartenbestand. Wähle beide, und die Tabelle steht.
            </p>
        }
        else if (_boardFuehrtKeineKartenklasse)
        {
            <p class="auswertungshinweis" id="auswertung-ohne-kartenklasse">
                Für dieses Board gibt es nichts auszuwerten: es führt keine Kartenklasse. Lege im Layout-Modus eine an
                oder wähle oben ein Board, das eine hat.
            </p>
        }
        else if (BestandIstLeer)
        {
            <p class="auswertungshinweis" id="auswertung-leer">
                Dieser Kartenbestand führt keine Karte. Fahre eine WBS-Datei ein oder ordne Karten dieser Klasse zu.
            </p>
        }
        else if (_sollIst is not null)
        {
            <SollIstTabelle Auswertung="_sollIst" />
        }
        else if (_burndown is not null)
        {
            <Burndownflaeche Auswertung="_burndown" />
        }
        else if (_zeitexportstand is not null)
        {
            <Zeitexportflaeche Stand="_zeitexportstand" Verweisadresse="@Zeitexportverweis()" Von="_von" Bis="_bis" />
        }

        @* Derselbe Weg für einen Agenten — die einzige Stelle, an der die API im Schirm sichtbar
           wird; er folgt der gewählten Auswertung. *@
        <div class="auswertungsaufruf" id="auswertung-aufruf">
            <span class="auswertungsaufruf-titel">Derselbe Weg für einen Agenten</span>
            <pre class="auswertungsaufruf-text">@Aufruf()</pre>
        </div>
    </section>
</div>

@code {
    private const string Isodatumsformat = "yyyy-MM-dd";

    private static readonly Gebauteauswertung[] Gebaut =
    [
        new(Auswertungswahl.SollIst, "soll-ist", "Soll-Ist gegen die WBS"),
        new(Auswertungswahl.Burndown, "burndown", "Burndown"),
        new(Auswertungswahl.Zeitexport, "zeitexport", "Zeiten exportieren"),
    ];

    // Die zwei übrigen Auswertungen des Dialogs stehen gesperrt daneben: sie sind bestellt und
    // noch nicht gebaut, und eine Fläche, die sie verschweigt, sähe vollständig aus.
    private static readonly Kuenftigeauswertung[] NochNichtGebaut =
    [
        new("puffer", "Puffer-Verbrauch"),
        new("rohdaten", "Rohdaten über die API"),
    ];

    private IReadOnlyList<BoardUebersicht> _boards = [];
    private IReadOnlyList<Kartenklasse> _kartenklassen = [];
    private Auswertungswahl _gewaehlteAuswertung = Auswertungswahl.SollIst;
    private long? _gewaehltesBoard;
    private long? _gewaehlteKartenklasse;
    private DateOnly? _seit;
    private DateOnly? _von;
    private DateOnly? _bis;
    private SollIstAuswertung? _sollIst;
    private Burndownauswertung? _burndown;
    private Zeitexportstand? _zeitexportstand;
    private Zurueckweisung? _zurueckweisung;
    private string? _ausfallmeldung;
    private bool _boardFuehrtKeineKartenklasse;

    // Ohne beide Hälften gibt es keinen Kartenbestand — und ohne Bestand nichts zu rechnen.
    private bool BestandIstUngewaehlt => _gewaehltesBoard is null || (_gewaehlteKartenklasse is null && !_boardFuehrtKeineKartenklasse);

    private bool BestandIstLeer => (_sollIst is not null && _sollIst.Zeilen.Count == 0) || (_burndown is not null && _burndown.Kopfzahlen.ImBestand == 0);

    protected override async Task OnInitializedAsync()
    {
        await LadeBoards();
    }

    private async Task LadeBoards()
    {
        _ausfallmeldung = await WebApiAufruf.MitAusfallmeldung(async () => _boards = await BoardKlient.LadeAlleBoards(new Archivierung(false)));
    }

    // Der Bestand bleibt stehen, nur die Auswertung wechselt — und der Zeitraum gilt jeweils neu.
    private async Task WaehleAuswertung(Auswertungswahl wahl)
    {
        _gewaehlteAuswertung = wahl;
        VergissZeitraum();
        VergissAuswertung();
        var derBestandStehtSchon = _gewaehltesBoard is not null && _gewaehlteKartenklasse is not null;
        if (derBestandStehtSchon)
        {
            await LadeAuswertung();
        }
    }

    private async Task WaehleBoard(ChangeEventArgs ereignis)
    {
        _gewaehltesBoard = Nummer(ereignis.Value);
        _gewaehlteKartenklasse = null;
        _kartenklassen = [];
        VergissZeitraum();
        VergissAuswertung();
        _boardFuehrtKeineKartenklasse = false;
        if (_gewaehltesBoard is null)
        {
            return;
        }

        await LadeKartenklassen(_gewaehltesBoard.Value);
    }

    // Führt das Board genau eine Kartenklasse, ist der Bestand damit entschieden — eine Wahl mit
    // einem Eintrag ist keine Wahl, sondern ein zusätzlicher Klick.
    private async Task LadeKartenklassen(long boardId)
    {
        _ausfallmeldung = await WebApiAufruf.MitAusfallmeldung(async () =>
        {
            var ergebnis = await KartenklassenKlient.LadeKartenklassen(boardId);
            if (ergebnis.WurdeZurueckgewiesen)
            {
                _zurueckweisung = ergebnis.Zurueckweisung;
                return;
            }

            _kartenklassen = ergebnis.Wert;
        });
        _boardFuehrtKeineKartenklasse = _ausfallmeldung is null && _zurueckweisung is null && _kartenklassen.Count == 0;
        var esGibtGenauEineKartenklasse = _kartenklassen.Count == 1;
        if (esGibtGenauEineKartenklasse)
        {
            _gewaehlteKartenklasse = _kartenklassen[0].KartenklasseId;
            await LadeAuswertung();
        }
    }

    private async Task WaehleKartenklasse(ChangeEventArgs ereignis)
    {
        _gewaehlteKartenklasse = Nummer(ereignis.Value);
        VergissZeitraum();
        VergissAuswertung();
        if (_gewaehlteKartenklasse is null)
        {
            return;
        }

        await LadeAuswertung();
    }

    private async Task WaehleZeitraum(ChangeEventArgs ereignis)
    {
        _seit = Tag(ereignis.Value);
        await LadeWennDerBestandSteht();
    }

    // Eine Änderung an einer Grenze lässt Zahlen, Dateiname und Verweis folgen — über einen
    // erneuten Abruf des Stands, nicht über eine zweite Rechnung im Schirm.
    // Eine verdrehte Spanne wird **nicht** hier geprüft: sie kommt als Zurückweisung der API
    // zurück, sonst stünde dieselbe Regel an zwei Stellen.
    private async Task WaehleVon(ChangeEventArgs ereignis)
    {
        _von = Tag(ereignis.Value);
        await LadeWennDerBestandSteht();
    }

    private async Task WaehleBis(ChangeEventArgs ereignis)
    {
        _bis = Tag(ereignis.Value);
        await LadeWennDerBestandSteht();
    }

    private async Task LadeWennDerBestandSteht()
    {
        var derBestandStehtSchon = _gewaehltesBoard is not null && _gewaehlteKartenklasse is not null;
        if (derBestandStehtSchon)
        {
            await LadeAuswertung();
        }
    }

    private async Task LadeAuswertung()
    {
        if (_gewaehlteAuswertung == Auswertungswahl.Burndown)
        {
            await LadeBurndown();
            return;
        }

        if (_gewaehlteAuswertung == Auswertungswahl.Zeitexport)
        {
            await LadeZeitexportstand();
            return;
        }

        await LadeSollIst();
    }

    private async Task LadeSollIst()
    {
        _ausfallmeldung = await WebApiAufruf.MitAusfallmeldung(async () =>
        {
            var ergebnis = await AuswertungenKlient.LadeSollIst(_gewaehltesBoard!.Value, _gewaehlteKartenklasse!.Value);
            if (ergebnis.WurdeZurueckgewiesen)
            {
                _zurueckweisung = ergebnis.Zurueckweisung;
                _sollIst = null;
                return;
            }

            _sollIst = ergebnis.Wert;
        });
    }

    private async Task LadeBurndown()
    {
        _ausfallmeldung = await WebApiAufruf.MitAusfallmeldung(async () =>
        {
            var ergebnis = await AuswertungenKlient.LadeBurndown(_gewaehltesBoard!.Value, _gewaehlteKartenklasse!.Value, _seit);
            if (ergebnis.WurdeZurueckgewiesen)
            {
                _zurueckweisung = ergebnis.Zurueckweisung;
                _burndown = null;
                return;
            }

            _burndown = ergebnis.Wert;
        });
    }

    private async Task LadeZeitexportstand()
    {
        _ausfallmeldung = await WebApiAufruf.MitAusfallmeldung(async () =>
        {
            var ergebnis = await AuswertungenKlient.LadeZeitexportstand(_gewaehltesBoard!.Value, _gewaehlteKartenklasse!.Value, _von, _bis);
            if (ergebnis.WurdeZurueckgewiesen)
            {
                _zurueckweisung = ergebnis.Zurueckweisung;
                _zeitexportstand = null;
                return;
            }

            _zurueckweisung = null;
            _zeitexportstand = ergebnis.Wert;
        });
    }

    private void VergissAuswertung()
    {
        _sollIst = null;
        _burndown = null;
        _zeitexportstand = null;
        _zurueckweisung = null;
    }

    private void VergissZeitraum()
    {
        _seit = null;
        _von = null;
        _bis = null;
    }

    private string Titel()
    {
        if (_gewaehlteAuswertung == Auswertungswahl.Burndown)
        {
            return "Burndown über Kalendertage";
        }

        if (_gewaehlteAuswertung == Auswertungswahl.Zeitexport)
        {
            return "Zeiten exportieren";
        }

        return "Soll-Ist gegen die WBS-Zählung";
    }

    // Ohne eigene Wahl zeigt das Feld den ersten Tag der gelieferten Achse — den frühesten
    // Erledigungstag des Bestands.
    private string Beginnwert()
    {
        if (_seit is not null)
        {
            return _seit.Value.ToString(Isodatumsformat, CultureInfo.InvariantCulture);
        }

        if (_burndown is not null && _burndown.Tage.Count > 0)
        {
            return _burndown.Tage[0].Tag.ToString(Isodatumsformat, CultureInfo.InvariantCulture);
        }

        return string.Empty;
    }

    private string Aufruf()
    {
        var boardId = Platzhalter(_gewaehltesBoard, "{boardId}");
        var kartenklasseId = Platzhalter(_gewaehlteKartenklasse, "{kartenklasseId}");
        if (_gewaehlteAuswertung == Auswertungswahl.Burndown)
        {
            return $"GET /api/boards/{boardId}/kartenklassen/{kartenklasseId}/burndown{Zeitraumabfrage()}";
        }

        if (_gewaehlteAuswertung == Auswertungswahl.Zeitexport)
        {
            return $"GET /api/boards/{boardId}/kartenklassen/{kartenklasseId}/zeitexport.csv{Zeitexportadresse.Zeitraumabfrage(_von, _bis)}";
        }

        return $"GET /api/boards/{boardId}/kartenklassen/{kartenklasseId}/soll-ist";
    }

    // Der Verweis ist nichts als die Adresse, die ein Agent ohnehin ruft — absolut und direkt auf
    // die WebApi.
    private string Zeitexportverweis()
    {
        return Zeitexportadresse.Fuer(WebApibasis.Adresse, _gewaehltesBoard!.Value, _gewaehlteKartenklasse!.Value, _von, _bis);
    }

    private string Zeitraumabfrage()
    {
        var beginn = Beginnwert();
        if (string.IsNullOrEmpty(beginn))
        {
            return string.Empty;
        }

        return $"?seit={beginn}";
    }

    private string AktivklasseFuer(Auswertungswahl wahl)
    {
        if (_gewaehlteAuswertung == wahl)
        {
            return "auswertungspunkt-aktiv";
        }

        return "";
    }

    // Ein leerer Wert gilt in ARIA als „nicht aktuell" — die Marke steht deshalb als Text da oder
    // gar nicht.
    private string? Aktivmarke(Auswertungswahl wahl)
    {
        if (_gewaehlteAuswertung == wahl)
        {
            return "true";
        }

        return null; // stil-check: C25 kein Wert heisst „dieser Punkt ist nicht der aktuelle"
    }

    private static string Platzhalter(long? nummer, string platzhalter)
    {
        if (nummer is null)
        {
            return platzhalter;
        }

        return nummer.Value.ToString(CultureInfo.InvariantCulture);
    }

    private static long? Nummer(object? wert)
    {
        var text = wert?.ToString();
        if (string.IsNullOrEmpty(text))
        {
            return null;
        }

        return long.Parse(text, CultureInfo.InvariantCulture);
    }

    private static DateOnly? Tag(object? wert)
    {
        var text = wert?.ToString();
        if (string.IsNullOrEmpty(text))
        {
            return null;
        }

        return DateOnly.ParseExact(text, Isodatumsformat, CultureInfo.InvariantCulture);
    }

    private static string Tageswert(DateOnly? grenze)
    {
        if (grenze is null)
        {
            return string.Empty;
        }

        return grenze.Value.ToString(Isodatumsformat, CultureInfo.InvariantCulture);
    }

    private enum Auswertungswahl
    {
        SollIst,
        Burndown,
        Zeitexport,
    }

    private sealed record Gebauteauswertung(Auswertungswahl Wahl, string Kennung, string Beschriftung);

    private sealed record Kuenftigeauswertung(string Kennung, string Beschriftung);
}
