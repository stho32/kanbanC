@page "/boards/{BoardId:long}"
@using KanbanC.Blazor.Components.Karten
@using KanbanC.Blazor.Services
@using KanbanC.Contracts.Boards
@using KanbanC.Contracts.Fehler
@using KanbanC.Contracts.Karten
@inject BoardApiKlient ApiKlient
@inject KartenApiKlient KartenKlient

<PageTitle>Board @BoardId</PageTitle>

@if (_webApiIstNichtErreichbar)
{
    <div class="meldung" role="alert" id="fehlermeldung">
        <p>@WebApiAusfall.Meldung</p>
        <a href="/boards" id="zur-board-liste">Zurück zur Board-Liste</a>
    </div>
}
else if (!_ladenIstAbgeschlossen)
{
    <p>Das Board wird geladen …</p>
}
else if (_board is null)
{
    <div class="meldung" role="alert" id="board-unbekannt">
        <p>Ein Board mit der Nummer @BoardId gibt es nicht.</p>
        <a href="/boards" id="zur-board-liste">Zurück zur Board-Liste</a>
    </div>
}
else
{
    @* Die Kopfdaten sitzen in der Navigationszeile: das Board bekommt die volle Hoehe. *@
    <SectionContent SectionName="kopfzeile-kontext">
        <a href="/boards" id="zur-board-liste" class="board-zurueck" title="Zurück zu den Boards">←</a>
        <h1 id="board-name" class="board-name">@_board.Name</h1>
        <span class="tag tag-accent" id="board-art">@_board.Art</span>
        <span class="board-termine">
            Start <span id="board-starttermin">@Terminformatierer.AlsText(_board.Starttermin)</span>
            · Ziel <span id="board-zieltermin">@Terminformatierer.AlsText(_board.Zieltermin)</span>
        </span>
    </SectionContent>

    <SectionContent SectionName="kopfzeile-bedienung">
        @* Ein Kontrollfeld, kein Knopf: die Kartenzahl ist ein Zustand des Boards, der stehen
           bleibt, keine Handlung. Es steht links vom Layout-Schalter — erst ansehen, dann umbauen. *@
        <label class="kontrollfeld" for="kartenzahl-schalter">
            <input id="kartenzahl-schalter"
                   type="checkbox"
                   checked="@_kartenzahlIstEingeschaltet"
                   @onchange="SchalteKartenzahl" />
            Kartenzahl
        </label>
        @if (_layoutModusIstAktiv)
        {
            <button type="button" class="btn btn-haupt btn-symbol" id="layout-fertig" title="Layout fertig" @onclick="VerlasseLayoutModus">✓</button>
        }
        else
        {
            <button type="button" class="btn btn-schlicht btn-symbol" id="layout-bearbeiten" title="Layout bearbeiten" @onclick="BetreteLayoutModus">✎</button>
        }
    </SectionContent>

    <div class="boardflaeche">
        @if (_kartenzahlFehlermeldung is not null)
        {
            <div class="meldung" role="alert" id="kartenzahl-fehlermeldung">@_kartenzahlFehlermeldung</div>
        }
        @if (_zugFehlermeldung is not null)
        {
            <div class="meldung" role="alert" id="karte-fehlermeldung">@_zugFehlermeldung</div>
        }
        @if (_zugZurueckweisung is not null)
        {
            <div class="meldung meldung-abweisung" role="alert" id="karte-zurueckweisung">
                <ul>
                    @foreach (var befund in _zugZurueckweisung.Befunde)
                    {
                        <li>@befund.Meldung</li>
                    }
                </ul>
            </div>
        }
        @if (_layoutModusIstAktiv)
        {
            <Spaltenpflege BoardId="BoardId" Spalten="_board.Spalten" SpaltenHabenSichGeaendert="LadeBoard" />
        }
        else
        {
            <Spaltenbahnen BoardId="BoardId"
                           Spalten="_board.Spalten"
                           KarteWurdeAngelegt="LadeBoard"
                           KarteWurdeAbgelegt="LegeKarteAb" />
        }
    </div>
}

@code {
    // Vollqualifiziert, weil der Komponentenname Board den gleichnamigen Vertragstyp verdeckt.
    private KanbanC.Contracts.Boards.Board? _board;
    private bool _ladenIstAbgeschlossen;
    private bool _webApiIstNichtErreichbar;

    // Der Layout-Modus ist bewusst Zustand der Komponente und nicht der Adresse: ein Reload
    // soll in der Arbeitsansicht landen (R00004).
    private bool _layoutModusIstAktiv;
    private Zurueckweisung? _zugZurueckweisung;
    private string? _zugFehlermeldung;

    // Der Zustand des Kontrollfelds wird mitgeführt, statt am Board abgelesen zu werden: nur so
    // steht es nach einem gescheiterten Umschalten wieder auf dem Stand des Boards. Der Browser
    // hat das Häkchen dann schon umgelegt, und ein unveränderter Wert erzeugt keinen Diff.
    private bool _kartenzahlIstEingeschaltet;
    private string? _kartenzahlFehlermeldung;

    [Parameter]
    public long BoardId { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        _ladenIstAbgeschlossen = false;
        try
        {
            await LadeBoard();
            _webApiIstNichtErreichbar = false;
        }
        catch (HttpRequestException)
        {
            _webApiIstNichtErreichbar = true;
        }

        _ladenIstAbgeschlossen = true;
    }

    private void BetreteLayoutModus()
    {
        _layoutModusIstAktiv = true;
    }

    private void VerlasseLayoutModus()
    {
        _layoutModusIstAktiv = false;
    }

    private async Task LegeKarteAb(Kartenablage ablage)
    {
        _zugFehlermeldung = await WebApiAufruf.MitAusfallmeldung(() => VerschiebeKarte(ablage));
    }

    private async Task VerschiebeKarte(Kartenablage ablage)
    {
        // Zuerst räumen, dann rufen: bricht der Aufruf mit einer Ausfallmeldung ab, stünde die
        // Zurückweisung des vorigen Zugs sonst daneben und behauptete einen Grund, der nicht gilt.
        _zugZurueckweisung = null;

        var lage = new Kartenlage(ablage.SpalteId, ablage.Position);
        var ergebnis = await KartenKlient.VerschiebeKarte(BoardId, ablage.KarteId, lage);
        if (ergebnis.WurdeZurueckgewiesen)
        {
            _zugZurueckweisung = ergebnis.Zurueckweisung;
        }

        // Auch nach einer Zurückweisung wird neu geladen: die Bahnen zeigen danach den Stand der
        // API. Die Karte bewegt sich dabei nicht zurück — sie hat ihren Platz nie verlassen, denn
        // gezogen wird ohne optimistische Vorwegnahme.
        await LadeBoard();
    }

    private async Task SchalteKartenzahl(ChangeEventArgs ereignis)
    {
        var gewuenschterWert = ereignis.Value is true;
        _kartenzahlIstEingeschaltet = gewuenschterWert;
        _kartenzahlFehlermeldung = await WebApiAufruf.MitAusfallmeldung(() => SetzeKartenzahl(gewuenschterWert));
        var dieWebApiWarNichtErreichbar = _kartenzahlFehlermeldung is not null;
        if (dieWebApiWarNichtErreichbar)
        {
            _kartenzahlIstEingeschaltet = _board is not null && _board.ZeigtKartenzahl;
        }
    }

    private async Task SetzeKartenzahl(bool zeigtKartenzahl)
    {
        await ApiKlient.SchalteKartenzahl(BoardId, new Kartenzahlanzeige(zeigtKartenzahl));
        await LadeBoard();
    }

    private async Task LadeBoard()
    {
        _board = await ApiKlient.LadeBoard(BoardId);
        _kartenzahlIstEingeschaltet = _board is not null && _board.ZeigtKartenzahl;
    }
}
