@page "/boards/{BoardId:long}"
@using KanbanC.Blazor.Components.Karten
@using KanbanC.Blazor.Components.Klassen
@using KanbanC.Blazor.Services
@using KanbanC.Contracts.Boards
@using KanbanC.Contracts.Ereignisse
@using KanbanC.Contracts.Fehler
@using KanbanC.Contracts.Karten
@using KanbanC.Contracts.Kontributoren
@implements IDisposable
@inject BoardApiKlient ApiKlient
@inject KartenApiKlient KartenKlient
@inject KontributorenApiKlient KontributorenKlient
@inject Identitaetsspeicher Identitaetsspeicher
@inject Ereignisverteiler Ereignisverteiler
@inject Markenstandzeit Markenstandzeit

<PageTitle>Board @BoardId</PageTitle>

@if (_webApiIstNichtErreichbar)
{
    <div class="meldung" role="alert" id="fehlermeldung">
        <p>@WebApiAusfall.Meldung</p>
        <a href="/boards" id="zur-board-liste">Zurück zur Board-Liste</a>
    </div>
}
else if (!_ladenIstAbgeschlossen)
{
    <p>Das Board wird geladen …</p>
}
else if (_board is null)
{
    <div class="meldung" role="alert" id="board-unbekannt">
        <p>Ein Board mit der Nummer @BoardId gibt es nicht.</p>
        <a href="/boards" id="zur-board-liste">Zurück zur Board-Liste</a>
    </div>
}
else
{
    @* Die Kopfdaten sitzen in der Navigationszeile: das Board bekommt die volle Hoehe. *@
    <SectionContent SectionName="kopfzeile-kontext">
        <a href="/boards" id="zur-board-liste" class="board-zurueck" title="Zurück zu den Boards">←</a>
        <h1 id="board-name" class="board-name">@_board.Name</h1>
        <span class="tag tag-accent" id="board-art">@_board.Art</span>
        <span class="board-termine">
            Start <span id="board-starttermin">@Terminformatierer.AlsText(_board.Starttermin)</span>
            · Ziel <span id="board-zieltermin">@Terminformatierer.AlsText(_board.Zieltermin)</span>
        </span>
    </SectionContent>

    <SectionContent SectionName="kopfzeile-bedienung">
        @* Ein Kontrollfeld, kein Knopf: die Kartenzahl ist ein Zustand des Boards, der stehen
           bleibt, keine Handlung. *@
        <label class="kontrollfeld" for="kartenzahl-schalter">
            <input id="kartenzahl-schalter"
                   type="checkbox"
                   checked="@_kartenzahlIstEingeschaltet"
                   @onchange="SchalteKartenzahl" />
            Kartenzahl
        </label>
        @if (_layoutModusIstAktiv)
        {
            <button type="button" class="btn btn-haupt btn-symbol" id="layout-fertig" title="Layout fertig" @onclick="VerlasseLayoutModus">✓</button>
        }
        else
        {
            <button type="button" class="btn btn-schlicht btn-symbol" id="layout-bearbeiten" title="Layout bearbeiten" @onclick="BetreteLayoutModus">✎</button>
        }
    </SectionContent>

    <div class="boardflaeche">
        @if (_kartenzahlFehlermeldung is not null)
        {
            <div class="meldung" role="alert" id="kartenzahl-fehlermeldung">@_kartenzahlFehlermeldung</div>
        }
        @if (_zugFehlermeldung is not null)
        {
            <div class="meldung" role="alert" id="karte-fehlermeldung">@_zugFehlermeldung</div>
        }
        @if (_zugZurueckweisung is not null)
        {
            <div class="meldung meldung-abweisung" role="alert" id="karte-zurueckweisung">
                <ul>
                    @foreach (var befund in _zugZurueckweisung.Befunde)
                    {
                        <li>@befund.Meldung</li>
                    }
                </ul>
            </div>
        }
        @if (_layoutModusIstAktiv)
        {
            <Spaltenpflege BoardId="BoardId" Spalten="_board.Spalten" SpaltenHabenSichGeaendert="LadeBoard" />
            <Klassenpflege BoardId="BoardId" />
        }
        else
        {
            <Spaltenbahnen BoardId="BoardId"
                           Spalten="_board.Spalten"
                           ZeigtKartenzahl="_board.ZeigtKartenzahl"
                           LaufendeZeiteintraege="_board.LaufendeZeiteintraege"
                           GewaehlteKontributorId="_gewaehlteKontributorId"
                           Einflugmarken="_einflugmarken"
                           WartendeAenderungen="_zurueckgehalteneEreignisse.Count"
                           ZugWurdeBegonnen="BeginneZug"
                           ZugWurdeBeendet="BeendeZug"
                           KarteWurdeAngelegt="LadeBoard"
                           KarteWurdeAbgelegt="LegeKarteAb"
                           SpaltenWurdenGeliefert="UebernimmSpalten" />
        }
    </div>
}

@code {
    // Vollqualifiziert, weil der Komponentenname Board den gleichnamigen Vertragstyp verdeckt.
    private KanbanC.Contracts.Boards.Board? _board;
    private bool _ladenIstAbgeschlossen;
    private bool _webApiIstNichtErreichbar;

    // Der Layout-Modus ist bewusst Zustand der Komponente und nicht der Adresse: ein Reload
    // soll in der Arbeitsansicht landen (R00004).
    private bool _layoutModusIstAktiv;
    private Zurueckweisung? _zugZurueckweisung;
    private string? _zugFehlermeldung;

    // Der Zustand des Kontrollfelds wird mitgeführt, statt am Board abgelesen zu werden: nur so
    // steht es nach einem gescheiterten Umschalten wieder auf dem Stand des Boards. Der Browser
    // hat das Häkchen dann schon umgelegt, und ein unveränderter Wert erzeugt keinen Diff.
    private bool _kartenzahlIstEingeschaltet;
    private string? _kartenzahlFehlermeldung;

    // Die Wahl der Kopfzeile, gelesen ueber denselben Dienst wie dort: er ist AddScoped und je
    // Blazor-Kreislauf dieselbe Instanz. Sie entscheidet allein, welche Laufplakette gefuellt
    // steht — ohne Wahl ist jeder laufende Timer ein fremder.
    private long? _gewaehlteKontributorId;

    // Aus ihr löst die Einflugmarke den Namen des Urhebers auf — nicht aus dem Ereignis, damit ein
    // Umbenennen von selbst nachzieht.
    private IReadOnlyList<Kontributor> _kontributoren = [];

    // Was gerade an welcher Karte steht, und die Fristen, nach denen es von selbst wieder
    // verschwindet. Eine Marke, die bleibt, ist keine Nachricht mehr, sondern ein Verlauf.
    private readonly Dictionary<long, string> _einflugmarken = [];
    private readonly Dictionary<long, CancellationTokenSource> _markenfristen = [];

    // Die Karten, die dieser Kreislauf selbst bewegt hat. Der Vermerk hängt am **Kreislauf** und
    // nicht an der Identität: sonst schwiege ein zweiter Browser derselben Person mit, und genau
    // der soll die Änderung sehen. Er wird **vor** dem Aufruf gesetzt, weil das Ereignis vor der
    // Antwort eintreffen kann, und verfällt mit der Standzeit einer Marke.
    private readonly HashSet<long> _eigeneZuege = [];
    private readonly Dictionary<long, CancellationTokenSource> _zugfristen = [];

    // Hält jemand eine Karte in der Hand, ordnet sich unter der Maus nichts um: die fremde
    // Bewegung wartet sichtbar, bis losgelassen ist.
    private bool _einZugLaeuft;
    private readonly List<Kartenereignis> _zurueckgehalteneEreignisse = [];

    [Parameter]
    public long BoardId { get; set; }

    protected override void OnInitialized()
    {
        Ereignisverteiler.Gemeldet += NimmEreignisAn;
    }

    protected override async Task OnParametersSetAsync()
    {
        _ladenIstAbgeschlossen = false;
        try
        {
            await LadeBoard();
            _webApiIstNichtErreichbar = false;
        }
        catch (HttpRequestException)
        {
            _webApiIstNichtErreichbar = true;
        }

        _ladenIstAbgeschlossen = true;
    }

    private void BetreteLayoutModus()
    {
        _layoutModusIstAktiv = true;
    }

    private void VerlasseLayoutModus()
    {
        _layoutModusIstAktiv = false;
    }

    // Die Antwort des Archivierens trägt schon die neuen Spalten: ein zweiter Board-Abruf fände
    // denselben Stand und ließe die Bahnen dazwischen flackern.
    private void UebernimmSpalten(IReadOnlyList<Spalte> spalten)
    {
        _board = _board! with { Spalten = spalten };
    }

    private async Task LegeKarteAb(Kartenablage ablage)
    {
        _zugFehlermeldung = await WebApiAufruf.MitAusfallmeldung(() => VerschiebeKarte(ablage));
        var dieWebApiWarNichtErreichbar = _zugFehlermeldung is not null;
        if (dieWebApiWarNichtErreichbar)
        {
            VergisstEigenenZug(ablage.KarteId);
        }
    }

    private async Task VerschiebeKarte(Kartenablage ablage)
    {
        // Zuerst räumen, dann rufen: bricht der Aufruf mit einer Ausfallmeldung ab, stünde die
        // Zurückweisung des vorigen Zugs sonst daneben und behauptete einen Grund, der nicht gilt.
        _zugZurueckweisung = null;
        VermerkeEigenenZug(ablage.KarteId);

        var lage = new Kartenlage(ablage.SpalteId, ablage.Position, _gewaehlteKontributorId);
        var ergebnis = await KartenKlient.VerschiebeKarte(BoardId, ablage.KarteId, lage);
        if (ergebnis.WurdeZurueckgewiesen)
        {
            // Eine zurückgewiesene Bewegung meldet nichts; ohne das Löschen verschwiege der
            // Vermerk die nächste fremde Bewegung dieser Karte.
            VergisstEigenenZug(ablage.KarteId);
            _zugZurueckweisung = ergebnis.Zurueckweisung;
        }

        // Auch nach einer Zurückweisung wird neu geladen: die Bahnen zeigen danach den Stand der
        // API. Die Karte bewegt sich dabei nicht zurück — sie hat ihren Platz nie verlassen, denn
        // gezogen wird ohne optimistische Vorwegnahme.
        await LadeBoard();
    }

    private async Task SchalteKartenzahl(ChangeEventArgs ereignis)
    {
        var gewuenschterWert = ereignis.Value is true;
        _kartenzahlIstEingeschaltet = gewuenschterWert;
        _kartenzahlFehlermeldung = await WebApiAufruf.MitAusfallmeldung(() => SetzeKartenzahl(gewuenschterWert));
        var dieWebApiWarNichtErreichbar = _kartenzahlFehlermeldung is not null;
        if (dieWebApiWarNichtErreichbar)
        {
            _kartenzahlIstEingeschaltet = _board is not null && _board.ZeigtKartenzahl;
        }
    }

    private async Task SetzeKartenzahl(bool zeigtKartenzahl)
    {
        await ApiKlient.SchalteKartenzahl(BoardId, new Kartenzahlanzeige(zeigtKartenzahl));
        await LadeBoard();
    }

    // Gelesen wird bei jedem Laden neu und nicht nur einmal: eine Wahl, die waehrend des offenen
    // Boards in der Kopfzeile wechselt, gilt damit ab dem naechsten Abruf.
    private async Task LadeBoard()
    {
        _gewaehlteKontributorId = await Identitaetsspeicher.Lies();
        _board = await ApiKlient.LadeBoard(BoardId);
        _kartenzahlIstEingeschaltet = _board is not null && _board.ZeigtKartenzahl;
    }

    // Ab hier: der Rückweg. Die Meldung kommt aus dem Hintergrunddienst und muss über InvokeAsync
    // in den Renderfaden zurück, sonst rendert Blazor aus einem fremden Faden.
    private void NimmEreignisAn(Kartenereignis ereignis)
    {
        var dasEreignisGehoertZuEinemAnderenBoard = ereignis.Board != BoardId;
        if (dasEreignisGehoertZuEinemAnderenBoard)
        {
            return;
        }

        _ = InvokeAsync(() => NimmAufDemRenderfadenAn(ereignis));
    }

    private async Task NimmAufDemRenderfadenAn(Kartenereignis ereignis)
    {
        if (_einZugLaeuft)
        {
            _zurueckgehalteneEreignisse.Add(ereignis);
            StateHasChanged();
            return;
        }

        await SpieleEinMitAusfallmeldung([ereignis]);
    }

    // Der Neuabruf laeuft ueber HTTP wie jeder andere: faellt die WebApi zwischen Meldung und
    // Abruf aus, gehoert der Ausfall an dieselbe Stelle wie der einer eigenen Handlung — und
    // nicht in eine unbeobachtete Aufgabe.
    private async Task SpieleEinMitAusfallmeldung(IReadOnlyList<Kartenereignis> ereignisse)
    {
        _zugFehlermeldung = await WebApiAufruf.MitAusfallmeldung(() => SpieleEin(ereignisse));
        StateHasChanged();
    }

    // **Signal statt Nutzlast:** geholt wird über den bestehenden Ladeweg, damit die Bahn genau so
    // entsteht wie nach einem Reload. Ein einziger Abruf trägt auch mehrere zurückgehaltene
    // Bewegungen — die Bahnen entstehen nicht je Ereignis neu.
    private async Task SpieleEin(IReadOnlyList<Kartenereignis> ereignisse)
    {
        await LadeBoard();

        // Die Liste haengt am Ereignis und nicht an jedem Laden: sie kostet nur dort, wo eine Marke
        // entstehen kann, und ist dann frisch — ein Umbenennen zieht damit von selbst nach.
        _kontributoren = await KontributorenKlient.LadeAlle();
        foreach (var ereignis in ereignisse)
        {
            SetzeEinflugmarke(ereignis);
        }

        StateHasChanged();
    }

    private void SetzeEinflugmarke(Kartenereignis ereignis)
    {
        var beschriftung = Einflugmarke.Fuer(ereignis, _kontributoren, _eigeneZuege, DateTimeOffset.UtcNow);
        VergisstEigenenZug(ereignis.Karte);
        if (beschriftung is null)
        {
            return;
        }

        _einflugmarken[ereignis.Karte] = beschriftung;
        StarteFrist(_markenfristen, ereignis.Karte, () => _einflugmarken.Remove(ereignis.Karte));
    }

    private void BeginneZug()
    {
        _einZugLaeuft = true;
    }

    private async Task BeendeZug()
    {
        _einZugLaeuft = false;
        if (_zurueckgehalteneEreignisse.Count == 0)
        {
            return;
        }

        var eingesammelte = _zurueckgehalteneEreignisse.ToList();
        _zurueckgehalteneEreignisse.Clear();
        await SpieleEinMitAusfallmeldung(eingesammelte);
    }

    private void VermerkeEigenenZug(long karteId)
    {
        _eigeneZuege.Add(karteId);
        StarteFrist(_zugfristen, karteId, () => _eigeneZuege.Remove(karteId));
    }

    private void VergisstEigenenZug(long karteId)
    {
        _eigeneZuege.Remove(karteId);
        BeendeFrist(_zugfristen, karteId);
    }

    // Der Zeitgeber endet mit dem Abbau des Kreislaufs, sonst hielte er eine tote Sicht am Leben.
    private void StarteFrist(Dictionary<long, CancellationTokenSource> fristen, long karteId, Action beimAblauf)
    {
        BeendeFrist(fristen, karteId);
        var frist = new CancellationTokenSource();
        fristen[karteId] = frist;
        _ = LasseFristAblaufen(fristen, karteId, beimAblauf, frist.Token);
    }

    private async Task LasseFristAblaufen(Dictionary<long, CancellationTokenSource> fristen, long karteId, Action beimAblauf, CancellationToken abbruch)
    {
        try
        {
            await Task.Delay(Markenstandzeit.Dauer, abbruch);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        await InvokeAsync(() =>
        {
            beimAblauf();
            BeendeFrist(fristen, karteId);
            StateHasChanged();
        });
    }

    private static void BeendeFrist(Dictionary<long, CancellationTokenSource> fristen, long karteId)
    {
        var esLaeuftSchonEineFrist = fristen.Remove(karteId, out var laufende);
        if (!esLaeuftSchonEineFrist)
        {
            return;
        }

        laufende!.Cancel();
        laufende.Dispose();
    }

    public void Dispose()
    {
        Ereignisverteiler.Gemeldet -= NimmEreignisAn;
        BeendeAlleFristen(_markenfristen);
        BeendeAlleFristen(_zugfristen);
    }

    private static void BeendeAlleFristen(Dictionary<long, CancellationTokenSource> fristen)
    {
        foreach (var frist in fristen.Values)
        {
            frist.Cancel();
            frist.Dispose();
        }

        fristen.Clear();
    }
}
