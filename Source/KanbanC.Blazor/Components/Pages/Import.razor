@page "/boards/{BoardId:long}/import"
@using KanbanC.Blazor.Services
@using KanbanC.Contracts.Fehler
@using KanbanC.Contracts.Import
@using KanbanC.Contracts.Karten
@using KanbanC.Contracts.Klassen
@using KanbanC.Contracts.Kontributoren
@using Microsoft.AspNetCore.Components.Forms
@inject BoardApiKlient BoardKlient
@inject KartenklassenApiKlient KartenklassenKlient
@inject KontributorenApiKlient KontributorenKlient
@inject ImportApiKlient ImportKlient
@inject Identitaetsspeicher Identitaetsspeicher
@inject Pfadkopie Pfadkopie

<PageTitle>WBS-Import</PageTitle>

<SectionContent SectionName="kopfzeile-kontext">
    <a href="@Boardadresse" id="zum-board" class="board-zurueck" title="Zurück zum Board">←</a>
    <h1 id="import-boardname" class="board-name">@_boardname</h1>
    <span class="tag tag-accent" id="import-titel">WBS-Import</span>
</SectionContent>

<div class="importflaeche">
    <ol class="importschritte" id="importschritte">
        <li class="importschritt @SchrittklasseFuer(Importschritt.Datei)" id="importschritt-datei">1 Datei</li>
        <li class="importschritt @SchrittklasseFuer(Importschritt.Vorschau)" id="importschritt-vorschau">2 Vorschau</li>
        <li class="importschritt @SchrittklasseFuer(Importschritt.Bericht)" id="importschritt-bericht">3 Bericht</li>
    </ol>
    <p class="importhinweis" id="import-schreibhinweis">Es wird erst in Schritt 3 geschrieben.</p>

    @if (_ausfallmeldung is not null)
    {
        <div class="meldung" role="alert" id="import-fehlermeldung">@_ausfallmeldung</div>
    }

    @if (_zurueckweisung is not null)
    {
        <div class="meldung meldung-abweisung" role="alert" id="import-zurueckweisung">
            <p>Die Datei wurde nicht eingelesen:</p>
            <ul>
                @foreach (var befund in _zurueckweisung.Befunde)
                {
                    <li>@befund.Meldung <span class="importkompensation">@befund.Kompensation</span></li>
                }
            </ul>
        </div>
    }

    @if (_schritt == Importschritt.Datei)
    {
        <section class="importabschnitt" id="importschritt-1">
            <h2 class="importueberschrift">WBS importieren</h2>
            <p class="importbeschreibung">
                Eine WBS-Datei (Markdown mit Frontmatter und Knotentabelle) wird eingelesen; ihre Knoten
                stehen danach als Karten der gewählten Klasse auf diesem Board.
            </p>

            @* Dieselbe Fläche wie an der Karte, samt ihren zwei Sperrgründen: ohne gewählte
               Identität und während ein Lauf läuft. Wer importiert, ist der Urheber der
               entstehenden Karten. *@
            <label class="ablegeflaeche @Ablegesperre @Ablegelauf" id="import-ablegeflaeche">
                <span class="ablegetext">@Ablegetext</span>
                <InputFile class="ablegefeld" id="import-datei" OnChange="NimmDatei" disabled="@AblegeflaecheIstGesperrt" />
            </label>

            @if (Ablegehinweis is not null)
            {
                <p class="importhinweis" id="import-hinweis">@Ablegehinweis</p>
            }

            @if (_kartenklassen.Count == 0)
            {
                <p id="import-ohne-kartenklasse" class="importhinweis">
                    Dieses Board führt keine Kartenklasse; ohne sie bekämen die entstehenden Karten keine Nummer.
                    <a href="@Boardadresse">Zurück zum Board</a> und im Layout-Modus eine Klasse anlegen.
                </p>
            }
            else
            {
                <div class="field importfeld">
                    <label for="import-klasse">Kartenklasse</label>
                    <select id="import-klasse" class="input" @bind="_gewaehlteKartenklasseId">
                        @foreach (var kartenklasse in _kartenklassen)
                        {
                            <option value="@kartenklasse.KartenklasseId">@kartenklasse.Name (@kartenklasse.Praefix, @kartenklasse.Zaehlerstand vergeben)</option>
                        }
                    </select>
                </div>
                <div class="field importfeld">
                    <label for="import-pfad">Pfad der Datei im Repository</label>
                    <input id="import-pfad" class="input" @bind="_pfad" />
                </div>
                <div class="importaufruf" id="import-aufruf">
                    <span class="importaufruf-titel">Derselbe Weg für einen Agenten</span>
                    <pre class="importaufruf-text">@Importaufruf.Fuer(BoardId, _gewaehlteKartenklasseId, _schnittebene, trocken: true)</pre>
                </div>
            }
        </section>
    }
    else if (_schritt == Importschritt.Vorschau && _bericht is not null)
    {
        <section class="importabschnitt importvorschau" id="importschritt-2">
            <div class="importvorschau-kopf">
                <span id="import-dateiname" class="importdatei">@_dateiname · @Gelesenenknoten Knoten gelesen</span>
                <div class="importregler" id="import-schnittebene">
                    <span class="importregler-titel">Eine Karte je</span>
                    @foreach (var ebene in Schnittebenenwahl.AlleEbenen)
                    {
                        <button type="button"
                                class="btn btn-neben importregler-stellung @ReglerklasseFuer(ebene)"
                                id="@($"schnittebene-{ebene}")"
                                @onclick="() => WechsleSchnittebene(ebene)">
                            @ebene
                            <span class="importregler-zahl">@Schnittebenenwahl.Kartenzahl(_bericht.Kartenzahlen, ebene)</span>
                        </button>
                    }
                </div>
            </div>

            <div class="importvorschau-spalten">
                <div class="importbaum" id="import-baum">
                    <h3 class="importueberschrift">Die Datei</h3>
                    <Importberichtliste Zeilen="_bericht.Zeilen" />
                </div>

                <div class="importwirkungsseite" id="import-wirkung">
                    <h3 class="importueberschrift">Wirkung der Wahl</h3>
                    <div class="importbilanz" id="import-bilanz">
                        <span class="tag tag-accent-2" id="import-angelegt">@_bericht.Angelegt angelegt</span>
                        <span class="tag tag-neutral" id="import-geaendert">@_bericht.Geaendert geändert</span>
                        <span class="tag tag-neutral" id="import-unveraendert">@_bericht.Unveraendert unverändert</span>
                        <span class="tag tag-neutral" id="import-uebersprungen">@_bericht.Uebersprungen übersprungen</span>
                        <span class="tag tag-neutral" id="import-verwaist">@_bericht.Verwaist nicht mehr in der Datei</span>
                    </div>

                    @* Verschweigen wäre dieselbe Sorte stiller Schaden, die die Ablegefläche
                       behoben hat: der Lauf erkennt am Dateiverweis wieder, und wer am Board
                       abgehakt hat, findet den Haken zurückgenommen. *@
                    <p class="importhinweis" id="import-zweiterlauf">
                        Ein zweiter Lauf derselben Datei legt <strong>keine</strong> Karte doppelt an; die Datei zieht Titel,
                        Beschreibung, Etiketten und Teilaufgaben samt Haken nach, das Board behält Bahn, Nummer, Zeiten und Kommentare.
                    </p>

                    <button type="button" class="btn btn-haupt" id="import-schreiben" disabled="@(!EsGibtEtwasZuSchreiben || _laeuft)" @onclick="Schreibe">
                        @Schnittebenenwahl.Schreibbeschriftung(_bericht.Angelegt, _bericht.Geaendert)
                    </button>
                    <button type="button" class="btn btn-neben" id="import-zurueck" @onclick="ZurueckZurDatei">Zurück</button>
                    <pre class="importaufruf-text" id="import-vorschauaufruf">@Importaufruf.Fuer(BoardId, _gewaehlteKartenklasseId, _schnittebene, trocken: true)</pre>
                </div>
            </div>
        </section>
    }
    else if (_schritt == Importschritt.Bericht && _bericht is not null)
    {
        @* Derselbe Bau wie die Vorschau — und das ist der Punkt: was in Schritt 2 angekündigt war,
           steht hier mit der Kartennummer daneben. Der Bericht ist flüchtig; wer die Seite frisch
           öffnet, sieht Schritt 1. Sein Ausgang ist „als Text kopieren". *@
        <section class="importabschnitt" id="importschritt-3">
            <div class="importbericht" id="import-bericht">
                @if (_bericht.Laufkopf is not null)
                {
                    <p class="importlaufkopf" id="import-laufkopf">@Berichtstext.Kopfzeile(_bericht.Laufkopf)</p>
                }

                <h2 class="importergebnis" id="import-ergebnis">@Schnittebenenwahl.Kartenwortlaut(_bericht.Angelegt) angelegt</h2>

                <div class="importbilanz" id="import-bilanz">
                    <span class="tag tag-accent-2" id="import-angelegt">@_bericht.Angelegt angelegt</span>
                    <span class="tag tag-neutral" id="import-geaendert">@_bericht.Geaendert geändert</span>
                    <span class="tag tag-neutral" id="import-unveraendert">@_bericht.Unveraendert unverändert</span>
                    <span class="tag tag-neutral" id="import-uebersprungen">@_bericht.Uebersprungen übersprungen</span>
                    <span class="tag tag-neutral" id="import-verwaist">@_bericht.Verwaist nicht mehr in der Datei</span>
                </div>

                <div class="importberichtzeilen" id="import-berichtzeilen">
                    <Importberichtliste Zeilen="_bericht.Zeilen" />
                </div>
            </div>

            <div class="importberichtwege">
                <a class="btn btn-haupt" id="import-zum-board" href="@Boardadresse">Zum Board</a>
                <button type="button" class="btn btn-neben" id="import-kopieren" @onclick="KopiereBericht">Bericht als Text kopieren</button>
                @if (_berichtWurdeKopiert)
                {
                    <span class="importkopiermeldung" id="import-kopiermeldung">@Kopiermeldung</span>
                }
            </div>
        </section>
    }
</div>

@code {
    private string _boardname = string.Empty;
    private IReadOnlyList<Kartenklasse> _kartenklassen = [];
    private IReadOnlyList<Kontributor> _kontributoren = [];
    private long _gewaehlteKartenklasseId;
    private string _pfad = string.Empty;
    private Kontributor? _urheber;
    private Importschritt _schritt = Importschritt.Datei;
    private Schnittebene _schnittebene = Schnittebene.Interaction;
    private Importbericht? _bericht;
    private Zurueckweisung? _zurueckweisung;
    private string? _ausfallmeldung;
    private string? _dateiname;
    private byte[] _dateiinhalt = [];
    private string? _laufendeDatei;
    private bool _laeuft;
    private bool _berichtWurdeKopiert;
    private Kopierergebnis _kopierstand;

    [Parameter]
    public long BoardId { get; set; }

    // Der Elementbezeichner des Berichts: über ihn findet die Pfadkopie im Rückfall den Textknoten,
    // den sie markieren soll.
    private const string Berichtelement = "import-bericht";

    private string Boardadresse => $"/boards/{BoardId}";

    // **Die Sperre hängt nicht mehr allein an „angelegt"**: ein reiner Aktualisierungslauf wäre
    // über den Schirm sonst nicht auszulösen.
    private bool EsGibtEtwasZuSchreiben => _bericht is not null && (_bericht.Angelegt > 0 || _bericht.Geaendert > 0);

    // Verwaiste Karten stehen zwar in den Zeilen, aber nicht in der Datei — sie mitzuzählen
    // machte aus der Zeilenzahl eine falsche Aussage über die gelesene Datei.
    private int Gelesenenknoten => _bericht!.Zeilen.Count(zeile => zeile.Wirkung != Importwirkung.Verwaist);

    protected override async Task OnParametersSetAsync()
    {
        _ausfallmeldung = await WebApiAufruf.MitAusfallmeldung(LadeUmgebung);
    }

    private async Task LadeUmgebung()
    {
        var board = await BoardKlient.LadeBoard(BoardId);
        if (board is not null)
        {
            _boardname = board.Name;
        }

        var kartenklassen = await KartenklassenKlient.LadeKartenklassen(BoardId);
        if (!kartenklassen.WurdeZurueckgewiesen)
        {
            _kartenklassen = kartenklassen.Wert;
        }

        var esIstNochKeineKlasseGewaehlt = _gewaehlteKartenklasseId == 0 && _kartenklassen.Count > 0;
        if (esIstNochKeineKlasseGewaehlt)
        {
            _gewaehlteKartenklasseId = _kartenklassen[0].KartenklasseId;
        }

        _kontributoren = await KontributorenKlient.LadeAlle();
        _urheber = await GewaehlterUrheber();
    }

    // Gelesen wird bei **jedem** Anlass neu: eine Wahl, die während des offenen Schirms in der
    // Kopfzeile wechselt, gilt sofort — dieselbe Regel wie auf der Kartenseite.
    private async Task<Kontributor?> GewaehlterUrheber()
    {
        var gewaehlteKontributorId = await Identitaetsspeicher.Lies();
        if (gewaehlteKontributorId is null)
        {
            return null;
        }

        return _kontributoren.FirstOrDefault(kontributor => kontributor.KontributorId == gewaehlteKontributorId.Value);
    }

    private bool AblegeflaecheIstGesperrt => Ablegeflaechenstand.IstGesperrt(_urheber is not null, _laufendeDatei);

    private string Ablegesperre
    {
        get
        {
            if (!AblegeflaecheIstGesperrt)
            {
                return string.Empty;
            }

            return "ablegeflaeche-gesperrt";
        }
    }

    private string Ablegelauf
    {
        get
        {
            if (_laufendeDatei is null)
            {
                return string.Empty;
            }

            return "ablegeflaeche-laeuft";
        }
    }

    private string Ablegetext => Ablegeflaechenstand.Text(_urheber is not null, _laufendeDatei);

    private string? Ablegehinweis => Ablegeflaechenstand.Hinweis(_urheber is not null);

    // Die Datei wird **gelesen und nicht gespeichert** — auch nicht hier: die Bytes bleiben im
    // Kreislauf dieses Schirms, damit Vorschau und Schreiblauf dieselbe Fassung schicken. Ein
    // zweites Öffnen desselben Browserstroms gäbe es nicht.
    private async Task NimmDatei(InputFileChangeEventArgs ereignis)
    {
        var datei = ereignis.File;
        var einLaufLaeuftSchon = _laufendeDatei is not null;
        if (einLaufLaeuftSchon)
        {
            return;
        }

        _zurueckweisung = null;
        _ausfallmeldung = null;
        _laufendeDatei = datei.Name;
        StateHasChanged();
        try
        {
            _urheber = await GewaehlterUrheber();
            if (_urheber is null)
            {
                return;
            }

            await LiesDateiEin(datei);
            await ZeigeVorschau();
        }
        catch (JSException)
        {
            // Der abgerissene Dateistrom ist keine HttpRequestException, sondern die Antwort des
            // Browsers auf eine Datei-Nummer, die er nicht mehr kennt. Ohne diesen Fangpunkt
            // stürbe der Vorgang lautlos.
            _ausfallmeldung = WebApiAusfall.Meldung;
        }
        finally
        {
            _laufendeDatei = null;
        }
    }

    private async Task LiesDateiEin(IBrowserFile datei)
    {
        using var quelle = datei.OpenReadStream(Anhangsgrenze.HoechsteDateigroesse);
        using var speicher = new MemoryStream();
        await quelle.CopyToAsync(speicher);
        _dateiinhalt = speicher.ToArray();
        _dateiname = datei.Name;
        var derPfadIstNochLeer = string.IsNullOrWhiteSpace(_pfad);
        if (derPfadIstNochLeer)
        {
            _pfad = datei.Name;
        }
    }

    private async Task WechsleSchnittebene(Schnittebene schnittebene)
    {
        _schnittebene = schnittebene;
        await ZeigeVorschau();
    }

    // **Schritt 2 schreibt nichts**: derselbe Aufruf, den ein Agent mit trocken=true schickt.
    private async Task ZeigeVorschau()
    {
        await Rufe(trocken: true, Importschritt.Vorschau);
    }

    private async Task Schreibe()
    {
        await Rufe(trocken: false, Importschritt.Bericht);
    }

    private async Task Rufe(bool trocken, Importschritt zielschritt)
    {
        _laeuft = true;
        _zurueckweisung = null;
        _ausfallmeldung = await WebApiAufruf.MitAusfallmeldung(() => RufeImport(trocken, zielschritt));
        _laeuft = false;
    }

    private async Task RufeImport(bool trocken, Importschritt zielschritt)
    {
        var urheber = _urheber;
        if (urheber is null || _dateiname is null)
        {
            return;
        }

        var auftrag = new Importauftrag(_dateiname, _gewaehlteKartenklasseId, _schnittebene, _pfad, trocken, urheber.KontributorId);
        using var inhalt = new MemoryStream(_dateiinhalt);
        var ergebnis = await ImportKlient.Importiere(BoardId, auftrag, inhalt);
        if (ergebnis.WurdeZurueckgewiesen)
        {
            _zurueckweisung = ergebnis.Zurueckweisung;
            _schritt = Importschritt.Datei;
            return;
        }

        _bericht = ergebnis.Wert;
        _schritt = zielschritt;
    }

    private void ZurueckZurDatei()
    {
        _schritt = Importschritt.Datei;
    }

    // **Der Ersatz für ein Archiv der Läufe**: der Bericht lässt sich mitnehmen, bevor er mit der
    // Seite verschwindet. Der Rückfall ist der Normalfall und keine Zugabe — die Anwendung läuft
    // im LAN über http://, und dort gibt es navigator.clipboard nicht.
    private async Task KopiereBericht()
    {
        _kopierstand = await Pfadkopie.Kopiere(Berichtstext.Fuer(_bericht!), Berichtelement);
        _berichtWurdeKopiert = true;
    }

    private string Kopiermeldung
    {
        get
        {
            if (_kopierstand == Kopierergebnis.InDerZwischenablage)
            {
                return "kopiert";
            }

            if (_kopierstand == Kopierergebnis.AlsTextMarkiert)
            {
                return "markiert — von Hand kopieren";
            }

            return "nicht kopierbar — Bericht von Hand markieren";
        }
    }

    private string SchrittklasseFuer(Importschritt schritt)
    {
        if (_schritt == schritt)
        {
            return "importschritt-jetzt";
        }

        if (schritt < _schritt)
        {
            return "importschritt-erledigt";
        }

        return string.Empty;
    }

    private string ReglerklasseFuer(Schnittebene schnittebene)
    {
        if (_schnittebene == schnittebene)
        {
            return "importregler-gewaehlt";
        }

        return string.Empty;
    }

}
