@page "/boards"
@using KanbanC.Blazor.Services
@using KanbanC.Contracts.Boardimport
@using KanbanC.Contracts.Boards
@using KanbanC.Contracts.Fehler
@using KanbanC.Contracts.Karten
@using Microsoft.AspNetCore.Components.Forms
@inject BoardApiKlient ApiKlient
@inject BoardimportApiKlient BoardimportKlient

<PageTitle>Boards</PageTitle>

<SectionContent SectionName="kopfzeile-kontext">
    <h1 class="kopfzeile-titel">Boards</h1>
</SectionContent>

<div class="seitenkopf">
    <h1 class="nur-fuer-screenreader">Boards</h1>
    <span class="seitenkopf-rechts">
        <button type="button" class="btn btn-haupt" id="board-anlegen-oeffnen" @onclick="OeffneAnlegeformular">+ Board anlegen</button>
        @* Der Einstieg steht **hier** und nicht im ⋯-Menü einer Kachel: das Menü handelt an einem
           vorhandenen Board, der Import erzeugt eines. *@
        <button type="button" class="btn btn-neben" id="board-importieren-oeffnen" @onclick="OeffneImport">Board importieren</button>
    </span>
</div>

@if (_fehlermeldung is not null)
{
    <div class="meldung" role="alert" id="fehlermeldung">@_fehlermeldung</div>
}

@if (_formularIstOffen)
{
    <section class="anlegeformular card elev-md" id="board-formular">
        <div class="seitenkopf">
            <h2>Board anlegen</h2>
            <span class="seitenkopf-rechts">
                <button type="button" class="btn btn-schlicht" id="board-anlegen-schliessen" aria-label="Formular schließen" @onclick="SchliesseAnlegeformular">✕</button>
            </span>
        </div>

        <EditForm Model="_formular" OnSubmit="LegeBoardAn" FormName="board-anlegen">
            <div class="field">
                <label for="name">Name</label>
                <InputText id="name" class="input" @bind-Value="_formular.Name" />
            </div>

            <InputRadioGroup @bind-Value="_formular.Art" Name="art">
                <fieldset class="artwahl" id="artwahl">
                    <legend>Art</legend>
                    <label class="radio" id="art-linie">
                        <InputRadio Value="BoardArt.Linie" />
                        <span class="dot"></span>
                        Linienboard — ohne Ende
                    </label>
                    <label class="radio" id="art-projekt">
                        <InputRadio Value="BoardArt.Projekt" />
                        <span class="dot"></span>
                        Projektboard — mit Auslauf
                    </label>
                </fieldset>
            </InputRadioGroup>

            @if (_formular.Art == BoardArt.Projekt)
            {
                <div class="terminfelder" id="terminfelder">
                    <div class="field">
                        <label for="starttermin">Starttermin</label>
                        <InputDate id="starttermin" class="input" @bind-Value="_formular.Starttermin" />
                    </div>
                    <div class="field">
                        <label for="zieltermin">Zieltermin</label>
                        <InputDate id="zieltermin" class="input" @bind-Value="_formular.Zieltermin" />
                    </div>
                </div>
            }

            <p class="vorschau-anrede text-muted">Diese Spalten entstehen mit</p>
            <div class="vorschau" id="spaltenvorschau">
                @foreach (var bezeichnung in Standardspalten)
                {
                    <span class="vorschau-spalte tag tag-neutral">@bezeichnung</span>
                }
            </div>

            <div class="formular-knoepfe">
                <button type="submit" class="btn btn-haupt" id="board-anlegen">Anlegen</button>
                <button type="button" class="btn btn-neben" id="board-abbrechen" @onclick="SchliesseAnlegeformular">Abbrechen</button>
            </div>
        </EditForm>

        @if (_zurueckweisung is not null)
        {
            <div class="meldung meldung-abweisung" role="alert" id="zurueckweisung">
                <p>Das Board wurde nicht angelegt:</p>
                <ul>
                    @foreach (var befund in _zurueckweisung.Befunde)
                    {
                        <li>@befund.Meldung</li>
                    }
                </ul>
            </div>
        }
    </section>
}

@if (_importIstOffen)
{
    <section class="importflaeche card elev-md" id="board-import">
        <div class="seitenkopf">
            <h2>Board importieren</h2>
            <span class="seitenkopf-rechts">
                <button type="button" class="btn btn-schlicht" id="board-import-schliessen" aria-label="Import schließen" @onclick="SchliesseImport">✕</button>
            </span>
        </div>

        @if (_importausfall is not null)
        {
            <div class="meldung" role="alert" id="board-import-fehlermeldung">@_importausfall</div>
        }

        @if (_importzurueckweisung is not null)
        {
            <div class="meldung meldung-abweisung" role="alert" id="board-import-zurueckweisung">
                <p>Die Datei wurde nicht eingelesen:</p>
                <ul>
                    @foreach (var befund in _importzurueckweisung.Befunde)
                    {
                        <li>@befund.Meldung <span class="importkompensation">@befund.Kompensation</span></li>
                    }
                </ul>
            </div>
        }

        @if (_angelegtesBoard is null)
        {
            <p class="importbeschreibung">
                Eine exportierte Boarddatei wird eingelesen; daraus entsteht ein <strong>neues</strong> Board.
                Bestehende Boards bleiben unberührt.
            </p>

            @* Dieselbe Fläche wie an der Karte, mit ihrem einen Sperrgrund: während ein Lauf läuft,
               verlöre eine zweite Ablage den ersten still. *@
            <label class="ablegeflaeche @Ablegelauf" id="board-import-ablegeflaeche">
                <span class="ablegetext">@Ablegetext</span>
                <InputFile class="ablegefeld" id="board-import-datei" OnChange="NimmBoarddatei" disabled="@AblegeflaecheIstGesperrt" />
            </label>
        }

        @if (_importbericht is not null && _angelegtesBoard is null)
        {
            <div class="importvorschau" id="board-import-vorschau">
                <p class="importvorschau-name" id="board-import-boardname">@_importbericht.Boardname</p>
                <dl class="importzahlen" id="board-import-zahlen">
                    @foreach (var zeile in Zahlenzeilen(_importbericht.Zahlen))
                    {
                        <div class="importzahl">
                            <dt>@zeile.Bezeichnung</dt>
                            <dd>@zeile.Zahl</dd>
                        </div>
                    }
                </dl>

                @* **Die beiden Preise stehen vor dem Knopf, nicht danach.** *@
                @if (_importbericht.DoppelteNamen.Count > 0)
                {
                    <p class="importpreis" id="board-import-doppelte-namen">
                        Diese Namen entstehen ein zweites Mal in der Personenliste: @string.Join(", ", _importbericht.DoppelteNamen).
                        Zusammengeführt wird niemand.
                    </p>
                }
                <p class="importpreis" id="board-import-anhanghinweis">@_importbericht.Anhanghinweis</p>

                <div class="formular-knoepfe">
                    <button type="button" class="btn btn-haupt" id="board-import-anlegen" disabled="@_importLaeuft" @onclick="LegeImportiertesBoardAn">Board anlegen</button>
                </div>
            </div>
        }

        @if (_angelegtesBoard is not null)
        {
            <div class="importbericht" id="board-import-bericht">
                <p>
                    „@_importbericht!.Boardname“ ist als Board @_angelegtesBoard entstanden.
                    <a href="@($"/boards/{_angelegtesBoard}")" id="board-import-verweis">Zum neuen Board</a>
                </p>
                <p class="importpreis">@_importbericht.Anhanghinweis</p>
            </div>
        }
    </section>
}

@if (_boards is null)
{
    <p>Boards werden geladen …</p>
}
else if (_boards.Count == 0)
{
    <p id="keine-boards">@_leermeldung</p>
}
else
{
    var baender = Boardbaender.Aus(_boards);
    <div id="board-liste">
        <Boardband Kennung="band-linienboards"
                   Ueberschrift="Linienboards — laufen ohne Ende"
                   Boards="baender.Linienboards"
                   Geaendert="LadeListeNeu"
                   IstArchivansicht="_zeigtArchivierte" />
        <Boardband Kennung="band-projektboards"
                   Ueberschrift="Projektboards — laufen mit dem Vorhaben aus"
                   Boards="baender.Projektboards"
                   Geaendert="LadeListeNeu"
                   IstArchivansicht="_zeigtArchivierte" />
    </div>
}

<div class="uebersichtsfuss">
    <span class="text-muted uebersichtsfuss-anrede">Anzeigen</span>
    <span class="seg" id="archivfilter">
        <label class="seg-opt" id="filter-aktive">
            <input type="radio" name="archivansicht" checked="@_zeigtAktive" @onchange="ZeigeAktive" />
            aktive
        </label>
        <label class="seg-opt" id="filter-archivierte">
            <input type="radio" name="archivansicht" checked="@_zeigtArchivierte" @onchange="ZeigeArchivierte" />
            archivierte
        </label>
    </span>
</div>

@code {
    // Die Standardspalten entstehen in der Fachlogik (B0001). Die Oberfläche hat keine
    // Projektreferenz auf KanbanC.BL und nennt sie deshalb hier noch einmal — die Vorschau
    // sagt vorher an, was der Endpunkt anlegen wird.
    private static readonly string[] Standardspalten = ["Zu erledigen", "In Arbeit", "Erledigt"];

    private static readonly Archivierung Aktive = new(false);
    private static readonly Archivierung Archivierte = new(true);

    private readonly BoardFormular _formular = new();
    private IReadOnlyList<BoardUebersicht>? _boards;
    private Zurueckweisung? _zurueckweisung;
    private string? _fehlermeldung;
    private bool _formularIstOffen;

    private bool _importIstOffen;
    private byte[] _boarddatei = [];
    private string? _boarddateiname;
    private string? _laufendeDatei;
    private bool _importLaeuft;
    private Boardimportbericht? _importbericht;
    private Zurueckweisung? _importzurueckweisung;
    private string? _importausfall;
    private long? _angelegtesBoard;

    // Der Filter ist eine Ansicht, kein gespeicherter Zustand: nach einem Reload steht er wieder
    // auf „aktive“.
    private Archivierung _archivstand = Aktive;
    private bool _zeigtAktive = true;
    private bool _zeigtArchivierte;
    private string _leermeldung = LeermeldungAktive;

    private const string LeermeldungAktive = "Noch kein Board vorhanden.";
    private const string LeermeldungArchiv = "Kein archiviertes Board.";

    protected override async Task OnInitializedAsync()
    {
        await MitErreichbarerWebApi(async () => _boards = await ApiKlient.LadeAlleBoards(_archivstand));
    }

    private void OeffneAnlegeformular()
    {
        _formularIstOffen = true;
    }

    private void OeffneImport()
    {
        _importIstOffen = true;
    }

    private void SchliesseImport()
    {
        _importIstOffen = false;
        _importbericht = null;
        _importzurueckweisung = null;
        _importausfall = null;
        _angelegtesBoard = null;
        _boarddatei = [];
        _boarddateiname = null;
    }

    private bool AblegeflaecheIstGesperrt => Boardablegeflaeche.IstGesperrt(_laufendeDatei);

    private string Ablegetext => Boardablegeflaeche.Text(_laufendeDatei);

    private string Ablegelauf
    {
        get
        {
            if (_laufendeDatei is null)
            {
                return string.Empty;
            }

            return "ablegeflaeche-laeuft";
        }
    }

    // Die Datei wird **gelesen und nicht gespeichert**: die Bytes bleiben im Kreislauf dieses
    // Schirms, damit Vorschau und Schreiblauf dieselbe Fassung schicken. Ein zweites Öffnen
    // desselben Browserstroms gäbe es nicht.
    private async Task NimmBoarddatei(InputFileChangeEventArgs ereignis)
    {
        var einLaufLaeuftSchon = _laufendeDatei is not null;
        if (einLaufLaeuftSchon)
        {
            return;
        }

        var datei = ereignis.File;
        _importzurueckweisung = null;
        _importausfall = null;
        _angelegtesBoard = null;
        _laufendeDatei = datei.Name;
        StateHasChanged();
        try
        {
            await LiesBoarddateiEin(datei);
            await ZeigeImportvorschau();
        }
        catch (JSException)
        {
            // Der abgerissene Dateistrom ist keine HttpRequestException, sondern die Antwort des
            // Browsers auf eine Datei-Nummer, die er nicht mehr kennt. Ohne diesen Fangpunkt
            // stürbe der Vorgang lautlos.
            _importausfall = WebApiAusfall.Meldung;
        }
        finally
        {
            _laufendeDatei = null;
        }
    }

    private async Task LiesBoarddateiEin(IBrowserFile datei)
    {
        using var quelle = datei.OpenReadStream(Anhangsgrenze.HoechsteDateigroesse);
        using var speicher = new MemoryStream();
        await quelle.CopyToAsync(speicher);
        _boarddatei = speicher.ToArray();
        _boarddateiname = datei.Name;
    }

    // **Schritt 1 schreibt nichts**: derselbe Aufruf, den ein Agent mit trocken=true schickt.
    private async Task ZeigeImportvorschau()
    {
        await RufeBoardimport(trocken: true);
    }

    // Erst dieser Klick schreibt — und danach ist die Boardliste die eine Quelle und wird neu
    // geholt.
    private async Task LegeImportiertesBoardAn()
    {
        await RufeBoardimport(trocken: false);
        if (_angelegtesBoard is not null)
        {
            await LadeListeNeu();
        }
    }

    private async Task RufeBoardimport(bool trocken)
    {
        _importLaeuft = true;
        _importzurueckweisung = null;
        _importausfall = await WebApiAufruf.MitAusfallmeldung(() => RufeImportroute(trocken));
        _importLaeuft = false;
    }

    private async Task RufeImportroute(bool trocken)
    {
        if (_boarddateiname is null)
        {
            return;
        }

        var auftrag = new Boardimportauftrag(_boarddateiname, trocken);
        using var inhalt = new MemoryStream(_boarddatei);
        var ergebnis = await BoardimportKlient.Importiere(auftrag, inhalt);
        if (ergebnis.WurdeZurueckgewiesen)
        {
            _importzurueckweisung = ergebnis.Zurueckweisung;
            _importbericht = null;
            return;
        }

        _importbericht = ergebnis.Wert;
        _angelegtesBoard = ergebnis.Wert.BoardId;
    }

    // Die zehn Zahlen in der Reihenfolge, in der der Bericht sie führt — dieselbe, die ein Agent
    // in der Antwort liest.
    private static IReadOnlyList<Zahlenzeile> Zahlenzeilen(Boardimportzahlen zahlen)
    {
        return
        [
            new Zahlenzeile("Spalten", zahlen.Spalten),
            new Zahlenzeile("Kartenklassen", zahlen.Kartenklassen),
            new Zahlenzeile("Kontributoren", zahlen.Kontributoren),
            new Zahlenzeile("Karten", zahlen.Karten),
            new Zahlenzeile("Etiketten", zahlen.Etiketten),
            new Zahlenzeile("Teilaufgaben", zahlen.Teilaufgaben),
            new Zahlenzeile("Kommentare", zahlen.Kommentare),
            new Zahlenzeile("Anhänge", zahlen.Anhaenge),
            new Zahlenzeile("Dateiverweise", zahlen.Dateiverweise),
            new Zahlenzeile("Zeiteinträge", zahlen.Zeiteintraege),
        ];
    }

    private sealed record Zahlenzeile(string Bezeichnung, int Zahl);

    private void SchliesseAnlegeformular()
    {
        _formularIstOffen = false;
        _zurueckweisung = null;
        _formular.Leere();
    }

    private async Task LegeBoardAn()
    {
        await MitErreichbarerWebApi(async () =>
        {
            var ergebnis = await ApiKlient.LegeBoardAn(_formular.AlsAnfrage());
            if (ergebnis.WurdeZurueckgewiesen)
            {
                _zurueckweisung = ergebnis.Zurueckweisung;
                return;
            }

            _zurueckweisung = null;
            _formular.Leere();
            _formularIstOffen = false;
            _boards = await ApiKlient.LadeAlleBoards(_archivstand);
        });
    }

    private async Task ZeigeAktive()
    {
        await WechsleAnsicht(Aktive);
    }

    private async Task ZeigeArchivierte()
    {
        await WechsleAnsicht(Archivierte);
    }

    private async Task WechsleAnsicht(Archivierung archivstand)
    {
        _archivstand = archivstand;
        _zeigtArchivierte = archivstand.IstArchiviert;
        _zeigtAktive = !archivstand.IstArchiviert;
        _leermeldung = LeermeldungFuer(archivstand);
        await LadeListeNeu();
    }

    private static string LeermeldungFuer(Archivierung archivstand)
    {
        if (archivstand.IstArchiviert)
        {
            return LeermeldungArchiv;
        }

        return LeermeldungAktive;
    }

    // Eine Kachel hat ihr Board geändert; die geladene Liste ist die eine Quelle und wird neu geholt.
    private async Task LadeListeNeu()
    {
        await MitErreichbarerWebApi(async () => _boards = await ApiKlient.LadeAlleBoards(_archivstand));
    }

    private async Task MitErreichbarerWebApi(Func<Task> aufruf)
    {
        _fehlermeldung = await WebApiAufruf.MitAusfallmeldung(aufruf);
    }

    // Adaptermodell des Formular-Bindings: veränderlich, weil EditForm es so braucht; verlässt die Seite nie.
    private sealed class BoardFormular
    {
        public string Name { get; set; } = "";

        public BoardArt Art { get; set; } = BoardArt.Linie;

        public DateOnly? Starttermin { get; set; }

        public DateOnly? Zieltermin { get; set; }

        public BoardAnlegenAnfrage AlsAnfrage()
        {
            return new BoardAnlegenAnfrage(Name, Art, Starttermin, Zieltermin);
        }

        public void Leere()
        {
            Name = "";
            Art = BoardArt.Linie;
            Starttermin = null;
            Zieltermin = null;
        }
    }
}
