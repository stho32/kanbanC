@page "/boards"
@using KanbanC.Blazor.Services
@using KanbanC.Contracts.Boards
@using KanbanC.Contracts.Fehler
@inject BoardApiKlient ApiKlient

<PageTitle>Boards</PageTitle>

<SectionContent SectionName="kopfzeile-kontext">
    <h1 class="kopfzeile-titel">Boards</h1>
</SectionContent>

<div class="seitenkopf">
    <h1 class="nur-fuer-screenreader">Boards</h1>
    <span class="seitenkopf-rechts">
        <button type="button" class="btn btn-haupt" id="board-anlegen-oeffnen" @onclick="OeffneAnlegeformular">+ Board anlegen</button>
    </span>
</div>

@if (_fehlermeldung is not null)
{
    <div class="meldung" role="alert" id="fehlermeldung">@_fehlermeldung</div>
}

@if (_formularIstOffen)
{
    <section class="anlegeformular card elev-md" id="board-formular">
        <div class="seitenkopf">
            <h2>Board anlegen</h2>
            <span class="seitenkopf-rechts">
                <button type="button" class="btn btn-schlicht" id="board-anlegen-schliessen" aria-label="Formular schließen" @onclick="SchliesseAnlegeformular">✕</button>
            </span>
        </div>

        <EditForm Model="_formular" OnSubmit="LegeBoardAn" FormName="board-anlegen">
            <div class="field">
                <label for="name">Name</label>
                <InputText id="name" class="input" @bind-Value="_formular.Name" />
            </div>

            <InputRadioGroup @bind-Value="_formular.Art" Name="art">
                <fieldset class="artwahl" id="artwahl">
                    <legend>Art</legend>
                    <label class="radio" id="art-linie">
                        <InputRadio Value="BoardArt.Linie" />
                        <span class="dot"></span>
                        Linienboard — ohne Ende
                    </label>
                    <label class="radio" id="art-projekt">
                        <InputRadio Value="BoardArt.Projekt" />
                        <span class="dot"></span>
                        Projektboard — mit Auslauf
                    </label>
                </fieldset>
            </InputRadioGroup>

            @if (_formular.Art == BoardArt.Projekt)
            {
                <div class="terminfelder" id="terminfelder">
                    <div class="field">
                        <label for="starttermin">Starttermin</label>
                        <InputDate id="starttermin" class="input" @bind-Value="_formular.Starttermin" />
                    </div>
                    <div class="field">
                        <label for="zieltermin">Zieltermin</label>
                        <InputDate id="zieltermin" class="input" @bind-Value="_formular.Zieltermin" />
                    </div>
                </div>
            }

            <p class="vorschau-anrede text-muted">Diese Spalten entstehen mit</p>
            <div class="vorschau" id="spaltenvorschau">
                @foreach (var bezeichnung in Standardspalten)
                {
                    <span class="vorschau-spalte tag tag-neutral">@bezeichnung</span>
                }
            </div>

            <div class="formular-knoepfe">
                <button type="submit" class="btn btn-haupt" id="board-anlegen">Anlegen</button>
                <button type="button" class="btn btn-neben" id="board-abbrechen" @onclick="SchliesseAnlegeformular">Abbrechen</button>
            </div>
        </EditForm>

        @if (_zurueckweisung is not null)
        {
            <div class="meldung meldung-abweisung" role="alert" id="zurueckweisung">
                <p>Das Board wurde nicht angelegt:</p>
                <ul>
                    @foreach (var befund in _zurueckweisung.Befunde)
                    {
                        <li>@befund.Meldung</li>
                    }
                </ul>
            </div>
        }
    </section>
}

@if (_boards is null)
{
    <p>Boards werden geladen …</p>
}
else if (_boards.Count == 0)
{
    <p id="keine-boards">Noch kein Board vorhanden.</p>
}
else
{
    var baender = Boardbaender.Aus(_boards);
    <div id="board-liste">
        <Boardband Kennung="band-linienboards"
                   Ueberschrift="Linienboards — laufen ohne Ende"
                   Boards="baender.Linienboards"
                   Geaendert="LadeListeNeu" />
        <Boardband Kennung="band-projektboards"
                   Ueberschrift="Projektboards — laufen mit dem Vorhaben aus"
                   Boards="baender.Projektboards"
                   Geaendert="LadeListeNeu" />
    </div>
}

@code {
    // Die Standardspalten entstehen in der Fachlogik (B0001). Die Oberfläche hat keine
    // Projektreferenz auf KanbanC.BL und nennt sie deshalb hier noch einmal — die Vorschau
    // sagt vorher an, was der Endpunkt anlegen wird.
    private static readonly string[] Standardspalten = ["Zu erledigen", "In Arbeit", "Erledigt"];

    private static readonly Archivierung Aktive = new(false);

    private readonly BoardFormular _formular = new();
    private IReadOnlyList<BoardUebersicht>? _boards;
    private Zurueckweisung? _zurueckweisung;
    private string? _fehlermeldung;
    private bool _formularIstOffen;

    protected override async Task OnInitializedAsync()
    {
        await MitErreichbarerWebApi(async () => _boards = await ApiKlient.LadeAlleBoards(Aktive));
    }

    private void OeffneAnlegeformular()
    {
        _formularIstOffen = true;
    }

    private void SchliesseAnlegeformular()
    {
        _formularIstOffen = false;
        _zurueckweisung = null;
        _formular.Leere();
    }

    private async Task LegeBoardAn()
    {
        await MitErreichbarerWebApi(async () =>
        {
            var ergebnis = await ApiKlient.LegeBoardAn(_formular.AlsAnfrage());
            if (ergebnis.WurdeZurueckgewiesen)
            {
                _zurueckweisung = ergebnis.Zurueckweisung;
                return;
            }

            _zurueckweisung = null;
            _formular.Leere();
            _formularIstOffen = false;
            _boards = await ApiKlient.LadeAlleBoards(Aktive);
        });
    }

    // Eine Kachel hat ihr Board geändert; die geladene Liste ist die eine Quelle und wird neu geholt.
    private async Task LadeListeNeu()
    {
        await MitErreichbarerWebApi(async () => _boards = await ApiKlient.LadeAlleBoards(Aktive));
    }

    private async Task MitErreichbarerWebApi(Func<Task> aufruf)
    {
        _fehlermeldung = await WebApiAufruf.MitAusfallmeldung(aufruf);
    }

    // Adaptermodell des Formular-Bindings: veränderlich, weil EditForm es so braucht; verlässt die Seite nie.
    private sealed class BoardFormular
    {
        public string Name { get; set; } = "";

        public BoardArt Art { get; set; } = BoardArt.Linie;

        public DateOnly? Starttermin { get; set; }

        public DateOnly? Zieltermin { get; set; }

        public BoardAnlegenAnfrage AlsAnfrage()
        {
            return new BoardAnlegenAnfrage(Name, Art, Starttermin, Zieltermin);
        }

        public void Leere()
        {
            Name = "";
            Art = BoardArt.Linie;
            Starttermin = null;
            Zieltermin = null;
        }
    }
}
