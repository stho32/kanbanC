@using KanbanC.Blazor.Services
@using KanbanC.Contracts.Kontributoren
@inject KontributorenApiKlient KontributorenKlient

@* Die Wahl hängt am Feld und schließt über eine Auffangfläche — dasselbe Muster wie
   die Identitätswahl in der Kopfzeile. *@
<div class="blattfeld verantwortlichenfeld">
    <span class="blattmarke">Verantwortlich</span>
    <button type="button"
            class="blattwert"
            id="verantwortlich"
            aria-haspopup="true"
            aria-expanded="@AlsAttributtext(_wahlIstOffen)"
            @onclick="OeffneVerantwortlichenwahl">
        @if (Verantwortlicher is null)
        {
            <span class="kuerzel kuerzel-niemand"></span>
            <span class="verantwortlichenname">niemand</span>
        }
        else
        {
            <span class="kuerzel @Kontributorartform.Kuerzelklasse(Verantwortlicher.Art) @Gedaempft()">@Kontributorartform.Kuerzel(Verantwortlicher.Name)</span>
            <span class="verantwortlichenname @Gedaempft()" id="verantwortlichenname">@Verantwortlicher.Name</span>
            @if (Verantwortlicher.StillgelegtAm is null)
            {
                <span class="tag @Kontributorartform.Plakettenklasse(Verantwortlicher.Art)" id="verantwortlichenart">@Kontributorartform.Beschriftung(Verantwortlicher.Art)</span>
            }
            else
            {
                @* Die Karte zeigt ihn weiter — die zweite Hälfte des Fertig-Kriteriums
                   von I0009. Wählbar ist er nicht mehr. *@
                <span class="verantwortlichenvermerk" id="verantwortlich-stillgelegt-vermerk">stillgelegt</span>
            }
        }
        <span class="blattchevron" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"></path></svg>
        </span>
    </button>

    @if (_wahlIstOffen)
    {
        <div class="verantwortlichen-auffangflaeche" id="verantwortlichen-auffangflaeche" @onclick="SchliesseVerantwortlichenwahl"></div>
        <div class="verantwortlichenpopover" id="verantwortlichenpopover">
            <input class="input verantwortlichensuche"
                   id="verantwortlichensuche"
                   placeholder="Name suchen"
                   value="@_verantwortlichensuche"
                   @oninput="FiltereVerantwortliche" />

            <ul class="verantwortlichenliste" id="verantwortlichenliste">
                @foreach (var kontributor in Waehlbare)
                {
                    <li>
                        <button type="button"
                                class="verantwortlichenzeile"
                                id="verantwortlich-waehlen-@kontributor.KontributorId"
                                @onclick="() => Waehle(kontributor.KontributorId)">
                            <span class="kuerzel @Kontributorartform.Kuerzelklasse(kontributor.Art)">@Kontributorartform.Kuerzel(kontributor.Name)</span>
                            <span class="verantwortlichenname">@kontributor.Name</span>
                            <span class="tag @Kontributorartform.Plakettenklasse(kontributor.Art)">@Kontributorartform.Beschriftung(kontributor.Art)</span>
                        </button>
                    </li>
                }
            </ul>

            <hr class="verantwortlichentrenner" />

            @* „niemand" ist ein Eintrag der Liste, kein zweiter Knopf: eine Karte ohne
               Verantwortlichen ist der Normalfall nach dem Anlegen. *@
            <button type="button" class="verantwortlichenzeile verantwortlichenzeile-niemand" id="verantwortlich-niemand" @onclick="() => Waehle(null)">
                <span class="kuerzel kuerzel-niemand"></span>
                <span class="verantwortlichenname">niemand</span>
            </button>

            @if (StillgelegterTraeger is not null)
            {
                <p class="verantwortlichenabschnitt">stillgelegt · nicht wählbar</p>
                <div class="verantwortlichenzeile verantwortlichenzeile-stillgelegt"
                     id="verantwortlich-stillgelegt-@StillgelegterTraeger.KontributorId"
                     aria-disabled="true">
                    <span class="kuerzel @Kontributorartform.Kuerzelklasse(StillgelegterTraeger.Art)">@Kontributorartform.Kuerzel(StillgelegterTraeger.Name)</span>
                    <span class="verantwortlichenname verantwortlichenname-stillgelegt">@StillgelegterTraeger.Name</span>
                    <span class="verantwortlichenvermerk">stillgelegt seit @Terminformatierer.AlsText(StillgelegterTraeger.StillgelegtAm)</span>
                </div>
            }
        </div>
    }
</div>

@code {
private bool _wahlIstOffen;
private IReadOnlyList<Kontributor> _kontributoren = [];
private string _verantwortlichensuche = string.Empty;

// Wer an der Karte steht — auch dann, wenn er inzwischen stillgelegt ist. null heißt „niemand".
[Parameter]
public Kontributor? Verantwortlicher { get; set; }

// Die Wahl meldet den Wunsch nach oben, statt selbst zu schreiben: die Seite kennt die
// Antwort der WebApi und zeichnet sich daraus neu — dasselbe Verhältnis wie zwischen Karte
// und Bahn.
[Parameter]
public EventCallback<long?> Gewaehlt { get; set; }

// Die Liste holt die Komponente selbst; ein Ausfall dabei gehört trotzdem in die eine
// Meldungsstelle der Seite.
[Parameter]
public EventCallback<string?> AusfallGemeldet { get; set; }

// Wer die Wahl öffnet, will den heutigen Stand sehen: ein gerade stillgelegter Kontributor
// stünde sonst noch darin. Dieselbe Überlegung wie in der Kopfzeile.
private async Task OeffneVerantwortlichenwahl()
{
    _verantwortlichensuche = string.Empty;
    _wahlIstOffen = true;
    var ausfallmeldung = await WebApiAufruf.MitAusfallmeldung(async () => _kontributoren = await KontributorenKlient.LadeAlle());
    await AusfallGemeldet.InvokeAsync(ausfallmeldung);
}

private void SchliesseVerantwortlichenwahl()
{
    _wahlIstOffen = false;
}

private void FiltereVerantwortliche(ChangeEventArgs ereignis)
{
    _verantwortlichensuche = ereignis.Value?.ToString() ?? string.Empty;
}

private async Task Waehle(long? kontributorId)
{
    _wahlIstOffen = false;
    await Gewaehlt.InvokeAsync(kontributorId);
}

private IReadOnlyList<Kontributor> Waehlbare
{
    get
    {
        return Verantwortlichenliste.Gefiltert(Verantwortlichenliste.Waehlbare(_kontributoren), _verantwortlichensuche);
    }
}

private Kontributor? StillgelegterTraeger
{
    get
    {
        return Verantwortlichenliste.StillgelegterTraeger(Verantwortlicher);
    }
}

// Gedämpft, nicht verborgen: wer eine Karte geführt hat, bleibt an ihr sichtbar.
private string Gedaempft()
{
    if (Verantwortlicher?.StillgelegtAm is null)
    {
        return string.Empty;
    }

    return "verantwortlicher-stillgelegt";
}

private static string AlsAttributtext(bool wert)
{
    if (wert)
    {
        return "true";
    }

    return "false";
}
}
