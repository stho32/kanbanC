@using KanbanC.Blazor.Services
@using KanbanC.Contracts.Zeiten
<article class="@Klassen" data-karte-id="@Kartendaten.KarteId" draggable="@Ziehbarkeit"
         @ondragstart="BeginneZug" @ondragend="BeendeZug">
    <div class="kartenkopf">
        <div class="kartenmenue">
            <button type="button"
                    class="btn btn-schlicht kartenmenue-schalter"
                    aria-label="Menü von @Kartendaten.Titel"
                    aria-expanded="@_menuezustand"
                    @onclick="SchalteMenue">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="5" cy="12" r="1.6"></circle><circle cx="12" cy="12" r="1.6"></circle><circle cx="19" cy="12" r="1.6"></circle></svg>
            </button>
            @if (_menueIstOffen)
            {
                <div class="kartenmenueliste">
                    @* Derselbe Weg wie der Titelverweis, nur benannt. Er steht vor dem
                       Archivieren, weil Ansehen die haeufigere Handlung ist. *@
                    <a class="kartenmenuepunkt kartenmenuepunkt-details" href="/karten/@Kartendaten.KarteId">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6h16"></path><path d="M4 12h10"></path><path d="M4 18h7"></path><path d="m15 15 5 5m0-5-5 5"></path></svg>
                        Details öffnen
                    </a>
                    <span class="kartenmenuehinweis">Titel, Beschreibung, Verantwortlicher, Fälligkeit, Farbe und Etiketten</span>
                    <button type="button" class="kartenmenuepunkt kartenmenuepunkt-archivieren" @onclick="Archiviere">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="4" rx="1.5"></rect><path d="M5 8v11a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8"></path><path d="M10 12h4"></path></svg>
                        Archivieren
                    </button>
                    <span class="kartenmenuehinweis">verschwindet vom Board, bleibt über API und Archiv auffindbar</span>
                </div>
            }
        </div>
    </div>
    @* Die Plaketten stehen **ueber** dem Titelverweis und nicht in ihm: der Titel bleibt der Weg
       auf die Kartenseite, und die beiden Ziehproben pruefen genau das. Links die Nummer, rechts
       der laufende Timer. Traegt die Karte weder Klasse noch Timer, kostet die Stelle keine
       Zeile. *@
    @if (Kartendaten.Kartennummer is not null || _laufplakette is not null)
    {
        <div class="karte-plaketten">
            @if (Kartendaten.Kartennummer is not null)
            {
                <span class="tag tag-neutral karte-nummer" data-kartennummer="@Kartendaten.Kartennummer">@Kartendaten.Kartennummer</span>
            }
            @if (_laufplakette is not null)
            {
                <span class="tag karte-timer @_laufplakette.Fuellungsklasse" data-karte-timer="@Kartendaten.KarteId" title="@_laufplakette.Titel">
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3.5 2"></path></svg>
                    @_laufplakette.Beschriftung
                </span>
            }
        </div>
    }
    @* Der zweite Weg auf die Kartenseite. Ein Klick bewegt die Maus nicht und beginnt deshalb
       keinen Zug (KindZiehbarkeitProbeE2ETests); wird am Titel gezogen, zieht die Karte weiter
       als Ganzes — belegt in VerweisInZiehbarerKarteProbeE2ETests. *@
    <a class="karte-titel" href="/karten/@Kartendaten.KarteId">@Kartendaten.Titel</a>
    @* Die Marke steht **in** der Karte und nicht daneben: sie gehoert der Karte, nicht der Bahn.
       Ueber einer Trennlinie im Fuss, wie im Artboard gezeichnet. *@
    @if (Einflugmarke is not null)
    {
        <p class="karte-einflugmarke" data-karte-einflugmarke="@Kartendaten.KarteId">@Einflugmarke</p>
    }
    @if (NimmtAn)
    {
        <div class="kartenhaelfte kartenhaelfte-oben"
             @ondragover:preventDefault
             @ondragenter:stopPropagation
             @ondragenter="() => UeberfahreHaelfte(Kartenhaelfte.Oben)"
             @ondrop:preventDefault
             @ondrop:stopPropagation
             @ondrop="() => LegeAbAufHaelfte(Kartenhaelfte.Oben)"></div>
        <div class="kartenhaelfte kartenhaelfte-unten"
             @ondragover:preventDefault
             @ondragenter:stopPropagation
             @ondragenter="() => UeberfahreHaelfte(Kartenhaelfte.Unten)"
             @ondrop:preventDefault
             @ondrop:stopPropagation
             @ondrop="() => LegeAbAufHaelfte(Kartenhaelfte.Unten)"></div>
    }
</article>

@code {
    private bool _menueIstOffen;
    private string _menuezustand = "false";
    private Laufplakette? _laufplakette;

    // Vollqualifiziert, weil der Komponentenname Karte den gleichnamigen Vertragstyp verdeckt.
    [Parameter]
    [EditorRequired]
    public KanbanC.Contracts.Karten.Karte Kartendaten { get; set; } = null!;

    // Die laufenden Zeiteintraege **dieser** Karte, von der Bahn zugeordnet: das Board liefert sie
    // flach ueber alle Spalten.
    [Parameter]
    public IReadOnlyList<Zeiteintrag> LaufendeZeiteintraege { get; set; } = [];

    // Ohne gewaehlte Identitaet gibt es kein „mich": jeder laufende Timer ist dann ein fremder.
    [Parameter]
    public long? GewaehlteKontributorId { get; set; }

    // Was an einer eben fremd bewegten Karte steht — „Nina Barth · vor 3 Sek" oder „Claude-Agent ·
    // ueber die API · gerade eben". null heisst „ruhige Karte": die eigene Handlung bekommt keine
    // Marke, und nach etwa zehn Sekunden verschwindet jede von selbst.
    [Parameter]
    public string? Einflugmarke { get; set; }

    protected override void OnParametersSet()
    {
        _laufplakette = Laufplakette.Fuer(LaufendeZeiteintraege, GewaehlteKontributorId);
    }

    [Parameter]
    public bool IstZiehbar { get; set; }

    [Parameter]
    public bool WirdGezogen { get; set; }

    [Parameter]
    public EventCallback<long> ZugBegann { get; set; }

    [Parameter]
    public EventCallback ZugEndete { get; set; }

    // Die Karte meldet den Wunsch nach oben, statt selbst zu rufen: die Bahn kennt die Antwort
    // der WebApi und zeichnet sich daraus neu.
    [Parameter]
    public EventCallback<long> ArchivierungGewuenscht { get; set; }

    // Die zwei Ablagezonen liegen als Auflagen über der Karte, nicht als Kinder im Fluss:
    // sonst wüchse die Karte in dem Moment, in dem der Nutzer zu zielen beginnt.
    [Parameter]
    public bool NimmtAn { get; set; }

    [Parameter]
    public EventCallback<Kartenhaelfte> HaelfteUeberfahren { get; set; }

    [Parameter]
    public EventCallback<Kartenhaelfte> HierAbgelegt { get; set; }

    // draggable ist kein boolesches Attribut: ohne Wert gilt „auto“, und auto heißt für ein
    // article „nicht ziehbar“. Der Wert muss deshalb ausgeschrieben werden.
    private string Ziehbarkeit
    {
        get
        {
            if (IstZiehbar)
            {
                return "true";
            }

            return "false";
        }
    }

    private string Klassen
    {
        get
        {
            if (WirdGezogen)
            {
                return "karte karte-wird-gezogen";
            }

            if (Einflugmarke is not null)
            {
                return "karte karte-eingeflogen";
            }

            return "karte";
        }
    }

    // Das Menü schließt über einen zweiten Klick auf ⋯, wie das Menü der Boardkachel.
    private void SchalteMenue()
    {
        SetzeMenue(!_menueIstOffen);
    }

    private async Task Archiviere()
    {
        SetzeMenue(false);
        await ArchivierungGewuenscht.InvokeAsync(Kartendaten.KarteId);
    }

    private void SetzeMenue(bool istOffen)
    {
        _menueIstOffen = istOffen;
        _menuezustand = AlsAttributtext(istOffen);
    }

    private static string AlsAttributtext(bool wert)
    {
        if (wert)
        {
            return "true";
        }

        return "false";
    }

    private async Task BeginneZug()
    {
        await ZugBegann.InvokeAsync(Kartendaten.KarteId);
    }

    private async Task BeendeZug()
    {
        await ZugEndete.InvokeAsync();
    }

    private async Task UeberfahreHaelfte(Kartenhaelfte haelfte)
    {
        await HaelfteUeberfahren.InvokeAsync(haelfte);
    }

    private async Task LegeAbAufHaelfte(Kartenhaelfte haelfte)
    {
        await HierAbgelegt.InvokeAsync(haelfte);
    }
}
