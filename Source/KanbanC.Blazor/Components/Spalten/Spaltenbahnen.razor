@using KanbanC.Contracts.Boards

<div class="spaltenbahnen" id="spaltenbahnen">
    @foreach (var spalte in Spalten)
    {
        var formular = _formulare[spalte.SpalteId];
        <section class="spaltenbahn" data-spalte-id="@spalte.SpalteId" @key="spalte.SpalteId">
            <header class="spaltenbahn-kopf">
                <span class="spaltenbahn-anzeige">
                    <span class="spaltenbahn-bezeichnung">@spalte.Bezeichnung</span>
                    @if (spalte.IstAbschlussspalte)
                    {
                        <span class="spaltenbahn-haken" title="Abschlussspalte">✓</span>
                        <span class="spaltenbahn-vermerk">Grenze @spalte.Anzeigegrenze</span>
                    }
                </span>
                @* Die Kartenzahl bleibt leer, bis I0004 sie füllt. *@
                <span class="spaltenbahn-kartenzahl" aria-hidden="true"></span>
                @if (IstBearbeitbar)
                {
                    <span class="spaltenbahn-position">Position @spalte.Position</span>
                    <div class="spaltenbahn-bearbeitung">
                        <input class="input spalte-bezeichnung" aria-label="Bezeichnung" @bind="formular.Bezeichnung" />
                        <input class="spalte-abschluss" type="checkbox" aria-label="Abschlussspalte" @bind="formular.IstAbschlussspalte" />
                        <input class="input spalte-grenze" type="number" aria-label="Anzeigegrenze" @bind="formular.Anzeigegrenze" />
                        <div class="spaltenbahn-knoepfe">
                            <button type="button" class="btn btn-neben spalte-speichern" @onclick="() => SpeichereBahn(spalte.SpalteId)">Speichern</button>
                            <button type="button" class="btn btn-neben spalte-hoch" @onclick="() => SpalteWeiterVorn.InvokeAsync(spalte.SpalteId)">Hoch</button>
                            <button type="button" class="btn btn-neben spalte-runter" @onclick="() => SpalteWeiterHinten.InvokeAsync(spalte.SpalteId)">Runter</button>
                            <button type="button" class="btn btn-neben spalte-entfernen" @onclick="() => SpalteEntfernt.InvokeAsync(spalte.SpalteId)">Entfernen</button>
                        </div>
                    </div>
                }
            </header>
            <div class="spaltenbahn-flaeche">
                @if (spalte.Karten.Count == 0)
                {
                    <p class="spaltenbahn-leer">Noch keine Karte.<br />Unten eine anlegen.</p>
                }
                else
                {
                    @foreach (var kartendaten in spalte.Karten)
                    {
                        <Karte @key="kartendaten.KarteId" Kartendaten="kartendaten" />
                    }
                }
            </div>
            <footer class="spaltenbahn-fuss">
                <div class="spaltenbahn-kartenstelle">
                    <Kartenanlage BoardId="BoardId" SpalteId="spalte.SpalteId" KarteWurdeAngelegt="KarteWurdeAngelegt" />
                </div>
            </footer>
        </section>
    }
</div>

@code {
    private Dictionary<long, SpaltenFormular> _formulare = [];
    private IReadOnlyList<Spalte> _gezeigteSpalten = [];

    [Parameter]
    [EditorRequired]
    public long BoardId { get; set; }

    [Parameter]
    [EditorRequired]
    public IReadOnlyList<Spalte> Spalten { get; set; } = [];

    [Parameter]
    public EventCallback KarteWurdeAngelegt { get; set; }

    [Parameter]
    public bool IstBearbeitbar { get; set; }

    [Parameter]
    public EventCallback<SpalteGespeichert> SpalteGeaendert { get; set; }

    [Parameter]
    public EventCallback<long> SpalteWeiterVorn { get; set; }

    [Parameter]
    public EventCallback<long> SpalteWeiterHinten { get; set; }

    [Parameter]
    public EventCallback<long> SpalteEntfernt { get; set; }

    protected override void OnParametersSet()
    {
        // Ein Elternrender allein ist kein Grund, getippte Eingaben zu verwerfen: nach einer
        // Zurückweisung soll die abgelehnte Eingabe zum Korrigieren stehenbleiben.
        var spaltenSindUnveraendert = Spalten.SequenceEqual(_gezeigteSpalten);
        if (spaltenSindUnveraendert)
        {
            return;
        }

        _gezeigteSpalten = Spalten;
        _formulare = Spalten.ToDictionary(spalte => spalte.SpalteId, SpaltenFormular.Fuer);
    }

    private async Task SpeichereBahn(long spalteId)
    {
        await SpalteGeaendert.InvokeAsync(_formulare[spalteId].AlsGespeichert(spalteId));
    }
}
