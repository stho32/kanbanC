@using KanbanC.Blazor.Components.Karten
@using KanbanC.Blazor.Services
@using KanbanC.Contracts.Boards

<div class="spaltenbahnen" id="spaltenbahnen" @ondragenter="VerlasseZiel">
    @foreach (var spalte in Spalten)
    {
        var formular = _formulare[spalte.SpalteId];
        <section class="spaltenbahn" data-spalte-id="@spalte.SpalteId" @key="spalte.SpalteId">
            <header class="spaltenbahn-kopf">
                <span class="spaltenbahn-anzeige">
                    <span class="spaltenbahn-bezeichnung">@spalte.Bezeichnung</span>
                    @if (spalte.IstAbschlussspalte)
                    {
                        <span class="spaltenbahn-haken" title="Abschlussspalte">✓</span>
                        <span class="spaltenbahn-vermerk">Grenze @spalte.Anzeigegrenze</span>
                    }
                </span>
                @* Zeigt die Bahn nicht alle ihre Karten, nennt der Kopf die gezeigten mit einem
                   Plus statt einer genauen Zahl über einer gekürzten Liste. *@
                @if (ZeigtKartenzahl)
                {
                    <span class="spaltenbahn-kartenzahl">@Bahnenkopfzahl.AlsText(spalte)</span>
                }
                else
                {
                    <span class="spaltenbahn-kartenzahl" aria-hidden="true"></span>
                }
                @if (IstBearbeitbar)
                {
                    <span class="spaltenbahn-position">Position @spalte.Position</span>
                    <div class="spaltenbahn-bearbeitung">
                        <input class="input spalte-bezeichnung" aria-label="Bezeichnung" @bind="formular.Bezeichnung" />
                        <input class="spalte-abschluss" type="checkbox" aria-label="Abschlussspalte" @bind="formular.IstAbschlussspalte" />
                        <input class="input spalte-grenze" type="number" aria-label="Anzeigegrenze" @bind="formular.Anzeigegrenze" />
                        <div class="spaltenbahn-knoepfe">
                            <button type="button" class="btn btn-neben spalte-speichern" @onclick="() => SpeichereBahn(spalte.SpalteId)">Speichern</button>
                            <button type="button" class="btn btn-neben spalte-hoch" @onclick="() => SpalteWeiterVorn.InvokeAsync(spalte.SpalteId)">Hoch</button>
                            <button type="button" class="btn btn-neben spalte-runter" @onclick="() => SpalteWeiterHinten.InvokeAsync(spalte.SpalteId)">Runter</button>
                            <button type="button" class="btn btn-neben spalte-entfernen" @onclick="() => SpalteEntfernt.InvokeAsync(spalte.SpalteId)">Entfernen</button>
                        </div>
                    </div>
                }
            </header>
            @* Die Bahnenfläche selbst ist das Ablageziel „ans Ende“: die Fläche unter der letzten
               Karte, die Zwischenräume und die ganze leere Bahn nehmen damit an, ohne dass ein
               einziges Element hinzukäme, das die Karten verschieben könnte. Sie nimmt nur an,
               solange ein Zug läuft — sonst wiese der Browser ein Ablegen nicht sichtbar ab. *@
            <div class="spaltenbahn-flaeche"
                 @ondragover:preventDefault="ZeigtAblageziele"
                 @ondragenter:stopPropagation
                 @ondragenter="() => ZieleAnsBahnende(spalte)"
                 @ondrop:preventDefault="ZeigtAblageziele"
                 @ondrop="() => LegeAmBahnendeAb(spalte)">
                @if (spalte.Karten.Count == 0)
                {
                    <p class="spaltenbahn-leer">Noch keine Karte.<br />Unten eine anlegen.</p>
                }
                @if (spalte.IstAbschlussspalte)
                {
                    @foreach (var gruppe in Datumsgruppen.Bilde(spalte.Karten, Heute))
                    {
                        <p class="spaltenbahn-datumsgruppe">@gruppe.Ueberschrift · @gruppe.Karten.Count</p>
                        for (var stelle = gruppe.ErsteStelle; stelle < gruppe.ErsteStelle + gruppe.Karten.Count; stelle++)
                        {
                            @Erledigtkarte(spalte, stelle)
                        }
                    }
                }
                else
                {
                    @for (var stelle = 0; stelle < spalte.Karten.Count; stelle++)
                    {
                        @Kartenzeile(spalte, stelle)
                    }
                    @Einfuegelinie(spalte.SpalteId, spalte.Karten.Count)
                }
                @if (ZeigtAblageziele)
                {
                    <div class="ablageflaeche"></div>
                }
            </div>
            <footer class="spaltenbahn-fuss">
                <div class="spaltenbahn-kartenstelle">
                    <Kartenanlage BoardId="BoardId" SpalteId="spalte.SpalteId" KarteWurdeAngelegt="KarteWurdeAngelegt" />
                </div>
            </footer>
        </section>
    }
</div>

@* Die Linie steht in der Fuge, auf die gerade gezielt wird — ohne Beschriftung, weil die
   Stelle am Bild ablesbar ist. *@
@{
    RenderFragment Einfuegelinie(long spalteId, int fuge) => @<text>
        @if (ZeigtLinie(spalteId, fuge))
        {
            <div class="einfuegelinie"></div>
        }
    </text>;

    RenderFragment Kartenzeile(Spalte spalte, int stelle) => @<text>
        @{
            var kartendaten = spalte.Karten[stelle];
            var spalteId = spalte.SpalteId;
            var index = stelle;
        }
        @Einfuegelinie(spalteId, index)
        <Karte @key="kartendaten.KarteId"
               Kartendaten="kartendaten"
               IstZiehbar="ZeigtZiehbareKarten"
               WirdGezogen="WirdGezogen(kartendaten.KarteId)"
               NimmtAn="ZeigtAblageziele"
               ZugBegann="karteId => BeginneZug(spalteId, karteId)"
               ZugEndete="BeendeZug"
               HaelfteUeberfahren="haelfte => UeberfahreHaelfte(spalteId, index, haelfte)"
               HierAbgelegt="haelfte => LegeAufHaelfteAb(spalte, index, haelfte)" />
    </text>;

    @* Eine Karte der Abschlussbahn bietet keine Hälften und keine Fuge davor: die Bahn ist nach
       Erledigungsdatum geordnet, dort bezeichnet eine Fuge keine Stelle. *@
    RenderFragment Erledigtkarte(Spalte spalte, int stelle) => @<text>
        @{
            var erledigte = spalte.Karten[stelle];
            var abschlussspalteId = spalte.SpalteId;
        }
        <Karte @key="erledigte.KarteId"
               Kartendaten="erledigte"
               IstZiehbar="ZeigtZiehbareKarten"
               WirdGezogen="WirdGezogen(erledigte.KarteId)"
               NimmtAn="false"
               ZugBegann="karteId => BeginneZug(abschlussspalteId, karteId)"
               ZugEndete="BeendeZug" />
    </text>;
}

@code {
    private const int ObersteStelle = 1;
    private Dictionary<long, SpaltenFormular> _formulare = [];
    private IReadOnlyList<Spalte> _gezeigteSpalten = [];
    private Kartenzug? _laufenderZug;
    private Ablageziel? _ablageziel;

    [Parameter]
    [EditorRequired]
    public long BoardId { get; set; }

    [Parameter]
    [EditorRequired]
    public IReadOnlyList<Spalte> Spalten { get; set; } = [];

    [Parameter]
    public bool ZeigtKartenzahl { get; set; }

    [Parameter]
    public EventCallback KarteWurdeAngelegt { get; set; }

    [Parameter]
    public bool IstBearbeitbar { get; set; }

    [Parameter]
    public EventCallback<SpalteGespeichert> SpalteGeaendert { get; set; }

    [Parameter]
    public EventCallback<long> SpalteWeiterVorn { get; set; }

    [Parameter]
    public EventCallback<long> SpalteWeiterHinten { get; set; }

    [Parameter]
    public EventCallback<long> SpalteEntfernt { get; set; }

    [Parameter]
    public EventCallback<Kartenablage> KarteWurdeAbgelegt { get; set; }

    // Die Uhr des Blazor-Prozesses, wie „heute“ auch in der WebApi die lokale Uhr ist: „Heute“ ist
    // der Tag, den der Mensch vor dem Bildschirm meint.
    private static DateOnly Heute => DateOnly.FromDateTime(DateTime.Today);

    // Im Layout-Modus werden Spalten gepflegt, nicht Karten bewegt.
    private bool ZeigtZiehbareKarten => !IstBearbeitbar;

    private bool ZeigtAblageziele => _laufenderZug is not null && !IstBearbeitbar;

    protected override void OnParametersSet()
    {
        // Ein Elternrender allein ist kein Grund, getippte Eingaben zu verwerfen: nach einer
        // Zurückweisung soll die abgelehnte Eingabe zum Korrigieren stehenbleiben.
        var spaltenSindUnveraendert = Spalten.SequenceEqual(_gezeigteSpalten);
        if (spaltenSindUnveraendert)
        {
            return;
        }

        _gezeigteSpalten = Spalten;
        _formulare = Spalten.ToDictionary(spalte => spalte.SpalteId, SpaltenFormular.Fuer);
    }

    private async Task SpeichereBahn(long spalteId)
    {
        await SpalteGeaendert.InvokeAsync(_formulare[spalteId].AlsGespeichert(spalteId));
    }

    private void BeginneZug(long spalteId, long karteId)
    {
        _laufenderZug = new Kartenzug(karteId, spalteId);
    }

    private void BeendeZug()
    {
        _laufenderZug = null;
        _ablageziel = null;
    }

    // Aufgerufen vom dragenter der bedienfreien Flächen, nicht von einem dragleave: der Browser
    // meldet das Verlassen erst nach dem Betreten der neuen Zone, und die Linie stünde dann kurz
    // an keiner Stelle.
    private void VerlasseZiel()
    {
        _ablageziel = null;
    }

    private void UeberfahreHaelfte(long spalteId, int index, Kartenhaelfte haelfte)
    {
        _ablageziel = new Ablageziel(spalteId, Ablagestellen.Fuge(index, haelfte));
    }

    private void ZieleAnsBahnende(Spalte spalte)
    {
        _ablageziel = new Ablageziel(spalte.SpalteId, spalte.Karten.Count);
    }

    private bool ZeigtLinie(long spalteId, int fuge)
    {
        return ZeigtAblageziele && _ablageziel == new Ablageziel(spalteId, fuge);
    }

    private async Task LegeAufHaelfteAb(Spalte spalte, int index, Kartenhaelfte haelfte)
    {
        var position = Ablagestellen.Zielposition(index, haelfte, StelleDerGezogenenKarte(spalte));
        await LegeAb(spalte.SpalteId, position);
    }

    // In einer nach Erledigungsdatum geordneten Bahn bezeichnet eine Fuge keine Stelle: Ablegen
    // heißt dort „erledigt“, nicht „an diese Stelle“. Aus der gekürzten Liste eine Position zu
    // rechnen träfe ohnehin mitten in einen Bestand, den die Bahn gar nicht zeigt.
    private async Task LegeAmBahnendeAb(Spalte spalte)
    {
        if (spalte.IstAbschlussspalte)
        {
            await LegeAb(spalte.SpalteId, ObersteStelle);
            return;
        }

        var position = Ablagestellen.ZielpositionAmEnde(spalte.Karten.Count, StelleDerGezogenenKarte(spalte));
        await LegeAb(spalte.SpalteId, position);
    }

    private async Task LegeAb(long spalteId, int position)
    {
        var abgelegteKarte = _laufenderZug;
        BeendeZug();
        if (abgelegteKarte is null)
        {
            return;
        }

        await KarteWurdeAbgelegt.InvokeAsync(new Kartenablage(abgelegteKarte.KarteId, spalteId, position));
    }

    private bool WirdGezogen(long karteId)
    {
        return _laufenderZug is not null && _laufenderZug.KarteId == karteId;
    }

    private int? StelleDerGezogenenKarte(Spalte spalte)
    {
        var derZugKommtAusEinerAnderenBahn = _laufenderZug is null || _laufenderZug.SpalteId != spalte.SpalteId;
        if (derZugKommtAusEinerAnderenBahn)
        {
            return null;
        }

        var stelle = IndexDerKarte(spalte, _laufenderZug!.KarteId);
        if (stelle < 0)
        {
            return null;
        }

        return stelle;
    }

    private static int IndexDerKarte(Spalte spalte, long karteId)
    {
        for (var stelle = 0; stelle < spalte.Karten.Count; stelle++)
        {
            if (spalte.Karten[stelle].KarteId == karteId)
            {
                return stelle;
            }
        }

        return -1;
    }
}
