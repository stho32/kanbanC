@using KanbanC.Blazor.Services
@using KanbanC.Contracts.Boards
@inject SpaltenApiKlient SpaltenKlient

<Spaltenbahnen Spalten="Spalten"
               IstBearbeitbar="true"
               SpalteGeaendert="SpeichereSpalte"
               SpalteWeiterVorn="SchiebeHoch"
               SpalteWeiterHinten="SchiebeRunter"
               SpalteEntfernt="EntferneSpalte" />

@if (Spalten.Count == 0)
{
    <p id="keine-spalten">Dieses Board hat keine Spalte.</p>
}

@if (_fehlermeldung is not null)
{
    <div class="alert alert-warning" role="alert" id="spalten-fehlermeldung">@_fehlermeldung</div>
}

@if (_zurueckweisung is not null)
{
    <div class="alert alert-danger" role="alert" id="spalten-zurueckweisung">
        <p class="mb-1">Die Spaltenänderung wurde abgelehnt:</p>
        <ul class="mb-0">
            @foreach (var befund in _zurueckweisung.Befunde)
            {
                <li>@befund</li>
            }
        </ul>
    </div>
}

<div class="row g-2 align-items-end mb-3" id="neue-spalte">
    <div class="col-md-4">
        <label for="neue-spalte-bezeichnung" class="form-label">Bezeichnung</label>
        <input id="neue-spalte-bezeichnung" class="form-control" @bind="_neueSpalte.Bezeichnung" />
    </div>
    <div class="col-md-3">
        <div class="form-check">
            <input id="neue-spalte-abschluss" class="form-check-input" type="checkbox" @bind="_neueSpalte.IstAbschlussspalte" />
            <label for="neue-spalte-abschluss" class="form-check-label">Abschlussspalte</label>
        </div>
    </div>
    <div class="col-md-2">
        <label for="neue-spalte-grenze" class="form-label">Anzeigegrenze</label>
        <input id="neue-spalte-grenze" class="form-control" type="number" @bind="_neueSpalte.Anzeigegrenze" />
    </div>
    <div class="col-md-3">
        <button type="button" class="btn btn-primary" @onclick="LegeSpalteAn">Spalte anlegen</button>
    </div>
</div>

@code {
    private readonly SpaltenFormular _neueSpalte = new();
    private Zurueckweisung? _zurueckweisung;
    private string? _fehlermeldung;

    [Parameter]
    [EditorRequired]
    public long BoardId { get; set; }

    [Parameter]
    [EditorRequired]
    public IReadOnlyList<Spalte> Spalten { get; set; } = [];

    [Parameter]
    [EditorRequired]
    public EventCallback SpaltenHabenSichGeaendert { get; set; }

    private async Task LegeSpalteAn()
    {
        await MitErreichbarerWebApi(LegeNeueSpalteAn);
    }

    private async Task LegeNeueSpalteAn()
    {
        var ergebnis = await SpaltenKlient.LegeSpalteAn(BoardId, _neueSpalte.AlsAnlegenAnfrage());
        if (ergebnis.WurdeZurueckgewiesen)
        {
            _zurueckweisung = ergebnis.Zurueckweisung;
            return;
        }

        _neueSpalte.Leere();
        await UebernimmAenderung();
    }

    private async Task SpeichereSpalte(SpalteGespeichert gespeichert)
    {
        await MitErreichbarerWebApi(() => SchreibeSpalte(gespeichert));
    }

    private async Task SchreibeSpalte(SpalteGespeichert gespeichert)
    {
        var anfrage = new SpalteAendernAnfrage(gespeichert.Bezeichnung, gespeichert.IstAbschlussspalte, gespeichert.Anzeigegrenze);
        var ergebnis = await SpaltenKlient.AendereSpalte(BoardId, gespeichert.SpalteId, anfrage);
        if (ergebnis.WurdeZurueckgewiesen)
        {
            _zurueckweisung = ergebnis.Zurueckweisung;
            return;
        }

        await UebernimmAenderung();
    }

    private async Task SchiebeHoch(long spalteId)
    {
        await SetzeReihenfolge(Spaltenordnung.MitSpalteWeiterVorn(Spalten, spalteId));
    }

    private async Task SchiebeRunter(long spalteId)
    {
        await SetzeReihenfolge(Spaltenordnung.MitSpalteWeiterHinten(Spalten, spalteId));
    }

    private async Task SetzeReihenfolge(IReadOnlyList<long> reihenfolge)
    {
        await MitErreichbarerWebApi(() => SchreibeReihenfolge(reihenfolge));
    }

    private async Task SchreibeReihenfolge(IReadOnlyList<long> reihenfolge)
    {
        var ergebnis = await SpaltenKlient.SetzeReihenfolge(BoardId, new Spaltenreihenfolge(reihenfolge));
        if (ergebnis.WurdeZurueckgewiesen)
        {
            _zurueckweisung = ergebnis.Zurueckweisung;
            return;
        }

        await UebernimmAenderung();
    }

    private async Task EntferneSpalte(long spalteId)
    {
        await MitErreichbarerWebApi(() => LoescheSpalte(spalteId));
    }

    private async Task LoescheSpalte(long spalteId)
    {
        var zurueckweisung = await SpaltenKlient.EntferneSpalte(BoardId, spalteId);
        if (zurueckweisung is not null)
        {
            _zurueckweisung = zurueckweisung;
            return;
        }

        await UebernimmAenderung();
    }

    private async Task MitErreichbarerWebApi(Func<Task> aufruf)
    {
        _fehlermeldung = await WebApiAufruf.MitAusfallmeldung(aufruf);
    }

    private async Task UebernimmAenderung()
    {
        _zurueckweisung = null;
        await SpaltenHabenSichGeaendert.InvokeAsync();
    }
}
